<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <RootNamespace>PostSharp.Storage.ClickHouse</RootNamespace>
        <AssemblyName>PostSharp.Storage.ClickHouse</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\PostSharp.Storage.Abstractions\PostSharp.Storage.Abstractions.csproj" />
        <PackageReference Include="ClickHouse.Client" Version="7.8.2" />
    </ItemGroup>

    <ItemGroup>
        <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
