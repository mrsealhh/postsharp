<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:controls="using:PostSharp.Controls"
    xmlns:vm="using:PostSharp.ViewModels"
    x:Class="PostSharp.Views.PipelineCenterView"
    x:DataType="vm:PipelineCenterViewModel"
>
    <UserControl.Styles>
        <Style Selector="Border.templateCard">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.templateCard:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="Border.templateCard.pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="220" MaxWidth="460" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <GridSplitter
            Grid.Column="1"
            Width="12"
            ResizeDirection="Columns"
            ResizeBehavior="PreviousAndNext"
            Cursor="SizeWestEast"
            AutomationProperties.Name="调整流水线列表宽度"
        >
            <GridSplitter.Template>
                <ControlTemplate>
                    <Border Background="Transparent" />
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                <TextBlock
                    Text="流水线"
                    FontSize="{arc:ArcDesignTokenResource TypeLG}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                />
                <arc:Button
                    Grid.Column="1"
                    Content="新建"
                    Variant="Secondary"
                    Size="Small"
                    Command="{Binding NewPipelineCommand}"
                    AutomationProperties.Name="新建流水线"
                />
                <arc:Button
                    Grid.Column="2"
                    Content="刷新"
                    Variant="Ghost"
                    Size="Small"
                    Command="{Binding RefreshFilesCommand}"
                    AutomationProperties.Name="刷新流水线列表"
                />
                <arc:Button
                    Grid.Column="3"
                    Content="目录"
                    Variant="Ghost"
                    Size="Small"
                    Command="{Binding OpenFolderCommand}"
                    AutomationProperties.Name="打开流水线目录"
                />
            </Grid>

            <arc:SearchField
                Grid.Row="1"
                Text="{Binding SearchText, Mode=TwoWay}"
                Placeholder="搜索流水线"
                AutomationProperties.Name="搜索流水线"
            />

            <Border
                Grid.Row="2"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                Padding="4"
            >
                <Panel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding VisibleFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineFileItem">
                                    <controls:SelectableRow
                                        Margin="0,0,0,3"
                                        IsSelected="{Binding IsSelected}"
                                        Click="OnFileRowClick"
                                        AutomationProperties.Name="{Binding Name}"
                                    >
                                        <StackPanel Spacing="2" Margin="10,7">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                            <TextBlock
                                                Text="{Binding Modified, StringFormat={}{0:MM-dd HH:mm}}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                        </StackPanel>
                                    </controls:SelectableRow>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        Text="还没有流水线文件。点击「新建」，或从下方场景模板开始。"
                        IsVisible="{Binding !HasFiles}"
                        Margin="12"
                        TextWrapping="Wrap"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                    <TextBlock
                        Text="没有匹配的流水线。"
                        IsVisible="{Binding HasNoMatches}"
                        Margin="12"
                        TextWrapping="Wrap"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                </Panel>
            </Border>

            <Border
                Grid.Row="3"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                Padding="10"
            >
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="场景模板"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        FontWeight="Medium"
                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    />
                    <ScrollViewer MaxHeight="280">
                        <ItemsControl ItemsSource="{Binding Templates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineTemplateItem">
                                    <Border
                                        Classes="templateCard"
                                        Margin="0,2"
                                        PointerPressed="OnTemplateClick"
                                        ToolTip.Tip="{Binding Description}"
                                        AutomationProperties.Name="{Binding Name}"
                                    >
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                FontWeight="Medium"
                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                            />
                                            <TextBlock
                                                Text="{Binding Description}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                TextWrapping="Wrap"
                                            />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock
                    Text="名称"
                    VerticalAlignment="Center"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                />
                <arc:Input
                    Grid.Column="1"
                    Text="{Binding NameText, Mode=TwoWay}"
                    Placeholder="流水线名称"
                    IsLabelVisible="False"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    MinWidth="220"
                    AutomationProperties.Name="流水线名称"
                />
                <arc:Button
                    Grid.Column="2"
                    Content="保存"
                    Variant="Secondary"
                    Command="{Binding SavePipelineCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    IsLoading="{Binding IsBusy}"
                    AutomationProperties.Name="保存流水线"
                />
                <arc:Button
                    Grid.Column="3"
                    Content="校验"
                    Variant="Ghost"
                    Command="{Binding ValidatePipelineCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="校验流水线"
                />
                <arc:Button
                    Grid.Column="4"
                    Content="生成流程图"
                    Variant="Ghost"
                    Click="OnVisualizeClick"
                    IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="生成流水线流程图"
                />
                <arc:Button
                    Grid.Column="5"
                    Content="图像编辑"
                    Variant="Secondary"
                    Click="OnGraphicalEditClick"
                    IsEnabled="{Binding !IsBusy}"
                    AutomationProperties.Name="图像编辑流水线"
                />
                <arc:Button
                    Grid.Column="6"
                    Content="运行"
                    Variant="Primary"
                    Command="{Binding RunPipelineCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    IsLoading="{Binding IsBusy}"
                    AutomationProperties.Name="运行流水线"
                />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding StatusText}"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                        TextTrimming="CharacterEllipsis"
                    />
                    <TextBlock
                        Text="未保存"
                        IsVisible="{Binding HasUnsavedChanges}"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource Warning}"
                    />
                </StackPanel>
                <arc:SegmentedControl
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    SelectedValue="{Binding LayoutMode, Mode=TwoWay}"
                    AutomationProperties.Name="YAML 与流程图布局"
                >
                    <arc:SegmentedOption Value="Stacked" Label="上下" />
                    <arc:SegmentedOption Value="SideBySide" Label="左右" />
                </arc:SegmentedControl>
            </Grid>

            <Grid
                Grid.Row="2"
                x:Name="PreviewLayout"
                RowDefinitions="*,6,*"
                ColumnDefinitions="0,0,0"
            >
                <Grid Grid.Row="0" x:Name="YamlHost">
                    <arc:Textarea
                        x:Name="YamlEditor"
                        Text="{Binding YamlText, Mode=TwoWay}"
                        IsLabelVisible="False"
                        IsResizable="False"
                        MinHeight="120"
                        FontFamily="Consolas, monospace"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Placeholder="在这里粘贴或编辑 YAML"
                        AutomationProperties.Name="流水线 YAML"
                    />
                </Grid>

                <GridSplitter
                    x:Name="PreviewSplitter"
                    Grid.Row="1"
                    Height="6"
                    HorizontalAlignment="Stretch"
                    ResizeDirection="Rows"
                    AutomationProperties.Name="调整 YAML 与预览大小"
                >
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <Panel Grid.Row="2" x:Name="GraphHost">
                    <Border
                        IsVisible="{Binding !HasGraph}"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                    >
                        <arc:EmptyState
                            Title="还没有流程图"
                            Description="点击「生成流程图」按当前 YAML 画出步骤和连线；也可以直接「运行」查看执行结果。拖动分隔条可调整上下比例。"
                            VerticalAlignment="Center"
                        />
                    </Border>

                    <Border
                        x:Name="GraphPanel"
                        IsVisible="{Binding HasGraph}"
                        Padding="2"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                        ClipToBounds="True"
                    >
                        <Panel>
                            <arc:WorkflowCanvas
                                x:Name="GraphCanvas"
                                IsEditable="False"
                                AutoFit="Fit"
                                MaxZoom="1"
                                EdgeStyle="Bezier"
                                BorderThickness="0"
                                AutomationProperties.Name="流水线流程图"
                            />
                            <arc:WorkflowZoomControls
                                Target="{Binding #GraphCanvas}"
                                Margin="12"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                            />
                        </Panel>
                    </Border>

                    <Border
                        IsVisible="{Binding HasPreview}"
                        Padding="10"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                    >
                        <ScrollViewer>
                            <SelectableTextBlock
                                Text="{Binding PreviewText}"
                                FontFamily="Consolas, monospace"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                TextWrapping="Wrap"
                            />
                        </ScrollViewer>
                    </Border>
                </Panel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
