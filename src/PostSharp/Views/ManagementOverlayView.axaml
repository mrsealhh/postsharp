<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:controls="using:PostSharp.Controls"
    xmlns:models="using:PostSharp.Models"
    xmlns:vm="using:PostSharp.ViewModels"
    xmlns:views="using:PostSharp.Views"
    x:Class="PostSharp.Views.ManagementOverlayView"
    x:DataType="vm:MainWindowViewModel"
>
    <Panel x:Name="ManagementOverlay" IsVisible="{Binding IsManagementOpen}">
        <Border
            Background="{arc:ArcDesignTokenResource Scrim}"
            PointerPressed="OnManagementDismiss"
        />
        <Border
            Margin="32"
            Background="{arc:ArcDesignTokenResource SurfaceRaised}"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            BorderThickness="1"
            CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
            BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
            Padding="20"
        >
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="管理层"
                            FontSize="{arc:ArcDesignTokenResource TypeXL}"
                            FontWeight="SemiBold"
                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                        />
                        <TextBlock
                            Text="AI 调用审计 · 自动化接口测试 · 统一管理 AI 触发的请求"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                        />
                    </StackPanel>
                    <arc:Button
                        Grid.Column="1"
                        Variant="Secondary"
                        Command="{Binding CloseManagementCommand}"
                    >
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.X}"
                            Text="关闭"
                            IconSize="13"
                        />
                    </arc:Button>
                </Grid>

                <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
                    <arc:SegmentedControl
                        SelectedValue="{Binding ManagementTab, Mode=TwoWay}"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="管理层视图"
                    >
                        <arc:SegmentedOption Value="审计" Label="审计" />
                        <arc:SegmentedOption Value="自动化" Label="自动化" />
                        <arc:SegmentedOption Value="指南" Label="指南" />
                    </arc:SegmentedControl>

                    <Grid Grid.Row="1">
                        <Grid
                            IsVisible="{Binding IsAuditTab}"
                            RowDefinitions="Auto,*"
                            RowSpacing="10"
                        >
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <arc:SearchField
                                    Placeholder="搜索请求、URL、工具或客户端"
                                    Text="{Binding AuditFilterText, Mode=TwoWay}"
                                    AutomationProperties.Name="搜索审计"
                                />
                                <arc:SegmentedControl
                                    Grid.Column="1"
                                    SelectedValue="{Binding AuditSourceFilter, Mode=TwoWay}"
                                    AutomationProperties.Name="审计来源"
                                >
                                    <arc:SegmentedOption Value="全部" Label="全部" />
                                    <arc:SegmentedOption Value="UI" Label="UI" />
                                    <arc:SegmentedOption Value="MCP" Label="MCP" />
                                </arc:SegmentedControl>
                                <arc:Button
                                    Grid.Column="2"
                                    Variant="Ghost"
                                    Size="Small"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenAuditTrashCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Archive}"
                                        Text="{Binding AuditTrashLabel}"
                                        IconSize="13"
                                    />
                                </arc:Button>
                                <arc:Button
                                    Grid.Column="3"
                                    Variant="Ghost"
                                    Size="Small"
                                    VerticalAlignment="Center"
                                    Command="{Binding ClearAuditCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Eraser}"
                                        Text="清空审计"
                                        IconSize="13"
                                    />
                                </arc:Button>
                            </Grid>

                            <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14">
                                <Border
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="4"
                                >
                                    <arc:ScrollArea
                                        x:Name="AuditScrollArea"
                                        HorizontalContentAlignment="Stretch"
                                    >
                                        <ItemsControl
                                            ItemsSource="{Binding AuditPage.Items}"
                                            HorizontalAlignment="Stretch"
                                            Width="{Binding #AuditScrollArea.Bounds.Width}"
                                        >
                                            <ItemsControl.Styles>
                                                <Style Selector="ItemsControl > ContentPresenter">
                                                    <Setter
                                                        Property="HorizontalAlignment"
                                                        Value="Stretch"
                                                    />
                                                    <Setter
                                                        Property="HorizontalContentAlignment"
                                                        Value="Stretch"
                                                    />
                                                </Style>
                                            </ItemsControl.Styles>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:AuditEntry">
                                                    <controls:SelectableRow
                                                        Margin="0,0,0,4"
                                                        IsSelected="{Binding IsSelected}"
                                                        Click="OnAuditRowClick"
                                                        AutomationProperties.Name="{Binding RequestName}"
                                                    >
                                                        <Grid
                                                            ColumnDefinitions="88,*,Auto,Auto,30"
                                                            RowDefinitions="Auto,Auto"
                                                            ColumnSpacing="8"
                                                            RowSpacing="3"
                                                            Margin="10,8"
                                                        >
                                                            <arc:Badge
                                                                Grid.RowSpan="2"
                                                                Content="{Binding SourceLabel}"
                                                                Icon="{Binding SourceIcon}"
                                                                Tone="{Binding SourceTone}"
                                                                Size="Small"
                                                                Width="88"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding SourceTooltip}"
                                                            />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{Binding RequestName}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip.Tip="{Binding RequestName}"
                                                            />
                                                            <arc:Badge
                                                                Grid.Column="2"
                                                                Content="{Binding StatusShortLabel}"
                                                                Icon="{Binding StatusIcon}"
                                                                Tone="{Binding StatusTone}"
                                                                Size="Small"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="{Binding StatusLabel}"
                                                            />
                                                            <TextBlock
                                                                Grid.Column="3"
                                                                Text="{Binding TimeText}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                VerticalAlignment="Center"
                                                                Margin="6,0,0,0"
                                                                ToolTip.Tip="{Binding TimeTooltip}"
                                                            />
                                                            <arc:Button
                                                                Grid.Column="4"
                                                                Grid.RowSpan="2"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Width="30"
                                                                Padding="0"
                                                                VerticalAlignment="Stretch"
                                                                IsVisible="{Binding IsSelected}"
                                                                Command="{Binding DeleteCommand}"
                                                                ToolTip.Tip="删除这条审计记录"
                                                                AutomationProperties.Name="删除审计记录"
                                                            >
                                                                <arc:ArcGlyph
                                                                    Data="{x:Static arc:ArcIcons.Trash2}"
                                                                    Size="13"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                />
                                                            </arc:Button>
                                                            <Grid
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="3"
                                                                ColumnDefinitions="Auto,*"
                                                                ColumnSpacing="6"
                                                            >
                                                                <arc:Badge
                                                                    Content="{Binding Method}"
                                                                    Tone="{Binding MethodTone}"
                                                                    Size="Small"
                                                                    ToolTip.Tip="{Binding RequestLine}"
                                                                />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Text="{Binding Url}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip.Tip="{Binding Url}"
                                                                />
                                                            </Grid>
                                                        </Grid>
                                                    </controls:SelectableRow>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="12"
                                >
                                    <Grid>
                                        <arc:ScrollArea IsVisible="{Binding HasSelectedAuditEntry}">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Text="{Binding SelectedAuditEntry.RequestName}"
                                                            FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            TextWrapping="Wrap"
                                                        />
                                                        <SelectableTextBlock
                                                            Text="{Binding SelectedAuditEntry.Url}"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            TextWrapping="Wrap"
                                                        />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                    >
                                                        <arc:Button
                                                            Variant="Danger"
                                                            Size="Small"
                                                            Command="{Binding SelectedAuditEntry.DeleteCommand}"
                                                            ToolTip.Tip="移入审计回收站，可在回收站恢复"
                                                            AutomationProperties.Name="删除这条审计记录"
                                                        >
                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.Trash2}"
                                                                Text="删除"
                                                                IconSize="13"
                                                            />
                                                        </arc:Button>
                                                        <arc:Button
                                                            Variant="Secondary"
                                                            Size="Small"
                                                            Command="{Binding OpenSelectedAuditRequestCommand}"
                                                        >
                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.ArrowUpRight}"
                                                                Text="打开请求"
                                                                IconSize="13"
                                                            />
                                                        </arc:Button>
                                                    </StackPanel>
                                                </Grid>

                                                <WrapPanel ItemSpacing="8" LineSpacing="6">
                                                    <arc:Badge
                                                        Content="{Binding SelectedAuditEntry.SourceLabel}"
                                                        Icon="{Binding SelectedAuditEntry.SourceIcon}"
                                                        Tone="{Binding SelectedAuditEntry.SourceTone}"
                                                        Size="Small"
                                                        ToolTip.Tip="{Binding SelectedAuditEntry.SourceTooltip}"
                                                    />
                                                    <arc:Badge
                                                        Content="{Binding SelectedAuditEntry.StatusLabel}"
                                                        Icon="{Binding SelectedAuditEntry.StatusIcon}"
                                                        Tone="{Binding SelectedAuditEntry.StatusTone}"
                                                        Size="Small"
                                                    />
                                                    <arc:Badge
                                                        Content="{Binding SelectedAuditEntry.Method}"
                                                        Tone="{Binding SelectedAuditEntry.MethodTone}"
                                                        Size="Small"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding SelectedAuditEntry.DurationText}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding SelectedAuditEntry.SizeText}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding SelectedAuditEntry.TimeText}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </WrapPanel>

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock
                                                            Text="客户端"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        />
                                                        <TextBlock
                                                            Text="{Binding SelectedAuditEntry.ClientLabel}"
                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock
                                                            Text="工具"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        />
                                                        <TextBlock
                                                            Text="{Binding SelectedAuditEntry.ToolLabel}"
                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock
                                                    Text="{Binding SelectedAuditEntry.Error}"
                                                    Foreground="{arc:ArcDesignTokenResource Danger}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    TextWrapping="Wrap"
                                                />

                                                <StackPanel
                                                    IsVisible="{Binding SelectedAuditEntry.HasAiOutput}"
                                                    Spacing="6"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Sparkles}"
                                                        Text="AI 聚合输出"
                                                        IconSize="12"
                                                        TextFontSize="12"
                                                        TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding SelectedAuditEntry.AiSummary}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.FileText}"
                                                        Text="Content"
                                                        IconSize="12"
                                                        TextFontSize="12"
                                                        TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    />
                                                    <arc:CodeBlock
                                                        Code="{Binding SelectedAuditEntry.AiContent}"
                                                        Language="text"
                                                        FileName="ai-content.md"
                                                        IsCollapsible="True"
                                                        MaxLines="10"
                                                        CopyLabel="复制内容"
                                                        ShowAllLinesFormat="展开全部 {0} 行"
                                                        ShowFewerLinesLabel="收起"
                                                    />
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Brain}"
                                                        Text="Thinking"
                                                        IconSize="12"
                                                        TextFontSize="12"
                                                        TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    />
                                                    <arc:CodeBlock
                                                        Code="{Binding SelectedAuditEntry.AiThinking}"
                                                        Language="text"
                                                        FileName="ai-thinking.txt"
                                                        IsCollapsible="True"
                                                        MaxLines="8"
                                                        CopyLabel="复制思考"
                                                        ShowAllLinesFormat="展开全部 {0} 行"
                                                        ShowFewerLinesLabel="收起"
                                                    />
                                                </StackPanel>
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Terminal}"
                                                    Text="cURL"
                                                    IconSize="12"
                                                    TextFontSize="12"
                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                />
                                                <arc:CodeBlock
                                                    Code="{Binding SelectedAuditEntry.Curl}"
                                                    Language="bash"
                                                    FileName="request.sh"
                                                    IsCollapsible="True"
                                                    MaxLines="8"
                                                    CopyLabel="复制 cURL"
                                                />

                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.List}"
                                                    Text="请求头"
                                                    IconSize="12"
                                                    TextFontSize="12"
                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                />
                                                <arc:CodeBlock
                                                    Code="{Binding SelectedAuditEntry.RequestHeaders}"
                                                    Language="text"
                                                    FileName="headers.txt"
                                                    IsCollapsible="True"
                                                    MaxLines="6"
                                                    CopyLabel="复制"
                                                    ShowAllLinesFormat="展开全部 {0} 行"
                                                    ShowFewerLinesLabel="收起"
                                                />

                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.FileText}"
                                                    Text="请求体预览"
                                                    IconSize="12"
                                                    TextFontSize="12"
                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                />
                                                <arc:CodeBlock
                                                    Code="{Binding SelectedAuditEntry.RequestBodyPreview}"
                                                    Language="text"
                                                    FileName="request.txt"
                                                    IsCollapsible="True"
                                                    MaxLines="6"
                                                    CopyLabel="复制"
                                                    ShowAllLinesFormat="展开全部 {0} 行"
                                                    ShowFewerLinesLabel="收起"
                                                />

                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.FileText}"
                                                    Text="响应体预览"
                                                    IconSize="12"
                                                    TextFontSize="12"
                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                />
                                                <arc:CodeBlock
                                                    Code="{Binding SelectedAuditEntry.ResponseBodyPreview}"
                                                    Language="text"
                                                    FileName="response.txt"
                                                    IsCollapsible="True"
                                                    MaxLines="8"
                                                    CopyLabel="复制"
                                                    ShowAllLinesFormat="展开全部 {0} 行"
                                                    ShowFewerLinesLabel="收起"
                                                />
                                            </StackPanel>
                                        </arc:ScrollArea>
                                        <arc:EmptyState
                                            IsVisible="{Binding !HasSelectedAuditEntry}"
                                            Title="选择一条审计记录"
                                            Description="查看 AI 或 UI 触发的请求、状态、耗时、cURL 和请求/响应预览。"
                                            Label="审计详情"
                                        />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid
                            IsVisible="{Binding IsAutomationTab}"
                            ColumnDefinitions="0.72*,1.28*"
                            ColumnSpacing="14"
                        >
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Variant="Secondary"
                                        Size="Small"
                                        Command="{Binding OpenSuiteBuilderCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.ListChecks}"
                                            Text="组装套件"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Danger"
                                        Size="Small"
                                        Command="{Binding DeleteSelectedSuiteCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                            Text="删除套件"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                </StackPanel>
                                <Border
                                    Grid.Row="1"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="4"
                                >
                                    <Grid>
                                        <arc:ScrollArea
                                            x:Name="SuiteListScrollArea"
                                            HorizontalContentAlignment="Stretch"
                                        >
                                            <ItemsControl
                                                ItemsSource="{Binding Suites}"
                                                HorizontalAlignment="Stretch"
                                            >
                                                <ItemsControl.Styles>
                                                    <Style Selector="ItemsControl > ContentPresenter">
                                                        <Setter
                                                            Property="HorizontalAlignment"
                                                            Value="Stretch"
                                                        />
                                                        <Setter
                                                            Property="HorizontalContentAlignment"
                                                            Value="Stretch"
                                                        />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TestSuite">
                                                        <controls:SelectableRow
                                                            Margin="0,0,0,4"
                                                            IsSelected="{Binding IsSelected}"
                                                            Click="OnSuiteRowClick"
                                                            AutomationProperties.Name="{Binding Name}"
                                                        >
                                                            <Grid
                                                                ColumnDefinitions="Auto,*,Auto"
                                                                ColumnSpacing="9"
                                                                Margin="10,8"
                                                            >
                                                                <Border
                                                                    Width="30"
                                                                    Height="30"
                                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                    VerticalAlignment="Center"
                                                                >
                                                                    <arc:ArcGlyph
                                                                        Data="{x:Static arc:ArcIcons.ListChecks}"
                                                                        Size="15"
                                                                        Foreground="{arc:ArcDesignTokenResource Accent}"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                    />
                                                                </Border>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center"
                                                                >
                                                                    <TextBlock
                                                                        Text="{Binding Name}"
                                                                        FontWeight="Medium"
                                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding Name}"
                                                                    />
                                                                    <TextBlock
                                                                        Text="{Binding LastSummary}"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding LastSummary}"
                                                                    />
                                                                </StackPanel>
                                                                <arc:ArcGlyph
                                                                    Grid.Column="2"
                                                                    Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                                    Size="14"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                />
                                                            </Grid>
                                                        </controls:SelectableRow>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </arc:ScrollArea>
                                        <TextBlock
                                            Text="还没有套件，点击「组装套件」开始"
                                            IsVisible="{Binding !HasSuites}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    Grid.Row="2"
                                    Text="「组装套件」打开编排器：左侧勾选集合或接口，中间画布搭依赖与分支，右侧调整节点。运行结果会写入审计。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                            </Grid>

                            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="{Binding SelectedSuite.Name}"
                                        FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                        FontWeight="SemiBold"
                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding SelectedSuite.Name}"
                                    />
                                    <TextBlock
                                        Text="{Binding SelectedSuite.LastSummary}"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding SelectedSuite.LastSummary}"
                                    />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Spacing="6">
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                        <TextBlock
                                            Text="步骤与断言 / 最近结果"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            FontWeight="Medium"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="运行历史"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:Select
                                            Grid.Column="2"
                                            MinWidth="180"
                                            Placeholder="选择运行记录"
                                            ItemsSource="{Binding SelectedSuite.Runs}"
                                            SelectedItem="{Binding SelectedSuiteResult, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="选择运行历史"
                                        />
                                    </Grid>
                                    <Border
                                        IsVisible="{Binding IsSuiteValidationVisible}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="8"
                                        MaxHeight="170"
                                    >
                                        <Grid RowDefinitions="Auto,*" RowSpacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <TextBlock
                                                    Text="{Binding SuiteValidationSummary}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    VerticalAlignment="Center"
                                                />
                                                <arc:Button
                                                    Grid.Column="1"
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding DismissSuiteValidationCommand}"
                                                    ToolTip.Tip="收起预检问题"
                                                    AutomationProperties.Name="收起预检问题"
                                                >
                                                    <arc:ArcGlyph
                                                        Data="{x:Static arc:ArcIcons.X}"
                                                        Size="12"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </arc:Button>
                                            </Grid>
                                            <arc:ScrollArea Grid.Row="1">
                                                <ItemsControl ItemsSource="{Binding SelectedSuiteValidationIssues}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:SuiteValidationIssue">
                                                            <Grid
                                                                ColumnDefinitions="Auto,*"
                                                                ColumnSpacing="6"
                                                                Margin="0,0,0,3"
                                                            >
                                                                <arc:Badge
                                                                    Content="{Binding SeverityLabel}"
                                                                    Tone="{Binding SeverityTone}"
                                                                    Size="Small"
                                                                    VerticalAlignment="Top"
                                                                />
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="1"
                                                                >
                                                                    <TextBlock
                                                                        Text="{Binding DisplayMessage}"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                        TextWrapping="Wrap"
                                                                    />
                                                                    <TextBlock
                                                                        Text="{Binding Hint}"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                        TextWrapping="Wrap"
                                                                    />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </arc:ScrollArea>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="1.15*,0.85*"
                                    ColumnSpacing="12"
                                >
                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="10"
                                    >
                                        <arc:ScrollArea>
                                            <ItemsControl ItemsSource="{Binding SelectedSuite.Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TestStep">
                                                        <Border
                                                            Background="{arc:ArcDesignTokenResource Surface}"
                                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                            Padding="8"
                                                            Margin="0,0,0,4"
                                                        >
                                                            <StackPanel Spacing="2">
                                                                <TextBlock
                                                                    Text="{Binding RequestName}"
                                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                    ToolTip.Tip="{Binding RequestName}"
                                                                />
                                                                <Grid
                                                                    ColumnDefinitions="Auto,*"
                                                                    ColumnSpacing="6"
                                                                >
                                                                    <arc:Badge
                                                                        Content="{Binding Method}"
                                                                        Tone="{Binding MethodTone}"
                                                                        Size="Small"
                                                                    />
                                                                    <TextBlock
                                                                        Grid.Column="1"
                                                                        Text="{Binding Url}"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                        VerticalAlignment="Center"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip.Tip="{Binding Url}"
                                                                    />
                                                                </Grid>
                                                                <TextBlock
                                                                    Text="{Binding ExpectationText}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    TextWrapping="Wrap"
                                                                />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </arc:ScrollArea>
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="10"
                                    >
                                        <Grid>
                                            <arc:ScrollArea IsVisible="{Binding HasSelectedSuiteResult}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock
                                                        Text="{Binding SelectedSuiteResult.Summary}"
                                                        FontWeight="Medium"
                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding SelectedSuiteResult.WorkflowSummary}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                    <ItemsControl ItemsSource="{Binding SelectedSuiteResult.Steps}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:TestStepResult">
                                                                <Border
                                                                    Background="{arc:ArcDesignTokenResource Surface}"
                                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                    Padding="8"
                                                                    Margin="0,0,0,4"
                                                                >
                                                                    <Grid
                                                                        ColumnDefinitions="Auto,*,Auto,Auto"
                                                                        RowDefinitions="Auto,Auto,Auto"
                                                                        ColumnSpacing="8"
                                                                        RowSpacing="2"
                                                                    >
                                                                        <arc:Badge
                                                                            Content="{Binding ResultLabel}"
                                                                            Icon="{Binding ResultIcon}"
                                                                            Tone="{Binding ResultTone}"
                                                                            Size="Small"
                                                                        />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Text="{Binding Name}"
                                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip.Tip="{Binding Name}"
                                                                        />
                                                                        <StackPanel
                                                                            Grid.Column="2"
                                                                            Orientation="Horizontal"
                                                                            Spacing="4"
                                                                            VerticalAlignment="Center"
                                                                        >
                                                                            <TextBlock
                                                                                Text="{Binding StatusCode}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                            />
                                                                            <TextBlock
                                                                                Text="{Binding AttemptText}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                            />
                                                                        </StackPanel>
                                                                        <arc:Button
                                                                            Grid.Column="3"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="28"
                                                                            Padding="0"
                                                                            IsVisible="{Binding CanContinue}"
                                                                            Command="{Binding ContinueCommand}"
                                                                            ToolTip.Tip="从此步骤继续运行其下游；依赖会自动补跑"
                                                                            AutomationProperties.Name="从此步骤继续"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.Play}"
                                                                                Size="12"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                            />
                                                                        </arc:Button>
                                                                        <TextBlock
                                                                            Grid.Row="1"
                                                                            Grid.Column="1"
                                                                            Grid.ColumnSpan="2"
                                                                            Text="{Binding Error}"
                                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                            Foreground="{arc:ArcDesignTokenResource Danger}"
                                                                            TextWrapping="Wrap"
                                                                        />
                                                                        <ItemsControl
                                                                            Grid.Row="2"
                                                                            Grid.Column="1"
                                                                            Grid.ColumnSpan="2"
                                                                            ItemsSource="{Binding Assertions}"
                                                                            IsVisible="{Binding HasAssertions}"
                                                                        >
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:TestAssertionResult">
                                                                                    <Grid
                                                                                        ColumnDefinitions="Auto,*"
                                                                                        RowDefinitions="Auto,Auto"
                                                                                        ColumnSpacing="6"
                                                                                        Margin="0,2,0,0"
                                                                                    >
                                                                                        <arc:Badge
                                                                                            Content="{Binding ResultLabel}"
                                                                                            Tone="{Binding ResultTone}"
                                                                                            Size="Small"
                                                                                        />
                                                                                        <TextBlock
                                                                                            Grid.Column="1"
                                                                                            Text="{Binding Label}"
                                                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                            TextWrapping="Wrap"
                                                                                        />
                                                                                        <TextBlock
                                                                                            Grid.Row="1"
                                                                                            Grid.Column="1"
                                                                                            Text="{Binding Detail}"
                                                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                            TextWrapping="Wrap"
                                                                                        />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </arc:ScrollArea>
                                            <arc:EmptyState
                                                IsVisible="{Binding !HasSelectedSuiteResult}"
                                                Title="尚未运行"
                                                Description="点击「运行套件」查看每个步骤的断言结果；结果同时写入审计。"
                                                Label="套件结果"
                                            />
                                        </Grid>
                                    </Border>
                                </Grid>

                                <StackPanel
                                    Grid.Row="3"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                >
                                    <arc:Button
                                        Variant="Secondary"
                                        IsEnabled="{Binding CanRerunSelectedRun}"
                                        Command="{Binding RerunFailedCommand}"
                                        ToolTip.Tip="只重跑失败步骤及其依赖；已通过的步骤不重复发送"
                                        ToolTip.ShowOnDisabled="True"
                                        AutomationProperties.Name="重跑失败步骤"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.RotateCcw}"
                                            Text="重跑失败"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        Click="OnEditSuiteClick"
                                        ToolTip.Tip="打开套件编排：集合与接口、画布、节点明细"
                                        AutomationProperties.Name="编辑套件"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.ListChecks}"
                                            Text="编排套件"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        IsEnabled="{Binding IsRunningSuite}"
                                        Command="{Binding CancelSuiteRunCommand}"
                                        ToolTip.Tip="套件运行中可取消：正在发送的请求会被中止，后续步骤不再执行"
                                        ToolTip.ShowOnDisabled="True"
                                        AutomationProperties.Name="取消运行套件"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Square}"
                                            Text="取消运行"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Primary"
                                        MinWidth="112"
                                        IsLoading="{Binding IsRunningSuite}"
                                        Command="{Binding RunSelectedSuiteCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Play}"
                                            Text="{Binding RunSuiteButtonText}"
                                        />
                                    </arc:Button>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid IsVisible="{Binding IsGuideTab}" RowDefinitions="*" Margin="0,6,0,0">
                            <arc:ScrollArea>
                                <StackPanel
                                    Spacing="12"
                                    MaxWidth="1120"
                                    HorizontalAlignment="Center"
                                >
                                    <TextBlock
                                        Text="一分钟上手"
                                        FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                        FontWeight="SemiBold"
                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                    />
                                    <TextBlock
                                        Text="PostSharp 的核心链路是：AI 通过 MCP 触发请求 → 审计留痕 → 自动化套件回归。下面每一步都可以直接点开示例。"
                                        FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        TextWrapping="Wrap"
                                    />

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="1"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="发送第一个请求"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="载入「健康检查」，按 Ctrl+Enter 发送。响应区会显示状态、耗时、大小、JSON 树和可复制响应。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding LoadGuideRequestCommand}"
                                                    CommandParameter="health"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Play}"
                                                        Text="载入健康检查"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding ClearAuditCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Eraser}"
                                                        Text="清空审计"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="2"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="请求头、请求体与 cURL"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="请求头可以一键插入 JSON 类型、Accept JSON、Bearer Token，并会提示重复头。请求体支持 JSON/XML 格式化与压缩；cURL 标签会生成已解析环境变量的可执行命令。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding OpenEnvironmentFromGuideCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Globe}"
                                                        Text="打开环境变量"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding LoadGuideRequestCommand}"
                                                    CommandParameter="sse"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Terminal}"
                                                        Text="载入 SSE 示例"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="3"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="AI 审计与自动化"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="所有 UI 和 MCP 发送都会写入审计，记录来源、客户端、工具、状态、耗时、cURL 和请求/响应预览。自动化套件支持状态码和响应体断言，运行结果也会进入审计。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding SetManagementTabCommand}"
                                                    CommandParameter="审计"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.ListChecks}"
                                                        Text="查看审计"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding SetManagementTabCommand}"
                                                    CommandParameter="自动化"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Play}"
                                                        Text="查看自动化"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="4"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="SSE / AI 输出聚合"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="发送 text/event-stream 请求后，PostSharp 会把流式事件里的 thinking 和 content 自动追加聚合，在「AI 聚合」标签中完整展示，而不是只保留最后一条推送。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding LoadGuideRequestCommand}"
                                                    CommandParameter="sse"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Sparkles}"
                                                        Text="载入 SSE 示例"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding LoadGuideRequestCommand}"
                                                    CommandParameter="upload"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Upload}"
                                                        Text="载入上传示例"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="5"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="MCP 接入"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="把下面的地址添加到支持 Streamable HTTP 的 MCP 客户端，AI 就可以自由管理集合与请求、编排带延迟和字段映射的套件、运行回归并查看审计。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="8"
                                                    Margin="0,2,0,0"
                                                >
                                                    <arc:Input
                                                        IsLabelVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{Binding McpEndpoint}"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                    />
                                                    <arc:CopyButton
                                                        Grid.Column="1"
                                                        Value="{Binding McpEndpoint}"
                                                        Label="复制地址"
                                                        Variant="Plain"
                                                    />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding OpenMcpFromGuideCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.ExternalLink}"
                                                        Text="打开 MCP 接入说明"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="6"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="上传与系统设置"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="请求体切到「表单上传」后可以选择文件并发起 multipart 请求；设置页提供主题、界面字体、代码字体/字号、超时、默认请求体、大响应阈值和审计保留条数。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Click="OnOpenSettingsClick"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Settings}"
                                                        Text="打开设置"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding LoadGuideRequestCommand}"
                                                    CommandParameter="upload"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Upload}"
                                                        Text="载入上传示例"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="14"
                                    >
                                        <Grid ColumnDefinitions="34,*,200" ColumnSpacing="12">
                                            <arc:Badge
                                                Content="7"
                                                Tone="Neutral"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                                Margin="0,2,0,0"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock
                                                    Text="命令行 CLI"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="postsharp-cli 是独立命令行程序，不会启动第二个桌面端；它通过本机 MCP 调用当前正在运行的 PostSharp，适合终端、CI 和只支持 stdio 的 AI 客户端。下载解压后即可使用，运行前请保持桌面端开启。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <Border
                                                        Background="{arc:ArcDesignTokenResource Surface}"
                                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                        Padding="10,8"
                                                    >
                                                        <StackPanel Spacing="2">
                                                            <TextBlock
                                                                Text="postsharp-cli suite list"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="Wrap"
                                                            />
                                                            <TextBlock
                                                                Text="postsharp-cli suite run &lt;suiteId&gt; --json"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="Wrap"
                                                            />
                                                            <TextBlock
                                                                Text="postsharp-cli audit list --source MCP --limit 20"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="Wrap"
                                                            />
                                                        </StackPanel>
                                                    </Border>
                                                    <arc:CopyButton
                                                        Grid.Column="1"
                                                        Value="postsharp-cli suite list&#10;postsharp-cli suite run &lt;suiteId&gt; --json&#10;postsharp-cli audit list --source MCP --limit 20"
                                                        Label="复制命令"
                                                        Variant="Plain"
                                                        VerticalAlignment="Top"
                                                    />
                                                </Grid>
                                                <Grid
                                                    ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="8"
                                                    Margin="0,2,0,0"
                                                >
                                                    <arc:Input
                                                        IsLabelVisible="False"
                                                        IsReadOnly="True"
                                                        Text="{Binding McpEndpoint}"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                    />
                                                    <arc:CopyButton
                                                        Grid.Column="1"
                                                        Value="{Binding McpEndpoint}"
                                                        Label="复制地址"
                                                        Variant="Plain"
                                                    />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Orientation="Vertical"
                                                Spacing="6"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                            >
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding OpenCliReleaseCommand}"
                                                    ToolTip.Tip="在 GitHub Releases 下载 postsharp-cli；桌面端需保持运行"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.ArrowDown}"
                                                        Text="下载 CLI"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding OpenCliDocsCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.ExternalLink}"
                                                        Text="查看说明"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </arc:ScrollArea>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Panel>
</UserControl>
