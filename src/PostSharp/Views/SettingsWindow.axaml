<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:vm="using:PostSharp.ViewModels"
    x:Class="PostSharp.Views.SettingsWindow"
    x:DataType="vm:SettingsViewModel"
    Title="设置 · PostSharp"
    Width="860"
    Height="860"
    MinWidth="680"
    MinHeight="560"
    WindowStartupLocation="CenterOwner"
    Background="{arc:ArcDesignTokenResource Background}"
>
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="Border.settingsSection">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Styles>

    <VisualLayerManager EnableOverlayLayer="True">
        <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <StackPanel Spacing="2">
                <TextBlock
                    Text="设置"
                    FontSize="{arc:ArcDesignTokenResource TypeXL}"
                    FontWeight="SemiBold"
                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                />
                <TextBlock
                    Text="外观、日志和请求默认值；保存后立即生效，并在下次启动时重新读取。"
                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    TextWrapping="Wrap"
                />
            </StackPanel>

            <arc:ScrollArea Grid.Row="1">
                <StackPanel Spacing="14" Margin="0,0,4,0">
                    <Border Classes="settingsSection">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="外观"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                FontWeight="Medium"
                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            />
                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                <arc:Select
                                    Label="主题"
                                    Description="跟随系统会读取 Windows 当前主题，并在系统切换时同步。"
                                    ItemsSource="{Binding ThemeOptions}"
                                    SelectedItem="{Binding Draft.Theme, Mode=TwoWay}"
                                    AutomationProperties.Name="主题"
                                />
                                <arc:Select
                                    Grid.Column="1"
                                    Label="界面字体"
                                    ItemsSource="{Binding UiFontOptions}"
                                    SelectedItem="{Binding Draft.UiFont, Mode=TwoWay}"
                                    AutomationProperties.Name="界面字体"
                                />
                            </Grid>
                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                <arc:Select
                                    Label="代码字体"
                                    ItemsSource="{Binding CodeFontOptions}"
                                    SelectedItem="{Binding Draft.CodeFont, Mode=TwoWay}"
                                    AutomationProperties.Name="代码字体"
                                />
                                <arc:Select
                                    Grid.Column="1"
                                    Label="代码字号"
                                    ItemsSource="{Binding CodeFontSizeOptions}"
                                    SelectedItem="{Binding Draft.CodeFontSize, Mode=TwoWay}"
                                    AutomationProperties.Name="代码字号"
                                />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="settingsSection">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="日志"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                FontWeight="Medium"
                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <arc:Input
                                    Label="日志目录"
                                    Text="{Binding Draft.LogDirectory, Mode=TwoWay}"
                                    Description="按天滚动，文件名形如 postsharp-20261025.log，默认保留最近 30 个文件。"
                                    AutomationProperties.Name="日志目录"
                                />
                                <arc:Button
                                    Grid.Column="1"
                                    Content="浏览…"
                                    Variant="Secondary"
                                    VerticalAlignment="Bottom"
                                    Click="OnBrowseLogDirectoryClick"
                                    AutomationProperties.Name="浏览日志目录"
                                />
                                <arc:Button
                                    Grid.Column="2"
                                    Content="打开目录"
                                    Variant="Ghost"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding OpenLogDirectoryCommand}"
                                    AutomationProperties.Name="打开日志目录"
                                />
                            </Grid>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4"
                                HorizontalAlignment="Left"
                            >
                                <TextBlock
                                    Text="默认目录："
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                />
                                <SelectableTextBlock
                                    Text="{Binding DefaultLogDirectory}"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="settingsSection">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="请求"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                FontWeight="Medium"
                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            />
                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                <arc:Select
                                    Label="请求超时"
                                    Description="单位：秒"
                                    ItemsSource="{Binding TimeoutOptions}"
                                    SelectedItem="{Binding Draft.RequestTimeoutSeconds, Mode=TwoWay}"
                                    AutomationProperties.Name="请求超时"
                                />
                                <arc:Select
                                    Grid.Column="1"
                                    Label="默认请求体"
                                    SelectedValue="{Binding Draft.DefaultBodyMode, Mode=TwoWay}"
                                    AutomationProperties.Name="默认请求体"
                                >
                                    <arc:SelectItem Content="无" Value="None" />
                                    <arc:SelectItem Content="JSON" Value="Json" />
                                    <arc:SelectItem Content="文本" Value="Text" />
                                    <arc:SelectItem Content="表单上传" Value="Multipart" />
                                </arc:Select>
                            </Grid>
                            <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                <arc:Select
                                    Label="大响应折叠阈值"
                                    Description="单位：KB"
                                    ItemsSource="{Binding LargeResponseThresholdOptions}"
                                    SelectedItem="{Binding Draft.LargeResponseThresholdKb, Mode=TwoWay}"
                                    AutomationProperties.Name="大响应折叠阈值"
                                />
                                <arc:Select
                                    Grid.Column="1"
                                    Label="审计保留条数"
                                    Description="单位：条"
                                    ItemsSource="{Binding AuditLimitOptions}"
                                    SelectedItem="{Binding Draft.AuditLimit, Mode=TwoWay}"
                                    AutomationProperties.Name="审计保留条数"
                                />
                            </Grid>
                            <arc:Switch
                                Content="自动格式化 JSON/XML 响应"
                                IsChecked="{Binding Draft.AutoFormatResponse, Mode=TwoWay}"
                            />
                        </StackPanel>
                    </Border>

                    <Border Classes="settingsSection">
                        <StackPanel Spacing="6">
                            <TextBlock
                                Text="配置文件"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                FontWeight="Medium"
                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            />
                            <SelectableTextBlock
                                Text="{Binding SettingsFilePath}"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                TextWrapping="Wrap"
                            />
                            <TextBlock
                                Text="工作区、审计和设置都以 UTF-8 JSON 保存在 %APPDATA%\PostSharp 下，不会上传到任何服务。"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                TextWrapping="Wrap"
                            />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </arc:ScrollArea>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Grid VerticalAlignment="Center">
                    <TextBlock
                        IsVisible="{Binding !HasError}"
                        Text="{Binding StatusMessage}"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                        TextWrapping="Wrap"
                    />
                    <TextBlock
                        IsVisible="{Binding HasError}"
                        Text="{Binding StatusMessage}"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource Danger}"
                        TextWrapping="Wrap"
                    />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                >
                    <arc:Button
                        Content="恢复默认"
                        Variant="Ghost"
                        Command="{Binding RestoreDefaultsCommand}"
                    />
                    <arc:Button Content="关闭" Variant="Secondary" Click="OnCloseClick" />
                    <arc:Button
                        Content="保存设置"
                        Variant="Primary"
                        Command="{Binding SaveCommand}"
                        AutomationProperties.Name="保存设置"
                    />
                </StackPanel>
            </Grid>
        </Grid>
    </VisualLayerManager>
</Window>
