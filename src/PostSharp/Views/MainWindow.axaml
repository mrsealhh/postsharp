<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:controls="using:PostSharp.Controls"
    xmlns:models="using:PostSharp.Models"
    xmlns:vm="using:PostSharp.ViewModels"
    x:Class="PostSharp.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="PostSharp · 轻量接口调试"
    Width="1400"
    Height="900"
    MinWidth="1000"
    MinHeight="660"
    WindowStartupLocation="CenterScreen"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    WindowDecorations="BorderOnly"
    Background="{arc:ArcDesignTokenResource Background}"
>
    <Window.Resources>
        <DataTemplate x:Key="KeyValueRowTemplate" x:DataType="models:KeyValueRow">
            <Grid ColumnDefinitions="44,*,*,34" Margin="0,0,0,6">
                <arc:Checkbox
                    Grid.Column="0"
                    IsChecked="{Binding IsEnabled}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="0,-2,0,2"
                    AutomationProperties.Name="启用该行"
                />
                <arc:Input
                    Grid.Column="1"
                    Text="{Binding Key}"
                    Placeholder="键"
                    IsLabelVisible="False"
                    Size="Small"
                    Margin="0,0,8,0"
                />
                <arc:Input
                    Grid.Column="2"
                    Text="{Binding Value}"
                    Placeholder="值"
                    IsLabelVisible="False"
                    Size="Small"
                    Margin="0,0,8,0"
                />
                <arc:Button
                    Grid.Column="3"
                    Content="×"
                    Variant="Ghost"
                    Size="Small"
                    Padding="0"
                    Width="34"
                    Command="{Binding RemoveCommand}"
                    AutomationProperties.Name="删除该行"
                />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="models:HistoryEntry">
            <Grid
                ColumnDefinitions="*,30"
                ColumnSpacing="2"
                Margin="0,0,0,2"
                HorizontalAlignment="Stretch"
            >
                <arc:Button
                    Variant="Ghost"
                    Size="Small"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="8,6"
                    Command="{Binding OpenCommand}"
                >
                    <Grid
                        ColumnDefinitions="44,*,Auto,Auto"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="2"
                        RowSpacing="2"
                        MaxWidth="{Binding $parent[Button].Bounds.Width}"
                    >
                        <arc:Badge
                            Grid.RowSpan="2"
                            Content="{Binding Method}"
                            Tone="{Binding MethodTone}"
                            Size="Small"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Method}"
                        />
                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding Name}"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Name}"
                        />
                        <arc:Badge
                            Grid.Column="2"
                            Content="{Binding StatusLabel}"
                            Icon="{Binding StatusIcon}"
                            Tone="{Binding StatusTone}"
                            Size="Small"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding StatusLabel}"
                        />
                        <TextBlock
                            Grid.Column="3"
                            Grid.Row="1"
                            Text="{Binding DisplayTime}"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="{Binding TimestampText}"
                        />
                        <TextBlock
                            Grid.Column="1"
                            Grid.Row="1"
                            Text="{Binding Url}"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip.Tip="{Binding Url}"
                            Margin="0,0,4,0"
                        />
                    </Grid>
                </arc:Button>
                <arc:Button
                    Grid.Column="1"
                    Variant="Ghost"
                    Size="Small"
                    Padding="0"
                    Height="32"
                    VerticalAlignment="Center"
                    Command="{Binding DeleteCommand}"
                    ToolTip.Tip="移入回收站"
                    AutomationProperties.Name="删除历史记录"
                >
                    <arc:ArcGlyph
                        Data="{x:Static arc:ArcIcons.Trash2}"
                        Size="14"
                        Foreground="{arc:ArcDesignTokenResource Danger}"
                    />
                </arc:Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResponseHeaderTemplate" x:DataType="models:ResponseHeaderView">
            <Grid ColumnDefinitions="210,*" Margin="0,0,0,8">
                <TextBlock
                    Text="{Binding Key}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    TextWrapping="Wrap"
                />
                <SelectableTextBlock
                    Grid.Column="1"
                    Text="{Binding Value}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    FontFamily="{DynamicResource PostSharpCodeFont}"
                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                    TextWrapping="Wrap"
                />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="Border.treeRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        </Style>
        <Style Selector="Border.treeRow:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.treeRow.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.treeRow.selected:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.treeRow:focus">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.treeRow.dropTarget">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.treeRow.dropBefore">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.treeRow.dropAfter">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector=".rowActions" x:SetterTargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.treeRow:pointerover .rowActions" x:SetterTargetType="Button">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddRequestCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FormatBodyCommand}" />
    </Window.KeyBindings>

    <Panel x:Name="RootPanel">
        <VisualLayerManager EnableOverlayLayer="True">
            <Panel>
                <Grid RowDefinitions="Auto,*">
                    <!-- Product bar -->
                    <Border
                        x:Name="TitleBar"
                        Grid.Row="0"
                        Background="{arc:ArcDesignTokenResource Surface}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10"
                        PointerPressed="OnTitleBarPointerPressed"
                    >
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                            >
                                <Image
                                    Width="42"
                                    Height="42"
                                    Source="avares://PostSharp/Assets/logo.png"
                                    Stretch="Uniform"
                                    RenderOptions.BitmapInterpolationMode="HighQuality"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Text="PostSharp"
                                    FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                    FontWeight="SemiBold"
                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                    VerticalAlignment="Center"
                                />
                                <TextBlock
                                    Text="轻量接口调试"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                            >
                                <arc:Select
                                    Width="210"
                                    ItemsSource="{Binding Environments}"
                                    SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}"
                                    Placeholder="选择环境"
                                    AutomationProperties.Name="当前环境"
                                />
                                <arc:Button
                                    Variant="Secondary"
                                    Command="{Binding OpenEnvironmentDialogCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Globe}"
                                        Text="环境变量"
                                    />
                                </arc:Button>
                                <arc:Button
                                    Variant="Secondary"
                                    Command="{Binding #McpDialog.OpenCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Terminal}"
                                        Text="MCP 接入"
                                    />
                                </arc:Button>
                                <arc:Button
                                    Variant="Secondary"
                                    Command="{Binding OpenManagementCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.SlidersHorizontal}"
                                        Text="管理层"
                                    />
                                </arc:Button>
                                <arc:Button
                                    Variant="Secondary"
                                    Click="OnOpenSettingsClick"
                                    AutomationProperties.Name="打开设置"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Settings}"
                                        Text="设置"
                                    />
                                </arc:Button>
                                <Border
                                    Width="1"
                                    Height="22"
                                    Margin="6,0,2,0"
                                    Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                />
                                <arc:Button
                                    Classes="windowControl"
                                    Variant="Ghost"
                                    Size="Small"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Click="OnMinimizeWindowClick"
                                    ToolTip.Tip="最小化"
                                    AutomationProperties.Name="最小化"
                                >
                                    <arc:ArcGlyph
                                        Data="{x:Static arc:ArcIcons.Minus}"
                                        Size="15"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                </arc:Button>
                                <arc:Button
                                    x:Name="WindowMaximizeButton"
                                    Classes="windowControl"
                                    Variant="Ghost"
                                    Size="Small"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Click="OnToggleMaximizeWindowClick"
                                    ToolTip.Tip="最大化 / 还原"
                                    AutomationProperties.Name="最大化或还原"
                                >
                                    <Panel>
                                        <arc:ArcGlyph
                                            x:Name="WindowMaximizeGlyph"
                                            Data="{x:Static arc:ArcIcons.Square}"
                                            Size="14"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        />
                                        <arc:ArcGlyph
                                            x:Name="WindowRestoreGlyph"
                                            Data="{x:Static arc:ArcIcons.Minimize2}"
                                            Size="14"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            IsVisible="False"
                                        />
                                    </Panel>
                                </arc:Button>
                                <arc:Button
                                    Classes="windowClose"
                                    Variant="Ghost"
                                    Size="Small"
                                    Width="34"
                                    Height="32"
                                    Padding="0"
                                    Click="OnCloseWindowClick"
                                    ToolTip.Tip="关闭"
                                    AutomationProperties.Name="关闭"
                                >
                                    <arc:ArcGlyph
                                        Data="{x:Static arc:ArcIcons.X}"
                                        Size="15"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                </arc:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" x:Name="WorkspaceLayout">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="240" MaxWidth="520" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MinWidth="420" />
                        </Grid.ColumnDefinitions>

                        <!-- Left workspace -->
                        <Border Grid.Column="0" Background="{arc:ArcDesignTokenResource Surface}">
                            <Grid
                                x:Name="SidebarLayout"
                                Margin="12"
                                RowDefinitions="Auto,Auto,3*,Auto,2*,Auto"
                            >
                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="Auto,Auto,*,Auto"
                                    ColumnSpacing="6"
                                >
                                    <arc:Button
                                        Variant="Ghost"
                                        Size="Small"
                                        Padding="8,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding AddCollectionCommand}"
                                        ToolTip.Tip="新建集合"
                                        AutomationProperties.Name="新建集合"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Folder}"
                                            Text="新建集合"
                                            IconSize="14"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Grid.Column="1"
                                        Variant="Ghost"
                                        Size="Small"
                                        Padding="8,0"
                                        Command="{Binding Import.OpenImportDialogCommand}"
                                        ToolTip.Tip="导入或导出 OpenAPI、Postman Collection、cURL"
                                        AutomationProperties.Name="导入或导出"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Upload}"
                                            Text="导入"
                                            IconSize="14"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Grid.Column="3"
                                        Variant="Secondary"
                                        Size="Small"
                                        Padding="10,0"
                                        HorizontalAlignment="Right"
                                        Command="{Binding AddRequestCommand}"
                                        ToolTip.Tip="新建请求"
                                        AutomationProperties.Name="新建请求"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Plus}"
                                            Text="新建请求"
                                            IconSize="14"
                                        />
                                    </arc:Button>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="6"
                                    Margin="0,8,0,0"
                                >
                                    <arc:SearchField
                                        Placeholder="搜索"
                                        Text="{Binding FilterText, Mode=TwoWay}"
                                        ToolTip.Tip="搜索集合与请求"
                                        AutomationProperties.Name="搜索集合与请求"
                                    />
                                    <arc:SegmentedControl
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        SelectedValue="{Binding TreeFilterMode, Mode=TwoWay}"
                                        AutomationProperties.Name="集合筛选"
                                    >
                                        <arc:SegmentedOption Value="全部" Label="全部" />
                                        <arc:SegmentedOption Value="收藏" Label="收藏" />
                                    </arc:SegmentedControl>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,8,0,8">
                                    <arc:ScrollArea
                                        x:Name="CollectionScrollArea"
                                        HorizontalContentAlignment="Stretch"
                                        HorizontalScrollBarVisibility="Disabled"
                                    >
                                        <Grid>
                                            <ItemsControl
                                                ItemsSource="{Binding TreeNodes}"
                                                HorizontalAlignment="Stretch"
                                            >
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.DataTemplates>
                                                    <DataTemplate DataType="models:TreeCollectionNode">
                                                        <Border
                                                            Classes="treeRow"
                                                            Classes.selected="{Binding Collection.IsSelected}"
                                                            Margin="{Binding Indent}"
                                                            Focusable="True"
                                                            PointerPressed="OnTreeRowPointerPressed"
                                                            AutomationProperties.Name="{Binding Collection.Name}"
                                                        >
                                                            <Grid
                                                                ColumnDefinitions="24,*,Auto,40"
                                                                ColumnSpacing="2"
                                                            >
                                                                <arc:Button
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Width="24"
                                                                    Padding="0"
                                                                    Click="OnTreeCollectionChevronClick"
                                                                    AutomationProperties.Name="展开或折叠集合"
                                                                >
                                                                    <Panel VerticalAlignment="Center">
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                                            Size="14"
                                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                            IsVisible="{Binding !Collection.IsExpanded}"
                                                                        />
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.ChevronDown}"
                                                                            Size="14"
                                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                            IsVisible="{Binding Collection.IsExpanded}"
                                                                        />
                                                                    </Panel>
                                                                </arc:Button>
                                                                <Border
                                                                    Grid.Column="1"
                                                                    Background="Transparent"
                                                                    Padding="4,3"
                                                                    Cursor="Hand"
                                                                >
                                                                    <Grid
                                                                        ColumnDefinitions="18,*,Auto"
                                                                        ColumnSpacing="6"
                                                                    >
                                                                        <Panel VerticalAlignment="Center">
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.Folder}"
                                                                                Size="15"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                IsVisible="{Binding !Collection.IsExpanded}"
                                                                            />
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.FolderOpen}"
                                                                                Size="15"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                IsVisible="{Binding Collection.IsExpanded}"
                                                                            />
                                                                        </Panel>
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Text="{Binding Collection.Name}"
                                                                            FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                            FontWeight="Medium"
                                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                            VerticalAlignment="Center"
                                                                            TextTrimming="CharacterEllipsis"
                                                                        />
                                                                        <arc:ArcGlyph
                                                                            Grid.Column="2"
                                                                            Data="{x:Static arc:ArcIcons.Star}"
                                                                            Size="12"
                                                                            Foreground="{arc:ArcDesignTokenResource Warning}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding Collection.IsFavorite}"
                                                                        />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel
                                                                    Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center"
                                                                >
                                                                    <arc:Button
                                                                        Classes="rowActions"
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="24"
                                                                        Padding="0"
                                                                        IsTabStop="False"
                                                                        Click="OnTreeMoveRowUpClick"
                                                                        ToolTip.Tip="上移"
                                                                        AutomationProperties.Name="上移"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.ArrowUp}"
                                                                            Size="13"
                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        />
                                                                    </arc:Button>
                                                                    <arc:Button
                                                                        Classes="rowActions"
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="24"
                                                                        Padding="0"
                                                                        IsTabStop="False"
                                                                        Click="OnTreeMoveRowDownClick"
                                                                        ToolTip.Tip="下移"
                                                                        AutomationProperties.Name="下移"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.ArrowDown}"
                                                                            Size="13"
                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        />
                                                                    </arc:Button>
                                                                </StackPanel>
                                                                <arc:Button
                                                                    Grid.Column="3"
                                                                    Classes="rowActions"
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Width="40"
                                                                    Padding="0"
                                                                    IsTabStop="False"
                                                                    Click="OnTreeRowActionsClick"
                                                                    AutomationProperties.Name="更多操作"
                                                                >
                                                                    <arc:ArcGlyph
                                                                        Data="{x:Static arc:ArcIcons.Ellipsis}"
                                                                        Size="15"
                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    />
                                                                </arc:Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>

                                                    <DataTemplate DataType="models:TreeRequestNode">
                                                        <Border
                                                            Classes="treeRow"
                                                            Classes.selected="{Binding Request.IsSelected}"
                                                            Margin="{Binding Indent}"
                                                            Focusable="True"
                                                            PointerPressed="OnTreeRowPointerPressed"
                                                            AutomationProperties.Name="{Binding Request.Name}"
                                                        >
                                                            <Grid
                                                                ColumnDefinitions="*,Auto,40"
                                                                ColumnSpacing="2"
                                                            >
                                                                <Border
                                                                    Grid.Column="0"
                                                                    Background="Transparent"
                                                                    Padding="6,3"
                                                                    Cursor="Hand"
                                                                >
                                                                    <Grid
                                                                        ColumnDefinitions="18,*,Auto"
                                                                        ColumnSpacing="6"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.FileText}"
                                                                            Size="14"
                                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                            VerticalAlignment="Center"
                                                                        />
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            Text="{Binding Request.Name}"
                                                                            FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                            VerticalAlignment="Center"
                                                                            TextTrimming="CharacterEllipsis"
                                                                        />
                                                                        <arc:ArcGlyph
                                                                            Grid.Column="2"
                                                                            Data="{x:Static arc:ArcIcons.Star}"
                                                                            Size="12"
                                                                            Foreground="{arc:ArcDesignTokenResource Warning}"
                                                                            VerticalAlignment="Center"
                                                                            IsVisible="{Binding Request.IsFavorite}"
                                                                        />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center"
                                                                >
                                                                    <arc:Button
                                                                        Classes="rowActions"
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="24"
                                                                        Padding="0"
                                                                        IsTabStop="False"
                                                                        Click="OnTreeMoveRowUpClick"
                                                                        ToolTip.Tip="上移"
                                                                        AutomationProperties.Name="上移"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.ArrowUp}"
                                                                            Size="13"
                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        />
                                                                    </arc:Button>
                                                                    <arc:Button
                                                                        Classes="rowActions"
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="24"
                                                                        Padding="0"
                                                                        IsTabStop="False"
                                                                        Click="OnTreeMoveRowDownClick"
                                                                        ToolTip.Tip="下移"
                                                                        AutomationProperties.Name="下移"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.ArrowDown}"
                                                                            Size="13"
                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        />
                                                                    </arc:Button>
                                                                </StackPanel>
                                                                <arc:Button
                                                                    Grid.Column="2"
                                                                    Classes="rowActions"
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Width="40"
                                                                    Padding="0"
                                                                    IsTabStop="False"
                                                                    Click="OnTreeRowActionsClick"
                                                                    AutomationProperties.Name="更多操作"
                                                                >
                                                                    <arc:ArcGlyph
                                                                        Data="{x:Static arc:ArcIcons.Ellipsis}"
                                                                        Size="15"
                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    />
                                                                </arc:Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.DataTemplates>
                                            </ItemsControl>

                                            <TextBlock
                                                Text="{Binding TreeEmptyText}"
                                                IsVisible="{Binding TreeIsEmpty}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Margin="0,16,0,0"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                        </Grid>
                                    </arc:ScrollArea>
                                </Grid>

                                <Grid
                                    Grid.Row="3"
                                    ColumnDefinitions="Auto,*,Auto,Auto"
                                    ColumnSpacing="4"
                                    Margin="0,0,0,6"
                                >
                                    <arc:Button
                                        Grid.Column="0"
                                        Variant="Ghost"
                                        Size="Small"
                                        Width="24"
                                        Padding="0"
                                        Click="OnToggleHistoryClick"
                                        ToolTip.Tip="折叠或展开历史记录"
                                        AutomationProperties.Name="折叠或展开历史记录"
                                    >
                                        <Panel VerticalAlignment="Center">
                                            <arc:ArcGlyph
                                                Data="{x:Static arc:ArcIcons.ChevronDown}"
                                                Size="14"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                IsVisible="{Binding !Settings.HistoryCollapsed}"
                                            />
                                            <arc:ArcGlyph
                                                Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                Size="14"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                IsVisible="{Binding Settings.HistoryCollapsed}"
                                            />
                                        </Panel>
                                    </arc:Button>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="历史记录"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        VerticalAlignment="Center"
                                    />
                                    <arc:Button
                                        Grid.Column="2"
                                        Variant="Ghost"
                                        Size="Small"
                                        Padding="6,0"
                                        Command="{Binding OpenHistoryTrashCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Archive}"
                                            Text="{Binding RecycleBinLabel}"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Grid.Column="3"
                                        Variant="Ghost"
                                        Size="Small"
                                        Padding="6,0"
                                        Command="{Binding ClearHistoryCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Eraser}"
                                            Text="清空"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                </Grid>

                                <arc:ScrollArea
                                    Grid.Row="4"
                                    x:Name="HistoryScrollArea"
                                    HorizontalContentAlignment="Stretch"
                                    HorizontalScrollBarVisibility="Disabled"
                                    Margin="0,0,0,10"
                                    MinHeight="110"
                                    IsVisible="{Binding !Settings.HistoryCollapsed}"
                                >
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock
                                            Text="发送请求后会出现在这里。"
                                            IsVisible="{Binding !HasHistory}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            Margin="2,4,0,0"
                                            VerticalAlignment="Top"
                                            HorizontalAlignment="Center"
                                        />
                                        <ItemsControl
                                            x:Name="HistoryItems"
                                            ItemsSource="{Binding History}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            ItemTemplate="{StaticResource HistoryRowTemplate}"
                                        />
                                    </Grid>
                                </arc:ScrollArea>

                                <Border
                                    Grid.Row="5"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                    Padding="10,8"
                                >
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                VerticalAlignment="Center"
                                                Fill="{arc:ArcDesignTokenResource Success}"
                                            />
                                            <TextBlock
                                                Text="{Binding MockStatus}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                TextTrimming="CharacterEllipsis"
                                            />
                                        </StackPanel>
                                        <TextBlock
                                            Text="{Binding McpEndpoint}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            TextTrimming="CharacterEllipsis"
                                        />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <GridSplitter
                            x:Name="SidebarSplitter"
                            Grid.Column="1"
                            Width="8"
                            ResizeDirection="Columns"
                            ResizeBehavior="PreviousAndNext"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            Cursor="SizeWestEast"
                            Focusable="True"
                            KeyboardIncrement="16"
                            DragCompleted="OnSidebarSplitterDragCompleted"
                            DoubleTapped="OnSidebarSplitterDoubleTapped"
                            ToolTip.Tip="拖动调整集合栏宽度；双击恢复默认"
                            AutomationProperties.Name="调整集合栏宽度"
                        >
                            <GridSplitter.Template>
                                <ControlTemplate>
                                    <Border Background="Transparent">
                                        <Border
                                            Width="1"
                                            HorizontalAlignment="Center"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                        />
                                    </Border>
                                </ControlTemplate>
                            </GridSplitter.Template>
                        </GridSplitter>

                        <!-- Editor and response -->
                        <Grid x:Name="EditorResponseLayout" Grid.Column="2" Margin="16,12,16,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="0" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" MinHeight="0" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                >
                                    <arc:Input
                                        Width="240"
                                        Size="Small"
                                        IsLabelVisible="False"
                                        Placeholder="请求名称"
                                        Text="{Binding Editing.Name, Mode=TwoWay}"
                                        AutomationProperties.Name="请求名称"
                                    />
                                    <TextBlock
                                        Text="{Binding EditorHint}"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                                <arc:Button
                                    Grid.Column="1"
                                    Variant="Secondary"
                                    Size="Small"
                                    Command="{Binding SaveCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Check}"
                                        Text="保存"
                                    />
                                </arc:Button>
                            </Grid>

                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="Auto,*,Auto,Auto"
                                Margin="0,0,0,12"
                            >
                                <arc:Select
                                    Grid.Column="0"
                                    Width="130"
                                    MinWidth="120"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,10,0"
                                    ItemsSource="{Binding Methods}"
                                    SelectedItem="{Binding Editing.Method, Mode=TwoWay}"
                                    Placeholder="方法"
                                    AutomationProperties.Name="请求方法"
                                />
                                <arc:Input
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Placeholder="https://api.example.com/users"
                                    IsLabelVisible="False"
                                    Text="{Binding Editing.Url, Mode=TwoWay}"
                                    FontFamily="{DynamicResource PostSharpCodeFont}"
                                    AutomationProperties.Name="请求地址"
                                />
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                >
                                    <TextBlock
                                        Text="超时"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        VerticalAlignment="Center"
                                    />
                                    <arc:NumberField
                                        Width="150"
                                        IsLabelVisible="False"
                                        Minimum="0"
                                        Maximum="3600"
                                        Step="5"
                                        SuffixFormatter="{x:Static controls:TimeoutFormatting.SuffixFormatter}"
                                        Value="{Binding Editing.TimeoutSeconds, Mode=TwoWay}"
                                        ToolTip.Tip="本请求超时秒数；0 表示跟随设置中的全局超时"
                                        AutomationProperties.Name="请求超时（秒，0 跟随全局）"
                                    />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Variant="Primary"
                                        IsDefault="True"
                                        MinWidth="88"
                                        IsLoading="{Binding IsSending}"
                                        Command="{Binding SendCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.SendHorizontal}"
                                            Text="发送"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        IsVisible="{Binding IsSending}"
                                        Command="{Binding CancelSendCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.X}"
                                            Text="取消"
                                        />
                                    </arc:Button>
                                </StackPanel>
                            </Grid>

                            <arc:Tabs
                                Grid.Row="2"
                                x:Name="RequestTabs"
                                ClipToBounds="True"
                                AutomationProperties.Name="请求配置"
                            >
                                <arc:TabItem Header="参数">
                                    <Grid RowDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                                        <Grid ColumnDefinitions="44,*,*,34" Margin="0,0,0,6">
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="键"
                                                Margin="16,0,0,0"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="值"
                                                Margin="16,0,0,0"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                        </Grid>
                                        <arc:ScrollArea Grid.Row="1">
                                            <ItemsControl
                                                ItemsSource="{Binding Editing.Params}"
                                                ItemTemplate="{StaticResource KeyValueRowTemplate}"
                                            />
                                        </arc:ScrollArea>
                                        <TextBlock
                                            Grid.Row="2"
                                            Text="填写最后一行会自动新增一行；未启用的行不会发送。"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            Margin="0,8,0,0"
                                        />
                                    </Grid>
                                </arc:TabItem>

                                <arc:TabItem Header="请求头">
                                    <Grid
                                        RowDefinitions="Auto,Auto,Auto,*"
                                        Margin="0,6,0,0"
                                        RowSpacing="8"
                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <arc:Button
                                                Variant="Ghost"
                                                Size="Small"
                                                Command="{Binding AddJsonContentTypeCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Code}"
                                                    Text="JSON 类型"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <arc:Button
                                                Variant="Ghost"
                                                Size="Small"
                                                Command="{Binding AddAcceptJsonCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.CircleCheck}"
                                                    Text="Accept JSON"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <arc:Button
                                                Variant="Ghost"
                                                Size="Small"
                                                Command="{Binding AddBearerTokenCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Key}"
                                                    Text="Bearer Token"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="3">
                                            <TextBlock
                                                Text="{Binding HeaderWarningText}"
                                                IsVisible="{Binding HasHeaderWarning}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource Danger}"
                                                TextWrapping="Wrap"
                                            />
                                            <TextBlock
                                                Text="支持 {{变量}}；发送时自动补充 Accept: */*、User-Agent: PostSharp/0.1；请求体模式下自动补充 Content-Type。"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                TextWrapping="Wrap"
                                            />
                                        </StackPanel>
                                        <Grid Grid.Row="2" ColumnDefinitions="44,*,*,34">
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="键"
                                                Margin="16,0,0,0"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="值"
                                                Margin="16,0,0,0"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                        </Grid>
                                        <arc:ScrollArea Grid.Row="3">
                                            <ItemsControl
                                                ItemsSource="{Binding Editing.Headers}"
                                                ItemTemplate="{StaticResource KeyValueRowTemplate}"
                                            />
                                        </arc:ScrollArea>
                                    </Grid>
                                </arc:TabItem>

                                <arc:TabItem Header="请求体">
                                    <Grid RowDefinitions="Auto,*" Margin="0,6,0,0" RowSpacing="10">
                                        <WrapPanel ItemSpacing="12" LineSpacing="8">
                                            <arc:SegmentedControl
                                                SelectedValue="{Binding Editing.BodyMode, Mode=TwoWay}"
                                                AutomationProperties.Name="请求体格式"
                                            >
                                                <arc:SegmentedOption Value="None" Label="无" />
                                                <arc:SegmentedOption Value="Json" Label="JSON" />
                                                <arc:SegmentedOption Value="Text" Label="文本" />
                                                <arc:SegmentedOption
                                                    Value="Multipart"
                                                    Label="表单上传"
                                                />
                                            </arc:SegmentedControl>
                                            <arc:Switch
                                                Content="单行"
                                                IsChecked="{Binding IsBodySingleLine, Mode=TwoWay}"
                                            />
                                            <arc:Switch
                                                Content="JSON 视图"
                                                IsChecked="{Binding IsRequestBodyJsonView, Mode=TwoWay}"
                                                IsVisible="{Binding IsJsonBody}"
                                            />
                                            <arc:Button
                                                Variant="Ghost"
                                                Size="Small"
                                                Command="{Binding FormatBodyCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Code}"
                                                    Text="格式化"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <arc:Button
                                                Variant="Ghost"
                                                Size="Small"
                                                Command="{Binding MinifyBodyCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Shrink}"
                                                    Text="压缩"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <TextBlock
                                                Text="请求体中同样可以使用 {{变量}}。"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                VerticalAlignment="Center"
                                            />
                                        </WrapPanel>

                                        <Grid Grid.Row="1">
                                            <Grid
                                                IsVisible="{Binding ShowRequestBodyEditor}"
                                                RowDefinitions="Auto,*"
                                                RowSpacing="8"
                                            >
                                                <TextBlock
                                                    Text="{Binding BodyPreview}"
                                                    FontFamily="{DynamicResource PostSharpCodeFont}"
                                                    FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextTrimming="CharacterEllipsis"
                                                />
                                                <Grid Grid.Row="1">
                                                    <arc:Textarea
                                                        x:Name="RequestBodyTextarea"
                                                        Text="{Binding Editing.Body, Mode=TwoWay}"
                                                        IsVisible="{Binding !IsBodySingleLine}"
                                                        IsLabelVisible="False"
                                                        Placeholder="{}{ &quot;name&quot;: &quot;PostSharp&quot; }"
                                                        IsResizable="False"
                                                        FrameHeight="240"
                                                        MinHeight="80"
                                                        ClipToBounds="True"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                        FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                        AutomationProperties.Name="请求体"
                                                    />
                                                    <arc:Input
                                                        Text="{Binding Editing.Body, Mode=TwoWay}"
                                                        IsVisible="{Binding IsBodySingleLine}"
                                                        IsLabelVisible="False"
                                                        Size="Small"
                                                        AcceptsReturn="False"
                                                        MaxLines="1"
                                                        MinLines="1"
                                                        TextWrapping="NoWrap"
                                                        Placeholder="{}{ &quot;name&quot;: &quot;PostSharp&quot; }"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                        FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                        AutomationProperties.Name="请求体（单行）"
                                                    />
                                                </Grid>
                                            </Grid>

                                            <arc:JsonViewer
                                                x:Name="JsonRequestBodyViewer"
                                                Json="{Binding Editing.Body}"
                                                IsVisible="{Binding ShowRequestBodyJsonViewer}"
                                                ExpandDepth="2"
                                                MaxTreeHeight="320"
                                                SearchPlaceholder="搜索请求体键和值"
                                                AutomationProperties.Name="JSON 请求体"
                                            />

                                            <Grid
                                                IsVisible="{Binding IsMultipartBody}"
                                                RowDefinitions="Auto,Auto,Auto,*"
                                                RowSpacing="8"
                                            >
                                                <Grid
                                                    ColumnDefinitions="*,Auto,Auto"
                                                    ColumnSpacing="8"
                                                >
                                                    <TextBlock
                                                        Text="上传文件"
                                                        VerticalAlignment="Center"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="1"
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Click="OnPickUploadFilesClick"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Upload}"
                                                            Text="选择文件…"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Grid.Column="2"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Click="OnClearUploadFilesClick"
                                                        IsEnabled="{Binding HasUploadFile}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.X}"
                                                            Text="清空"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </Grid>
                                                <Border
                                                    Grid.Row="1"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="8"
                                                    MinHeight="64"
                                                    DragDrop.AllowDrop="True"
                                                    DragDrop.DragOver="OnUploadDragOver"
                                                    DragDrop.Drop="OnUploadDrop"
                                                >
                                                    <Grid>
                                                        <TextBlock
                                                            IsVisible="{Binding !HasUploadFile}"
                                                            Text="拖拽文件到这里，或点击「选择文件…」"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        />
                                                        <arc:ScrollArea
                                                            MaxHeight="140"
                                                            IsVisible="{Binding HasUploadFile}"
                                                        >
                                                            <ItemsControl ItemsSource="{Binding Editing.UploadFiles}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:UploadFileItem">
                                                                        <Grid
                                                                            ColumnDefinitions="150,*,Auto"
                                                                            ColumnSpacing="8"
                                                                            Margin="0,0,0,4"
                                                                        >
                                                                            <arc:Input
                                                                                Text="{Binding FieldName, Mode=TwoWay}"
                                                                                IsLabelVisible="False"
                                                                                Size="Small"
                                                                                Placeholder="file"
                                                                                AutomationProperties.Name="文件字段名"
                                                                            />
                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                Text="{Binding DisplayLabel}"
                                                                                VerticalAlignment="Center"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding FilePath}"
                                                                            />
                                                                            <arc:Button
                                                                                Grid.Column="2"
                                                                                Variant="Ghost"
                                                                                Size="Small"
                                                                                Click="OnRemoveUploadFileClick"
                                                                                CommandParameter="{Binding}"
                                                                                AutomationProperties.Name="移除上传文件"
                                                                            >
                                                                                <controls:IconLabel
                                                                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                                                                    Text="移除"
                                                                                    IconSize="13"
                                                                                    TextForeground="{arc:ArcDesignTokenResource Danger}"
                                                                                    IconForeground="{arc:ArcDesignTokenResource Danger}"
                                                                                />
                                                                            </arc:Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </arc:ScrollArea>
                                                    </Grid>
                                                </Border>
                                                <StackPanel
                                                    Grid.Row="2"
                                                    Spacing="4"
                                                    IsVisible="{Binding IsUploading}"
                                                >
                                                    <ProgressBar
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding UploadProgressValue}"
                                                        Height="6"
                                                        Foreground="{arc:ArcDesignTokenResource Accent}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding UploadProgressText}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </StackPanel>
                                                <Grid
                                                    Grid.Row="3"
                                                    RowDefinitions="Auto,*"
                                                    RowSpacing="6"
                                                >
                                                    <TextBlock
                                                        Text="表单字段"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        FontWeight="Medium"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    />
                                                    <arc:ScrollArea Grid.Row="1">
                                                        <ItemsControl
                                                            ItemsSource="{Binding Editing.FormFields}"
                                                            ItemTemplate="{StaticResource KeyValueRowTemplate}"
                                                        />
                                                    </arc:ScrollArea>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </arc:TabItem>

                                <arc:TabItem Header="cURL">
                                    <Grid RowDefinitions="Auto,*" Margin="0,6,0,0" RowSpacing="10">
                                        <Grid
                                            ColumnDefinitions="*,Auto,Auto,Auto"
                                            ColumnSpacing="8"
                                        >
                                            <TextBlock
                                                Text="已按当前环境解析变量，可复制 bash cURL 或保存 PowerShell 脚本。"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap"
                                            />
                                            <arc:Button
                                                Grid.Column="1"
                                                Content="保存 cURL…"
                                                Variant="Ghost"
                                                Size="Small"
                                                Click="OnExportCurlClick"
                                                IsEnabled="{Binding CanExportCurl}"
                                                AutomationProperties.Name="保存当前请求 cURL"
                                            />
                                            <arc:Button
                                                Grid.Column="2"
                                                Content="保存 PowerShell…"
                                                Variant="Ghost"
                                                Size="Small"
                                                Click="OnExportPowerShellClick"
                                                IsEnabled="{Binding CanExportCurl}"
                                                AutomationProperties.Name="保存当前请求 PowerShell"
                                            />
                                            <arc:CopyButton
                                                Grid.Column="3"
                                                Value="{Binding CurlPreview}"
                                                Label="复制 cURL"
                                                Variant="Plain"
                                            />
                                        </Grid>
                                        <arc:ScrollArea Grid.Row="1">
                                            <arc:CodeBlock
                                                Code="{Binding CurlPreview}"
                                                Language="bash"
                                                FileName="request.sh"
                                                IsCollapsible="False"
                                                CopyLabel="复制 cURL"
                                            />
                                        </arc:ScrollArea>
                                    </Grid>
                                </arc:TabItem>
                            </arc:Tabs>

                            <GridSplitter
                                x:Name="RequestResponseSplitter"
                                Grid.Row="3"
                                Height="8"
                                ResizeDirection="Rows"
                                ResizeBehavior="PreviousAndNext"
                                Background="Transparent"
                                HorizontalAlignment="Stretch"
                                Focusable="True"
                                Cursor="SizeNorthSouth"
                                KeyboardIncrement="24"
                                DragCompleted="OnRequestResponseSplitterDragCompleted"
                                DoubleTapped="OnRequestResponseSplitterDoubleTapped"
                                ToolTip.Tip="拖动调整请求 / 响应高度；双击恢复默认"
                                AutomationProperties.Name="调整请求与响应高度"
                            >
                                <GridSplitter.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <Border
                                                Width="42"
                                                Height="3"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="{arc:ArcDesignTokenResource Border}"
                                            />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>

                            <Grid Grid.Row="4" RowDefinitions="Auto,*" ClipToBounds="True">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center"
                                    >
                                        <arc:Badge
                                            Content="{Binding ResponseStatusText}"
                                            Icon="{Binding ResponseStatusIcon}"
                                            Tone="{Binding ResponseTone}"
                                            Size="Small"
                                            IsVisible="{Binding HasResponse}"
                                        />
                                        <TextBlock
                                            Text="{Binding ResponseTimeText}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            IsVisible="{Binding HasResponse}"
                                        />
                                        <TextBlock
                                            Text="{Binding ResponseSizeText}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            IsVisible="{Binding HasResponse}"
                                        />
                                        <TextBlock
                                            Text="{Binding ResponseContentType}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            IsVisible="{Binding HasResponse}"
                                        />
                                        <TextBlock
                                            Text="响应"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            FontWeight="Medium"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding ShowEmptyResponse}"
                                        />
                                    </StackPanel>
                                    <arc:CopyButton
                                        Grid.Column="1"
                                        Value="{Binding ResponseClipboardText}"
                                        Label="复制响应"
                                        Variant="Plain"
                                        IsVisible="{Binding HasResponse}"
                                    />
                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    IsVisible="{Binding ShowResponseError}"
                                    Background="{arc:ArcDesignTokenResource DangerSubtle}"
                                    BorderBrush="{arc:ArcDesignTokenResource Danger}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="16"
                                >
                                    <StackPanel Spacing="8">
                                        <arc:Badge Content="请求失败" Tone="Danger" Size="Small" />
                                        <TextBlock
                                            Text="{Binding ResponseError}"
                                            TextWrapping="Wrap"
                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                        />
                                        <TextBlock
                                            Text="检查请求地址、网络连接或 Mock 服务是否在运行。"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        />
                                    </StackPanel>
                                </Border>

                                <arc:Tabs
                                    Grid.Row="1"
                                    x:Name="ResponseTabs"
                                    IsVisible="{Binding HasResponse}"
                                    SelectedIndex="{Binding ResponseTabIndex, Mode=TwoWay}"
                                    AutomationProperties.Name="响应"
                                >
                                    <arc:TabItem Header="响应体">
                                        <Grid
                                            RowDefinitions="Auto,Auto,*"
                                            Margin="0,6,0,0"
                                            RowSpacing="8"
                                        >
                                            <WrapPanel ItemSpacing="10" LineSpacing="6">
                                                <arc:Switch
                                                    Content="单行"
                                                    IsChecked="{Binding IsResponseSingleLine, Mode=TwoWay}"
                                                    AutomationProperties.Name="响应单行"
                                                />
                                                <arc:Switch
                                                    Content="JSON 视图"
                                                    IsChecked="{Binding IsResponseJsonView, Mode=TwoWay}"
                                                    IsVisible="{Binding IsJsonResponse}"
                                                    AutomationProperties.Name="响应 JSON 视图"
                                                />
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding FormatResponseCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Code}"
                                                        Text="格式化"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding MinifyResponseCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Shrink}"
                                                        Text="压缩"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </WrapPanel>
                                            <Border
                                                Grid.Row="1"
                                                IsVisible="{Binding ShowLargeResponseBanner}"
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                Padding="12,8"
                                            >
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock
                                                        Text="{Binding LargeResponseNotice}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="1"
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Margin="12,0,0,0"
                                                        Click="OnOpenResponseDetailClick"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Expand}"
                                                            Text="查看完整响应"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="2" ClipToBounds="True">
                                                <arc:JsonViewer
                                                    x:Name="JsonResponseViewer"
                                                    Json="{Binding ResponseBody}"
                                                    IsVisible="{Binding ShowJsonResponse}"
                                                    ExpandDepth="2"
                                                    MaxTreeHeight="220"
                                                    SearchPlaceholder="搜索键和值"
                                                    AutomationProperties.Name="JSON 响应"
                                                />
                                                <arc:ScrollArea IsVisible="{Binding ShowRawResponse}">
                                                    <SelectableTextBlock
                                                        Text="{Binding ResponseBody}"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                        FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                        TextWrapping="NoWrap"
                                                    />
                                                </arc:ScrollArea>
                                                <arc:ScrollArea IsVisible="{Binding ShowResponseSingleLine}">
                                                    <SelectableTextBlock
                                                        Text="{Binding ResponseSingleLineText}"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                        FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                        TextWrapping="NoWrap"
                                                    />
                                                </arc:ScrollArea>
                                            </Grid>
                                        </Grid>
                                    </arc:TabItem>

                                    <arc:TabItem Header="响应头">
                                        <arc:ScrollArea Margin="0,6,0,0">
                                            <ItemsControl
                                                ItemsSource="{Binding ResponseHeaders}"
                                                ItemTemplate="{StaticResource ResponseHeaderTemplate}"
                                            />
                                        </arc:ScrollArea>
                                    </arc:TabItem>

                                    <arc:TabItem Header="AI 聚合">
                                        <Grid
                                            RowDefinitions="Auto,Auto,*"
                                            RowSpacing="8"
                                            Margin="0,6,0,0"
                                        >
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <arc:SegmentedControl
                                                    SelectedValue="{Binding SseViewMode, Mode=TwoWay}"
                                                    AutomationProperties.Name="AI 聚合视图"
                                                >
                                                    <arc:SegmentedOption
                                                        Value="内容"
                                                        Label="内容"
                                                    />
                                                    <arc:SegmentedOption
                                                        Value="思考过程"
                                                        Label="思考过程"
                                                    />
                                                    <arc:SegmentedOption
                                                        Value="原始事件"
                                                        Label="原始事件"
                                                    />
                                                </arc:SegmentedControl>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                >
                                                    <arc:Button
                                                        Content="继续"
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Command="{Binding ResumeSseCommand}"
                                                        IsVisible="{Binding CanResumeSse}"
                                                        ToolTip.Tip="从上次事件的 Last-Event-ID 继续接收"
                                                        AutomationProperties.Name="继续接收 SSE"
                                                    />
                                                    <arc:CopyButton
                                                        Value="{Binding SseContent}"
                                                        Label="复制内容"
                                                        Variant="Plain"
                                                        IsVisible="{Binding ShowSseContent}"
                                                    />
                                                    <arc:CopyButton
                                                        Value="{Binding SseThinking}"
                                                        Label="复制思考"
                                                        Variant="Plain"
                                                        IsVisible="{Binding ShowSseThinking}"
                                                    />
                                                    <arc:CopyButton
                                                        Value="{Binding SseRaw}"
                                                        Label="复制原始流"
                                                        Variant="Plain"
                                                        IsVisible="{Binding ShowSseRaw}"
                                                    />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                Grid.Row="1"
                                                Text="{Binding SseSummary}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                TextWrapping="Wrap"
                                            />
                                            <Grid Grid.Row="2">
                                                <Grid IsVisible="{Binding ShowSseContent}">
                                                    <arc:ScrollArea>
                                                        <SelectableTextBlock
                                                            Text="{Binding SseContent}"
                                                            FontFamily="{DynamicResource PostSharpCodeFont}"
                                                            FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            TextWrapping="Wrap"
                                                        />
                                                    </arc:ScrollArea>
                                                    <TextBlock
                                                        Text="没有解析到 content；可切换到「原始事件」查看推送内容。"
                                                        IsVisible="{Binding !HasSseContent}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </Grid>
                                                <Grid IsVisible="{Binding ShowSseThinking}">
                                                    <arc:ScrollArea>
                                                        <SelectableTextBlock
                                                            Text="{Binding SseThinking}"
                                                            FontFamily="{DynamicResource PostSharpCodeFont}"
                                                            FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            TextWrapping="Wrap"
                                                        />
                                                    </arc:ScrollArea>
                                                    <TextBlock
                                                        Text="没有解析到 thinking；可切换到「原始事件」查看推送内容。"
                                                        IsVisible="{Binding !HasSseThinking}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </Grid>
                                                <arc:ScrollArea IsVisible="{Binding ShowSseRaw}">
                                                    <SelectableTextBlock
                                                        Text="{Binding SseRaw}"
                                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                                        FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                        TextWrapping="NoWrap"
                                                    />
                                                </arc:ScrollArea>
                                                <arc:EmptyState
                                                    IsVisible="{Binding !IsSseResponse}"
                                                    Title="当前响应不是 SSE"
                                                    Description="发送 text/event-stream 请求后，这里会聚合 thinking 和 content；原始事件仍可在响应体查看。"
                                                    Label="AI 输出"
                                                />
                                            </Grid>
                                        </Grid>
                                    </arc:TabItem>
                                </arc:Tabs>

                                <arc:EmptyState
                                    Grid.Row="1"
                                    IsVisible="{Binding ShowEmptyResponse}"
                                    Label="响应"
                                    Title="还没有响应"
                                    Description="按 Ctrl+Enter 或点击发送。默认示例请求已指向内置 Mock 服务，不需要联网。"
                                    VerticalAlignment="Center"
                                />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- In-window context menu for the collection tree; keeps the Arc styling and never leaves the window. -->
                <Panel x:Name="TreeMenuOverlay" IsVisible="False">
                    <Border Background="Transparent" PointerPressed="OnTreeMenuDismiss" />
                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Border
                            x:Name="TreeMenuCard"
                            Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                            BorderBrush="{arc:ArcDesignTokenResource Border}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                            Padding="6"
                        >
                            <StackPanel Width="190" Spacing="2">
                                <StackPanel x:Name="TreeMenuCollectionSection" Spacing="2">
                                    <arc:Button
                                        x:Name="TreeMenuNewRequestButton"
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        Click="OnTreeMenuNewRequestClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.FilePlus}"
                                            Text="新建请求"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        x:Name="TreeMenuNewSubcollectionButton"
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        Click="OnTreeMenuNewSubcollectionClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Folder}"
                                            Text="新建二级集合"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <Border
                                        Height="1"
                                        Margin="6,4"
                                        Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                    />
                                </StackPanel>
                                <StackPanel x:Name="TreeMenuRequestSection" Spacing="2">
                                    <arc:Button
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        IsVisible="{Binding IsRequestSelected}"
                                        Command="{Binding DuplicateSelectedRequestCommand}"
                                        Click="OnTreeMenuItemClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Copy}"
                                            Text="复制请求"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        IsVisible="{Binding IsRequestSelected}"
                                        Command="{Binding CopySelectedUrlCommand}"
                                        Click="OnTreeMenuItemClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Link2}"
                                            Text="复制 URL"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <Border
                                        Height="1"
                                        Margin="6,4"
                                        Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                    />
                                </StackPanel>
                                <StackPanel x:Name="TreeMenuOrderSection" Spacing="2">
                                    <arc:Button
                                        x:Name="TreeMenuMoveUpButton"
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        Click="OnTreeMenuMoveUpClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.ArrowUp}"
                                            Text="上移"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        x:Name="TreeMenuMoveDownButton"
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        Click="OnTreeMenuMoveDownClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.ArrowDown}"
                                            Text="下移"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <Border
                                        Height="1"
                                        Margin="6,4"
                                        Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                    />
                                </StackPanel>
                                <arc:Button
                                    x:Name="TreeMenuFavoriteButton"
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    Click="OnTreeMenuFavoriteClick"
                                >
                                    <controls:IconLabel
                                        x:Name="TreeMenuFavoriteLabel"
                                        Icon="{x:Static arc:ArcIcons.Star}"
                                        Text="收藏"
                                        IconSize="13"
                                    />
                                </arc:Button>
                                <arc:Button
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    IsVisible="{Binding HasSelection}"
                                    Command="{Binding RenameSelectedCommand}"
                                    Click="OnTreeMenuItemClick"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Pencil}"
                                        Text="重命名"
                                        IconSize="13"
                                    />
                                </arc:Button>
                                <arc:Button
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    IsVisible="{Binding HasSelection}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Click="OnTreeMenuItemClick"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.Trash2}"
                                        Text="删除"
                                        IconSize="13"
                                        TextForeground="{arc:ArcDesignTokenResource Danger}"
                                        IconForeground="{arc:ArcDesignTokenResource Danger}"
                                    />
                                </arc:Button>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Panel>

                <!-- Management layer: AI audit trail and automation suites. -->
                <Panel x:Name="ManagementOverlay" IsVisible="{Binding IsManagementOpen}">
                    <Border
                        Background="{arc:ArcDesignTokenResource Scrim}"
                        PointerPressed="OnManagementDismiss"
                    />
                    <Border
                        Margin="32"
                        Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                        BorderBrush="{arc:ArcDesignTokenResource Border}"
                        BorderThickness="1"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                        Padding="20"
                    >
                        <Grid RowDefinitions="Auto,*" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Text="管理层"
                                        FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                        FontWeight="SemiBold"
                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                    />
                                    <TextBlock
                                        Text="AI 调用审计 · 自动化接口测试 · 统一管理 AI 触发的请求"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    />
                                </StackPanel>
                                <arc:Button
                                    Grid.Column="1"
                                    Variant="Secondary"
                                    Command="{Binding CloseManagementCommand}"
                                >
                                    <controls:IconLabel
                                        Icon="{x:Static arc:ArcIcons.X}"
                                        Text="关闭"
                                        IconSize="13"
                                    />
                                </arc:Button>
                            </Grid>

                            <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
                                <arc:SegmentedControl
                                    SelectedValue="{Binding ManagementTab, Mode=TwoWay}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="管理层视图"
                                >
                                    <arc:SegmentedOption Value="审计" Label="审计" />
                                    <arc:SegmentedOption Value="自动化" Label="自动化" />
                                    <arc:SegmentedOption Value="指南" Label="指南" />
                                </arc:SegmentedControl>

                                <Grid Grid.Row="1">
                                    <Grid
                                        IsVisible="{Binding IsAuditTab}"
                                        RowDefinitions="Auto,*"
                                        RowSpacing="10"
                                    >
                                        <Grid
                                            ColumnDefinitions="*,Auto,Auto,Auto"
                                            ColumnSpacing="8"
                                        >
                                            <arc:SearchField
                                                Placeholder="搜索请求、URL、工具或客户端"
                                                Text="{Binding AuditFilterText, Mode=TwoWay}"
                                                AutomationProperties.Name="搜索审计"
                                            />
                                            <arc:SegmentedControl
                                                Grid.Column="1"
                                                SelectedValue="{Binding AuditSourceFilter, Mode=TwoWay}"
                                                AutomationProperties.Name="审计来源"
                                            >
                                                <arc:SegmentedOption Value="全部" Label="全部" />
                                                <arc:SegmentedOption Value="UI" Label="UI" />
                                                <arc:SegmentedOption Value="MCP" Label="MCP" />
                                            </arc:SegmentedControl>
                                            <arc:Button
                                                Grid.Column="2"
                                                Variant="Ghost"
                                                Size="Small"
                                                VerticalAlignment="Center"
                                                Command="{Binding OpenAuditTrashCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Archive}"
                                                    Text="{Binding AuditTrashLabel}"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <arc:Button
                                                Grid.Column="3"
                                                Variant="Ghost"
                                                Size="Small"
                                                VerticalAlignment="Center"
                                                Command="{Binding ClearAuditCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Eraser}"
                                                    Text="清空审计"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                        </Grid>

                                        <Grid
                                            Grid.Row="1"
                                            ColumnDefinitions="1.05*,0.95*"
                                            ColumnSpacing="14"
                                        >
                                            <Border
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="4"
                                            >
                                                <arc:ScrollArea
                                                    x:Name="AuditScrollArea"
                                                    HorizontalContentAlignment="Stretch"
                                                >
                                                    <ItemsControl
                                                        ItemsSource="{Binding VisibleAudit}"
                                                        HorizontalAlignment="Stretch"
                                                        Width="{Binding #AuditScrollArea.Bounds.Width}"
                                                    >
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:AuditEntry">
                                                                <arc:Button
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Width="{Binding $parent[arc:ScrollArea].Bounds.Width}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="0"
                                                                    Margin="0,0,0,4"
                                                                    AutomationProperties.Name="{Binding RequestName}"
                                                                    Click="OnAuditRowClick"
                                                                >
                                                                    <Border
                                                                        Background="{arc:ArcDesignTokenResource Surface}"
                                                                        HorizontalAlignment="Stretch"
                                                                        Width="{Binding $parent[arc:Button].Bounds.Width}"
                                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                        Padding="10,8"
                                                                    >
                                                                        <Grid
                                                                            ColumnDefinitions="88,*,Auto,Auto"
                                                                            RowDefinitions="Auto,Auto"
                                                                            ColumnSpacing="8"
                                                                            RowSpacing="3"
                                                                        >
                                                                            <arc:Badge
                                                                                Grid.RowSpan="2"
                                                                                Content="{Binding SourceLabel}"
                                                                                Icon="{Binding SourceIcon}"
                                                                                Tone="{Binding SourceTone}"
                                                                                Size="Small"
                                                                                Width="88"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip.Tip="{Binding SourceTooltip}"
                                                                            />
                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                Text="{Binding RequestName}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding RequestName}"
                                                                            />
                                                                            <arc:Badge
                                                                                Grid.Column="2"
                                                                                Content="{Binding StatusShortLabel}"
                                                                                Icon="{Binding StatusIcon}"
                                                                                Tone="{Binding StatusTone}"
                                                                                Size="Small"
                                                                                VerticalAlignment="Center"
                                                                                ToolTip.Tip="{Binding StatusLabel}"
                                                                            />
                                                                            <TextBlock
                                                                                Grid.Column="3"
                                                                                Text="{Binding TimeText}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="6,0,0,0"
                                                                                ToolTip.Tip="{Binding TimeTooltip}"
                                                                            />
                                                                            <Grid
                                                                                Grid.Row="1"
                                                                                Grid.Column="1"
                                                                                Grid.ColumnSpan="3"
                                                                                ColumnDefinitions="Auto,*"
                                                                                ColumnSpacing="6"
                                                                            >
                                                                                <arc:Badge
                                                                                    Content="{Binding Method}"
                                                                                    Tone="{Binding MethodTone}"
                                                                                    Size="Small"
                                                                                    ToolTip.Tip="{Binding RequestLine}"
                                                                                />
                                                                                <TextBlock
                                                                                    Grid.Column="1"
                                                                                    Text="{Binding Url}"
                                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                    VerticalAlignment="Center"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    ToolTip.Tip="{Binding Url}"
                                                                                />
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                </arc:Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </arc:ScrollArea>
                                            </Border>

                                            <Border
                                                Grid.Column="1"
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="12"
                                            >
                                                <Grid>
                                                    <arc:ScrollArea IsVisible="{Binding HasSelectedAuditEntry}">
                                                        <StackPanel Spacing="10">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock
                                                                        Text="{Binding SelectedAuditEntry.RequestName}"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                        TextWrapping="Wrap"
                                                                    />
                                                                    <SelectableTextBlock
                                                                        Text="{Binding SelectedAuditEntry.Url}"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        TextWrapping="Wrap"
                                                                    />
                                                                </StackPanel>
                                                                <arc:Button
                                                                    Grid.Column="1"
                                                                    Variant="Secondary"
                                                                    Size="Small"
                                                                    Command="{Binding OpenSelectedAuditRequestCommand}"
                                                                >
                                                                    <controls:IconLabel
                                                                        Icon="{x:Static arc:ArcIcons.ArrowUpRight}"
                                                                        Text="打开请求"
                                                                        IconSize="13"
                                                                    />
                                                                </arc:Button>
                                                            </Grid>

                                                            <WrapPanel
                                                                ItemSpacing="8"
                                                                LineSpacing="6"
                                                            >
                                                                <arc:Badge
                                                                    Content="{Binding SelectedAuditEntry.SourceLabel}"
                                                                    Icon="{Binding SelectedAuditEntry.SourceIcon}"
                                                                    Tone="{Binding SelectedAuditEntry.SourceTone}"
                                                                    Size="Small"
                                                                    ToolTip.Tip="{Binding SelectedAuditEntry.SourceTooltip}"
                                                                />
                                                                <arc:Badge
                                                                    Content="{Binding SelectedAuditEntry.StatusLabel}"
                                                                    Icon="{Binding SelectedAuditEntry.StatusIcon}"
                                                                    Tone="{Binding SelectedAuditEntry.StatusTone}"
                                                                    Size="Small"
                                                                />
                                                                <arc:Badge
                                                                    Content="{Binding SelectedAuditEntry.Method}"
                                                                    Tone="{Binding SelectedAuditEntry.MethodTone}"
                                                                    Size="Small"
                                                                />
                                                                <TextBlock
                                                                    Text="{Binding SelectedAuditEntry.DurationText}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                />
                                                                <TextBlock
                                                                    Text="{Binding SelectedAuditEntry.SizeText}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                />
                                                                <TextBlock
                                                                    Text="{Binding SelectedAuditEntry.TimeText}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                />
                                                            </WrapPanel>

                                                            <Grid
                                                                ColumnDefinitions="*,*"
                                                                ColumnSpacing="8"
                                                            >
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock
                                                                        Text="客户端"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    />
                                                                    <TextBlock
                                                                        Text="{Binding SelectedAuditEntry.ClientLabel}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    />
                                                                </StackPanel>
                                                                <StackPanel
                                                                    Grid.Column="1"
                                                                    Spacing="2"
                                                                >
                                                                    <TextBlock
                                                                        Text="工具"
                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    />
                                                                    <TextBlock
                                                                        Text="{Binding SelectedAuditEntry.ToolLabel}"
                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    />
                                                                </StackPanel>
                                                            </Grid>

                                                            <TextBlock
                                                                Text="{Binding SelectedAuditEntry.Error}"
                                                                Foreground="{arc:ArcDesignTokenResource Danger}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                TextWrapping="Wrap"
                                                            />

                                                            <StackPanel
                                                                IsVisible="{Binding SelectedAuditEntry.HasAiOutput}"
                                                                Spacing="6"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Sparkles}"
                                                                    Text="AI 聚合输出"
                                                                    IconSize="12"
                                                                    TextFontSize="12"
                                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                />
                                                                <TextBlock
                                                                    Text="{Binding SelectedAuditEntry.AiSummary}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                />
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.FileText}"
                                                                    Text="Content"
                                                                    IconSize="12"
                                                                    TextFontSize="12"
                                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                />
                                                                <arc:CodeBlock
                                                                    Code="{Binding SelectedAuditEntry.AiContent}"
                                                                    Language="text"
                                                                    FileName="ai-content.md"
                                                                    IsCollapsible="True"
                                                                    MaxLines="10"
                                                                    CopyLabel="复制内容"
                                                                    ShowAllLinesFormat="展开全部 {0} 行"
                                                                    ShowFewerLinesLabel="收起"
                                                                />
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Brain}"
                                                                    Text="Thinking"
                                                                    IconSize="12"
                                                                    TextFontSize="12"
                                                                    TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                    IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                />
                                                                <arc:CodeBlock
                                                                    Code="{Binding SelectedAuditEntry.AiThinking}"
                                                                    Language="text"
                                                                    FileName="ai-thinking.txt"
                                                                    IsCollapsible="True"
                                                                    MaxLines="8"
                                                                    CopyLabel="复制思考"
                                                                    ShowAllLinesFormat="展开全部 {0} 行"
                                                                    ShowFewerLinesLabel="收起"
                                                                />
                                                            </StackPanel>
                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.Terminal}"
                                                                Text="cURL"
                                                                IconSize="12"
                                                                TextFontSize="12"
                                                                TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            />
                                                            <arc:CodeBlock
                                                                Code="{Binding SelectedAuditEntry.Curl}"
                                                                Language="bash"
                                                                FileName="request.sh"
                                                                IsCollapsible="True"
                                                                MaxLines="8"
                                                                CopyLabel="复制 cURL"
                                                            />

                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.List}"
                                                                Text="请求头"
                                                                IconSize="12"
                                                                TextFontSize="12"
                                                                TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            />
                                                            <arc:CodeBlock
                                                                Code="{Binding SelectedAuditEntry.RequestHeaders}"
                                                                Language="text"
                                                                FileName="headers.txt"
                                                                IsCollapsible="True"
                                                                MaxLines="6"
                                                                CopyLabel="复制"
                                                                ShowAllLinesFormat="展开全部 {0} 行"
                                                                ShowFewerLinesLabel="收起"
                                                            />

                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.FileText}"
                                                                Text="请求体预览"
                                                                IconSize="12"
                                                                TextFontSize="12"
                                                                TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            />
                                                            <arc:CodeBlock
                                                                Code="{Binding SelectedAuditEntry.RequestBodyPreview}"
                                                                Language="text"
                                                                FileName="request.txt"
                                                                IsCollapsible="True"
                                                                MaxLines="6"
                                                                CopyLabel="复制"
                                                                ShowAllLinesFormat="展开全部 {0} 行"
                                                                ShowFewerLinesLabel="收起"
                                                            />

                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.FileText}"
                                                                Text="响应体预览"
                                                                IconSize="12"
                                                                TextFontSize="12"
                                                                TextForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                IconForeground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            />
                                                            <arc:CodeBlock
                                                                Code="{Binding SelectedAuditEntry.ResponseBodyPreview}"
                                                                Language="text"
                                                                FileName="response.txt"
                                                                IsCollapsible="True"
                                                                MaxLines="8"
                                                                CopyLabel="复制"
                                                                ShowAllLinesFormat="展开全部 {0} 行"
                                                                ShowFewerLinesLabel="收起"
                                                            />
                                                        </StackPanel>
                                                    </arc:ScrollArea>
                                                    <arc:EmptyState
                                                        IsVisible="{Binding !HasSelectedAuditEntry}"
                                                        Title="选择一条审计记录"
                                                        Description="查看 AI 或 UI 触发的请求、状态、耗时、cURL 和请求/响应预览。"
                                                        Label="审计详情"
                                                    />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <Grid
                                        IsVisible="{Binding IsAutomationTab}"
                                        ColumnDefinitions="0.72*,1.28*"
                                        ColumnSpacing="14"
                                    >
                                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <arc:Button
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding OpenSuiteBuilderCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.ListChecks}"
                                                        Text="组装套件"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Variant="Danger"
                                                    Size="Small"
                                                    Command="{Binding DeleteSelectedSuiteCommand}"
                                                >
                                                    <controls:IconLabel
                                                        Icon="{x:Static arc:ArcIcons.Trash2}"
                                                        Text="删除套件"
                                                        IconSize="13"
                                                    />
                                                </arc:Button>
                                            </StackPanel>
                                            <Border
                                                Grid.Row="1"
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="4"
                                            >
                                                <arc:ScrollArea>
                                                    <ItemsControl ItemsSource="{Binding Suites}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:TestSuite">
                                                                <arc:Button
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Width="{Binding $parent[arc:ScrollArea].Bounds.Width}"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="0"
                                                                    Margin="0,0,0,4"
                                                                    AutomationProperties.Name="{Binding Name}"
                                                                    Click="OnSuiteRowClick"
                                                                >
                                                                    <Border
                                                                        Background="{arc:ArcDesignTokenResource Surface}"
                                                                        Width="{Binding $parent[arc:Button].Bounds.Width}"
                                                                        HorizontalAlignment="Stretch"
                                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                        Padding="10,8"
                                                                    >
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock
                                                                                Text="{Binding Name}"
                                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding Name}"
                                                                            />
                                                                            <TextBlock
                                                                                Text="{Binding LastSummary}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding LastSummary}"
                                                                            />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </arc:Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </arc:ScrollArea>
                                            </Border>
                                            <TextBlock
                                                Grid.Row="2"
                                                Text="通过「组装套件」勾选任意集合生成步骤，也可使用 MCP create_suite；运行结果会写入审计。"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                TextWrapping="Wrap"
                                            />
                                        </Grid>

                                        <Grid
                                            Grid.Column="1"
                                            RowDefinitions="Auto,Auto,*,Auto"
                                            RowSpacing="10"
                                        >
                                            <StackPanel Spacing="2">
                                                <TextBlock
                                                    Text="{Binding SelectedSuite.Name}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding SelectedSuite.Name}"
                                                />
                                                <TextBlock
                                                    Text="{Binding SelectedSuite.LastSummary}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding SelectedSuite.LastSummary}"
                                                />
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Row="1"
                                                Text="步骤与断言 / 最近结果"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                FontWeight="Medium"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            />

                                            <Grid
                                                Grid.Row="2"
                                                ColumnDefinitions="1.15*,0.85*"
                                                ColumnSpacing="12"
                                            >
                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="10"
                                                >
                                                    <arc:ScrollArea>
                                                        <ItemsControl ItemsSource="{Binding SelectedSuite.Steps}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:TestStep">
                                                                    <Border
                                                                        Background="{arc:ArcDesignTokenResource Surface}"
                                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                        Padding="8"
                                                                        Margin="0,0,0,4"
                                                                    >
                                                                        <StackPanel Spacing="2">
                                                                            <TextBlock
                                                                                Text="{Binding RequestName}"
                                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding RequestName}"
                                                                            />
                                                                            <Grid
                                                                                ColumnDefinitions="Auto,*"
                                                                                ColumnSpacing="6"
                                                                            >
                                                                                <arc:Badge
                                                                                    Content="{Binding Method}"
                                                                                    Tone="{Binding MethodTone}"
                                                                                    Size="Small"
                                                                                />
                                                                                <TextBlock
                                                                                    Grid.Column="1"
                                                                                    Text="{Binding Url}"
                                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                    VerticalAlignment="Center"
                                                                                    TextTrimming="CharacterEllipsis"
                                                                                    ToolTip.Tip="{Binding Url}"
                                                                                />
                                                                            </Grid>
                                                                            <TextBlock
                                                                                Text="{Binding ExpectationText}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                TextWrapping="Wrap"
                                                                            />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </arc:ScrollArea>
                                                </Border>

                                                <Border
                                                    Grid.Column="1"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="10"
                                                >
                                                    <Grid>
                                                        <arc:ScrollArea IsVisible="{Binding HasSelectedSuiteResult}">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock
                                                                    Text="{Binding SelectedSuiteResult.Summary}"
                                                                    FontWeight="Medium"
                                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                />
                                                                <ItemsControl ItemsSource="{Binding SelectedSuiteResult.Steps}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:TestStepResult">
                                                                            <Border
                                                                                Background="{arc:ArcDesignTokenResource Surface}"
                                                                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                                Padding="8"
                                                                                Margin="0,0,0,4"
                                                                            >
                                                                                <Grid
                                                                                    ColumnDefinitions="Auto,*,Auto"
                                                                                    RowDefinitions="Auto,Auto,Auto"
                                                                                    ColumnSpacing="8"
                                                                                    RowSpacing="2"
                                                                                >
                                                                                    <arc:Badge
                                                                                        Content="{Binding ResultLabel}"
                                                                                        Icon="{Binding ResultIcon}"
                                                                                        Tone="{Binding ResultTone}"
                                                                                        Size="Small"
                                                                                    />
                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding Name}"
                                                                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTip.Tip="{Binding Name}"
                                                                                    />
                                                                                    <StackPanel
                                                                                        Grid.Column="2"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="4"
                                                                                        VerticalAlignment="Center"
                                                                                    >
                                                                                        <TextBlock
                                                                                            Text="{Binding StatusCode}"
                                                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                        />
                                                                                        <TextBlock
                                                                                            Text="{Binding AttemptText}"
                                                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                        />
                                                                                    </StackPanel>
                                                                                    <TextBlock
                                                                                        Grid.Row="1"
                                                                                        Grid.Column="1"
                                                                                        Grid.ColumnSpan="2"
                                                                                        Text="{Binding Error}"
                                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                        Foreground="{arc:ArcDesignTokenResource Danger}"
                                                                                        TextWrapping="Wrap"
                                                                                    />
                                                                                    <ItemsControl
                                                                                        Grid.Row="2"
                                                                                        Grid.Column="1"
                                                                                        Grid.ColumnSpan="2"
                                                                                        ItemsSource="{Binding Assertions}"
                                                                                        IsVisible="{Binding HasAssertions}"
                                                                                    >
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="models:TestAssertionResult">
                                                                                                <Grid
                                                                                                    ColumnDefinitions="Auto,*"
                                                                                                    RowDefinitions="Auto,Auto"
                                                                                                    ColumnSpacing="6"
                                                                                                    Margin="0,2,0,0"
                                                                                                >
                                                                                                    <arc:Badge
                                                                                                        Content="{Binding ResultLabel}"
                                                                                                        Tone="{Binding ResultTone}"
                                                                                                        Size="Small"
                                                                                                    />
                                                                                                    <TextBlock
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding Label}"
                                                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                                        TextWrapping="Wrap"
                                                                                                    />
                                                                                                    <TextBlock
                                                                                                        Grid.Row="1"
                                                                                                        Grid.Column="1"
                                                                                                        Text="{Binding Detail}"
                                                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                                        TextWrapping="Wrap"
                                                                                                    />
                                                                                                </Grid>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </arc:ScrollArea>
                                                        <arc:EmptyState
                                                            IsVisible="{Binding !HasSelectedSuiteResult}"
                                                            Title="尚未运行"
                                                            Description="点击「运行套件」查看每个步骤的断言结果；结果同时写入审计。"
                                                            Label="套件结果"
                                                        />
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <arc:Button
                                                Grid.Row="3"
                                                Variant="Primary"
                                                HorizontalAlignment="Right"
                                                IsLoading="{Binding IsRunningSuite}"
                                                Command="{Binding RunSelectedSuiteCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Play}"
                                                    Text="运行套件"
                                                />
                                            </arc:Button>
                                        </Grid>
                                    </Grid>

                                    <Grid
                                        IsVisible="{Binding IsGuideTab}"
                                        RowDefinitions="*"
                                        Margin="0,6,0,0"
                                    >
                                        <arc:ScrollArea>
                                            <StackPanel
                                                Spacing="12"
                                                MaxWidth="1120"
                                                HorizontalAlignment="Center"
                                            >
                                                <TextBlock
                                                    Text="一分钟上手"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                />
                                                <TextBlock
                                                    Text="PostSharp 的核心链路是：AI 通过 MCP 触发请求 → 审计留痕 → 自动化套件回归。下面每一步都可以直接点开示例。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                />

                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="14"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="34,*,200"
                                                        ColumnSpacing="12"
                                                    >
                                                        <arc:Badge
                                                            Content="1"
                                                            Tone="Neutral"
                                                            Size="Small"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,0,0"
                                                        />
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                Text="发送第一个请求"
                                                                FontWeight="SemiBold"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            />
                                                            <TextBlock
                                                                Text="载入「健康检查」，按 Ctrl+Enter 发送。响应区会显示状态、耗时、大小、JSON 树和可复制响应。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="6"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                        >
                                                            <arc:Button
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="health"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Play}"
                                                                    Text="载入健康检查"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                            <arc:Button
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding ClearAuditCommand}"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Eraser}"
                                                                    Text="清空审计"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="14"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="34,*,200"
                                                        ColumnSpacing="12"
                                                    >
                                                        <arc:Badge
                                                            Content="2"
                                                            Tone="Neutral"
                                                            Size="Small"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,0,0"
                                                        />
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                Text="请求头、请求体与 cURL"
                                                                FontWeight="SemiBold"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            />
                                                            <TextBlock
                                                                Text="请求头可以一键插入 JSON 类型、Accept JSON、Bearer Token，并会提示重复头。请求体支持 JSON/XML 格式化、压缩、单行切换；cURL 标签会生成已解析环境变量的可执行命令。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="6"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                        >
                                                            <arc:Button
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding OpenEnvironmentFromGuideCommand}"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Globe}"
                                                                    Text="打开环境变量"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                            <arc:Button
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="sse"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Terminal}"
                                                                    Text="载入 SSE 示例"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="14"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="34,*,200"
                                                        ColumnSpacing="12"
                                                    >
                                                        <arc:Badge
                                                            Content="3"
                                                            Tone="Neutral"
                                                            Size="Small"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,0,0"
                                                        />
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                Text="AI 审计与自动化"
                                                                FontWeight="SemiBold"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            />
                                                            <TextBlock
                                                                Text="所有 UI 和 MCP 发送都会写入审计，记录来源、客户端、工具、状态、耗时、cURL 和请求/响应预览。自动化套件支持状态码和响应体断言，运行结果也会进入审计。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="6"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                        >
                                                            <arc:Button
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding SetManagementTabCommand}"
                                                                CommandParameter="审计"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.ListChecks}"
                                                                    Text="查看审计"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                            <arc:Button
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding SetManagementTabCommand}"
                                                                CommandParameter="自动化"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Play}"
                                                                    Text="查看自动化"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="14"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="34,*,200"
                                                        ColumnSpacing="12"
                                                    >
                                                        <arc:Badge
                                                            Content="4"
                                                            Tone="Neutral"
                                                            Size="Small"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,0,0"
                                                        />
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                Text="SSE / AI 输出聚合"
                                                                FontWeight="SemiBold"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            />
                                                            <TextBlock
                                                                Text="发送 text/event-stream 请求后，PostSharp 会把流式事件里的 thinking 和 content 自动追加聚合，在「AI 聚合」标签中完整展示，而不是只保留最后一条推送。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="6"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                        >
                                                            <arc:Button
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="sse"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Sparkles}"
                                                                    Text="载入 SSE 示例"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                            <arc:Button
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="upload"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Upload}"
                                                                    Text="载入上传示例"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="14"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="34,*,200"
                                                        ColumnSpacing="12"
                                                    >
                                                        <arc:Badge
                                                            Content="5"
                                                            Tone="Neutral"
                                                            Size="Small"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,0,0"
                                                        />
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                Text="MCP 接入"
                                                                FontWeight="SemiBold"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            />
                                                            <TextBlock
                                                                Text="把下面的地址添加到支持 Streamable HTTP 的 MCP 客户端，AI 就可以自由管理集合与请求、编排带延迟和字段映射的套件、运行回归并查看审计。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                            <Grid
                                                                ColumnDefinitions="*,Auto"
                                                                ColumnSpacing="8"
                                                                Margin="0,2,0,0"
                                                            >
                                                                <arc:Input
                                                                    IsLabelVisible="False"
                                                                    IsReadOnly="True"
                                                                    Text="{Binding McpEndpoint}"
                                                                    FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                />
                                                                <arc:CopyButton
                                                                    Grid.Column="1"
                                                                    Value="{Binding McpEndpoint}"
                                                                    Label="复制地址"
                                                                    Variant="Plain"
                                                                />
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="6"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                        >
                                                            <arc:Button
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding OpenMcpFromGuideCommand}"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.ExternalLink}"
                                                                    Text="打开 MCP 接入说明"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <Border
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    Padding="14"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="34,*,200"
                                                        ColumnSpacing="12"
                                                    >
                                                        <arc:Badge
                                                            Content="6"
                                                            Tone="Neutral"
                                                            Size="Small"
                                                            VerticalAlignment="Top"
                                                            Margin="0,2,0,0"
                                                        />
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock
                                                                Text="上传与系统设置"
                                                                FontWeight="SemiBold"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            />
                                                            <TextBlock
                                                                Text="请求体切到「表单上传」后可以选择文件并发起 multipart 请求；设置页提供主题、界面字体、代码字体/字号、超时、默认请求体、大响应阈值和审计保留条数。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            Orientation="Vertical"
                                                            Spacing="6"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                        >
                                                            <arc:Button
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Click="OnOpenSettingsClick"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Settings}"
                                                                    Text="打开设置"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                            <arc:Button
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="upload"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Upload}"
                                                                    Text="载入上传示例"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </arc:ScrollArea>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </Panel>

                <!-- Overlays -->
                <arc:Toast
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,24"
                    Width="320"
                    Duration="0:0:3"
                    Title="{Binding ToastTitle}"
                    IsOpen="{Binding IsToastOpen, Mode=TwoWay}"
                />

                <arc:Dialog
                    x:Name="ImportDialog"
                    IsOpen="{Binding Import.IsImportDialogOpen, Mode=TwoWay}"
                    Title="导入 / 导出"
                    Description="支持 OpenAPI、Postman、cURL、HAR、Insomnia、Hoppscotch；导入成功后可以继续手工调整请求。"
                    Size="Large"
                    Opened="OnImportDialogOpened"
                >
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                        <StackPanel Grid.Row="0" Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Text="导入来源"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    VerticalAlignment="Center"
                                />
                                <arc:Button
                                    Grid.Column="1"
                                    Content="{Binding Import.ImportSourceToggleLabel}"
                                    Variant="Ghost"
                                    Size="Small"
                                    Command="{Binding Import.ToggleImportSourceCommand}"
                                    AutomationProperties.Name="展开或收起导入来源"
                                />
                            </Grid>
                            <arc:RadioCards
                                SelectedValue="{Binding Import.ImportSource, Mode=TwoWay}"
                                MinColumnWidth="150"
                                IsVisible="{Binding Import.IsImportSourceExpanded}"
                                AutomationProperties.Name="导入来源"
                            >
                                <arc:RadioCardOption
                                    Value="OpenApi"
                                    Label="OpenAPI"
                                    Description="Swagger · Knife4j"
                                />
                                <arc:RadioCardOption
                                    Value="PostmanCollection"
                                    Label="Postman"
                                    Description="Collection · 文件夹 / 认证"
                                />
                                <arc:RadioCardOption
                                    Value="PostmanEnvironment"
                                    Label="Environment"
                                    Description="Postman 环境变量"
                                />
                                <arc:RadioCardOption
                                    Value="Curl"
                                    Label="cURL"
                                    Description="bash / PowerShell"
                                />
                                <arc:RadioCardOption
                                    Value="Har"
                                    Label="HAR"
                                    Description="浏览器 / Apifox"
                                />
                                <arc:RadioCardOption
                                    Value="Insomnia"
                                    Label="Insomnia"
                                    Description="V4 JSON · 请求组 / 环境"
                                />
                                <arc:RadioCardOption
                                    Value="Hoppscotch"
                                    Label="Hoppscotch"
                                    Description="Collection JSON"
                                />
                                <arc:RadioCardOption
                                    Value="OtherTools"
                                    Label="其他工具"
                                    Description="YApi / ApiPost / Eolink 指南"
                                />
                                <arc:RadioCardOption
                                    Value="Apifox"
                                    Label="Apifox"
                                    Description="Postman / OpenAPI / HAR"
                                />
                            </arc:RadioCards>
                        </StackPanel>

                        <Panel Grid.Row="1">
                            <StackPanel IsVisible="{Binding Import.IsOpenApiImport}" Spacing="12">
                                <TextBlock
                                    Text="从 URL 导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <arc:Input
                                        Label="文档 URL"
                                        Text="{Binding Import.ImportUrl, Mode=TwoWay}"
                                        Placeholder="https://petstore3.swagger.io/api/v3/openapi.json"
                                        AutomationProperties.Name="OpenAPI 文档地址"
                                    />
                                    <arc:Button
                                        Grid.Column="1"
                                        Content="下载并导入"
                                        Variant="Primary"
                                        VerticalAlignment="Bottom"
                                        Command="{Binding Import.ImportFromUrlCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="下载并导入 OpenAPI 文档"
                                    />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="填入 springdoc / Knife4j 地址"
                                        Variant="Ghost"
                                        Size="Small"
                                        Command="{Binding Import.FillSpringDocUrlCommand}"
                                        AutomationProperties.Name="填入 springdoc 或 Knife4j 地址"
                                    />
                                    <TextBlock
                                        Text="常见地址为 http://服务地址:端口/v3/api-docs"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.HasPendingOpenApiImport}"
                                    Spacing="8"
                                >
                                    <arc:Select
                                        Label="服务器"
                                        ItemsSource="{Binding Import.OpenApiServers}"
                                        SelectedItem="{Binding Import.SelectedOpenApiServer, Mode=TwoWay}"
                                        AutomationProperties.Name="OpenAPI 服务器"
                                    />
                                    <arc:Button
                                        Content="导入所选服务器"
                                        Variant="Primary"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Import.ConfirmOpenApiImportCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        AutomationProperties.Name="导入所选服务器的 OpenAPI 请求"
                                    />
                                </StackPanel>

                                <Border
                                    Height="1"
                                    Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                />

                                <TextBlock
                                    Text="从文件导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <arc:Button
                                        Content="选择 JSON / YAML 文件…"
                                        Variant="Secondary"
                                        Click="OnPickOpenApiFileClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        AutomationProperties.Name="选择 OpenAPI 文件"
                                    />
                                    <TextBlock
                                        Text="支持 .json、.yaml、.yml，也兼容 Swagger 2.0。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                IsVisible="{Binding Import.IsPostmanCollectionImport}"
                                Spacing="10"
                            >
                                <TextBlock
                                    Text="从 Postman 迁移"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="支持嵌套文件夹、查询参数、请求头、Bearer / Basic / API Key 认证、raw / urlencoded / formdata 请求体和集合变量。脚本与测试不会执行。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <TextBlock
                                    Text="Apifox 迁移：在 Apifox「项目设置 → 导出数据」选择 Postman 或 OpenAPI，再在这里导入。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="选择 Collection 文件…"
                                        Variant="Primary"
                                        Click="OnPickPostmanFileClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="选择 Postman Collection 文件"
                                    />
                                    <arc:Button
                                        Content="导出当前集合…"
                                        Variant="Secondary"
                                        Click="OnExportPostmanClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        AutomationProperties.Name="导出 Postman Collection"
                                    />
                                    <TextBlock
                                        Text="导出选中集合；未选中时导出整个工作区。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                                <arc:Textarea
                                    Height="124"
                                    Margin="0,0,0,8"
                                    Label="或者粘贴 Collection JSON"
                                    Text="{Binding Import.PostmanJson, Mode=TwoWay}"
                                    Placeholder="粘贴 Postman Collection v2.1 JSON"
                                    FrameHeight="100"
                                    IsResizable="False"
                                    AutomationProperties.Name="Postman Collection JSON"
                                />
                                <arc:Button
                                    Content="导入粘贴内容"
                                    Variant="Primary"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Import.ImportPostmanTextCommand}"
                                    IsEnabled="{Binding Import.IsNotImporting}"
                                    IsLoading="{Binding Import.IsImporting}"
                                    AutomationProperties.Name="导入粘贴的 Postman Collection"
                                />
                            </StackPanel>

                            <StackPanel
                                IsVisible="{Binding Import.IsPostmanEnvironmentImport}"
                                Spacing="10"
                            >
                                <TextBlock
                                    Text="从 Postman 环境文件导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="选择 Postman Environment JSON。变量会创建或合并到同名环境，并自动激活；重复变量保留第一个值。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <arc:Button
                                    Content="选择环境 JSON 文件…"
                                    Variant="Primary"
                                    HorizontalAlignment="Left"
                                    Click="OnPickPostmanEnvironmentFileClick"
                                    IsEnabled="{Binding Import.IsNotImporting}"
                                    IsLoading="{Binding Import.IsImporting}"
                                    AutomationProperties.Name="导入 Postman 环境文件"
                                />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Import.IsCurlImport}" Spacing="10">
                                <TextBlock
                                    Text="从 cURL 导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="支持 Postman、浏览器或 PostSharp 生成的 bash 风格命令，以及 Invoke-RestMethod / Invoke-WebRequest PowerShell 命令。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <arc:Textarea
                                    Height="124"
                                    Margin="0,0,0,8"
                                    Label="cURL 命令"
                                    Text="{Binding Import.CurlCommand, Mode=TwoWay}"
                                    Placeholder="curl -X POST 'https://api.example.com/health' -H 'Accept: application/json'"
                                    FrameHeight="100"
                                    IsResizable="False"
                                    AutomationProperties.Name="cURL 命令"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="导入 cURL"
                                        Variant="Primary"
                                        Command="{Binding Import.ImportCurlCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="导入 cURL 命令"
                                    />
                                    <arc:Button
                                        Content="保存当前请求 cURL…"
                                        Variant="Secondary"
                                        Click="OnExportCurlClick"
                                        IsEnabled="{Binding CanExportCurl}"
                                        AutomationProperties.Name="保存当前请求 cURL"
                                    />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Import.IsHarImport}" Spacing="10">
                                <TextBlock
                                    Text="从 HAR 导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="支持浏览器、Postman、Apifox 导出的 HAR 1.2。默认只导入 XHR / Fetch；响应内容、脚本和二进制文件内容不会导入。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <arc:Button
                                        Content="选择 HAR 文件…"
                                        Variant="Primary"
                                        Click="OnPickHarFileClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="选择 HAR 文件"
                                    />
                                    <arc:Checkbox
                                        IsChecked="{Binding Import.HarIncludeStaticResources, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="包含静态资源"
                                    />
                                    <TextBlock
                                        Text="包含静态资源"
                                        FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                                <arc:Textarea
                                    Height="124"
                                    Margin="0,0,0,8"
                                    Label="或者粘贴 HAR JSON"
                                    Text="{Binding Import.HarJson, Mode=TwoWay}"
                                    Placeholder="粘贴 HAR 1.2 JSON"
                                    FrameHeight="100"
                                    IsResizable="False"
                                    AutomationProperties.Name="HAR JSON"
                                />
                                <arc:Button
                                    Content="导入粘贴的 HAR"
                                    Variant="Primary"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Import.ImportHarTextCommand}"
                                    IsEnabled="{Binding Import.IsNotImporting}"
                                    IsLoading="{Binding Import.IsImporting}"
                                    AutomationProperties.Name="导入粘贴的 HAR"
                                />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Import.IsInsomniaImport}" Spacing="10">
                                <TextBlock
                                    Text="从 Insomnia V4 导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="支持 Insomnia v4 JSON 导出：请求组、请求、环境变量和常见认证。Insomnia v5 YAML 请先导出为 v4 JSON；脚本不会执行。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="选择 Insomnia JSON 文件…"
                                        Variant="Primary"
                                        Click="OnPickInsomniaFileClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="选择 Insomnia 导出文件"
                                    />
                                    <TextBlock
                                        Text="Insomnia → Collection → Export → Insomnia v4 JSON"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                                <arc:Textarea
                                    Height="124"
                                    Margin="0,0,0,8"
                                    Label="或者粘贴 Insomnia JSON"
                                    Text="{Binding Import.InsomniaJson, Mode=TwoWay}"
                                    Placeholder="粘贴 Insomnia v4 JSON"
                                    FrameHeight="100"
                                    IsResizable="False"
                                    AutomationProperties.Name="Insomnia JSON"
                                />
                                <arc:Button
                                    Content="导入粘贴的 Insomnia"
                                    Variant="Primary"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Import.ImportInsomniaTextCommand}"
                                    IsEnabled="{Binding Import.IsNotImporting}"
                                    IsLoading="{Binding Import.IsImporting}"
                                    AutomationProperties.Name="导入粘贴的 Insomnia"
                                />
                            </StackPanel>

                            <StackPanel
                                IsVisible="{Binding Import.IsHoppscotchImport}"
                                Spacing="10"
                            >
                                <TextBlock
                                    Text="从 Hoppscotch 导入"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="支持 Hoppscotch Collection JSON：文件夹、params、headers、body 和基础认证。脚本、测试和 multipart 文件内容不会执行或还原。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="选择 Hoppscotch JSON 文件…"
                                        Variant="Primary"
                                        Click="OnPickHoppscotchFileClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="选择 Hoppscotch Collection 文件"
                                    />
                                    <TextBlock
                                        Text="Hoppscotch → Collection → Export → JSON"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                    />
                                </StackPanel>
                                <arc:Textarea
                                    Height="124"
                                    Margin="0,0,0,8"
                                    Label="或者粘贴 Hoppscotch JSON"
                                    Text="{Binding Import.HoppscotchJson, Mode=TwoWay}"
                                    Placeholder="粘贴 Hoppscotch Collection JSON"
                                    FrameHeight="100"
                                    IsResizable="False"
                                    AutomationProperties.Name="Hoppscotch JSON"
                                />
                                <arc:Button
                                    Content="导入粘贴的 Hoppscotch"
                                    Variant="Primary"
                                    HorizontalAlignment="Left"
                                    Command="{Binding Import.ImportHoppscotchTextCommand}"
                                    IsEnabled="{Binding Import.IsNotImporting}"
                                    IsLoading="{Binding Import.IsImporting}"
                                    AutomationProperties.Name="导入粘贴的 Hoppscotch"
                                />
                            </StackPanel>

                            <StackPanel
                                IsVisible="{Binding Import.IsOtherToolsImport}"
                                Spacing="10"
                            >
                                <TextBlock
                                    Text="YApi / ApiPost / Eolink"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="这几个工具都支持导出 OpenAPI 或 Postman Collection。建议先在原工具导出，再切换到对应导入器，避免维护脆弱的私有格式解析。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="用 OpenAPI 导入"
                                        Variant="Primary"
                                        Command="{Binding Import.SelectImportSourceCommand}"
                                        CommandParameter="OpenApi"
                                        AutomationProperties.Name="切换到 OpenAPI 导入"
                                    />
                                    <arc:Button
                                        Content="用 Postman 导入"
                                        Variant="Secondary"
                                        Command="{Binding Import.SelectImportSourceCommand}"
                                        CommandParameter="PostmanCollection"
                                        AutomationProperties.Name="切换到 Postman Collection 导入"
                                    />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding Import.IsApifoxImport}" Spacing="10">
                                <TextBlock
                                    Text="从 Apifox 迁移"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <TextBlock
                                    Text="Apifox 原生格式暂未直接解析。推荐在 Apifox「项目设置 → 导出数据」选择 Postman 或 OpenAPI；浏览器/Apifox 的 HAR 也可以直接导入。"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    TextWrapping="Wrap"
                                />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:Button
                                        Content="用 Postman 导入"
                                        Variant="Primary"
                                        Command="{Binding Import.SelectImportSourceCommand}"
                                        CommandParameter="PostmanCollection"
                                        AutomationProperties.Name="切换到 Postman Collection 导入"
                                    />
                                    <arc:Button
                                        Content="用 OpenAPI 导入"
                                        Variant="Secondary"
                                        Command="{Binding Import.SelectImportSourceCommand}"
                                        CommandParameter="OpenApi"
                                        AutomationProperties.Name="切换到 OpenAPI 导入"
                                    />
                                    <arc:Button
                                        Content="用 HAR 导入"
                                        Variant="Secondary"
                                        Command="{Binding Import.SelectImportSourceCommand}"
                                        CommandParameter="Har"
                                        AutomationProperties.Name="切换到 HAR 导入"
                                    />
                                </StackPanel>
                            </StackPanel>
                        </Panel>

                        <Grid Grid.Row="2" MinHeight="40">
                            <TextBlock
                                IsVisible="{Binding Import.HasNoImportError}"
                                Text="{Binding Import.ImportStatus}"
                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                TextWrapping="Wrap"
                            />
                            <TextBlock
                                IsVisible="{Binding Import.HasImportError}"
                                Text="{Binding Import.ImportStatus}"
                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                Foreground="{arc:ArcDesignTokenResource Danger}"
                                TextWrapping="Wrap"
                            />
                        </Grid>

                        <Border
                            Grid.Row="3"
                            IsVisible="{Binding Import.HasImportReport}"
                            BorderBrush="{arc:ArcDesignTokenResource Success}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            Padding="12"
                        >
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Text="导入结果"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource Success}"
                                        VerticalAlignment="Center"
                                    />
                                    <arc:Button
                                        Grid.Column="1"
                                        Content="{Binding Import.ImportReportToggleLabel}"
                                        Variant="Ghost"
                                        Size="Small"
                                        Command="{Binding Import.ToggleImportReportCommand}"
                                        AutomationProperties.Name="展开或收起导入结果"
                                    />
                                </Grid>
                                <arc:ScrollArea
                                    Height="80"
                                    IsVisible="{Binding Import.IsImportReportExpanded}"
                                >
                                    <ItemsControl ItemsSource="{Binding Import.ImportReport}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{Binding}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,4"
                                                />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:ScrollArea>
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="4"
                            IsVisible="{Binding Import.HasImportWarnings}"
                            BorderBrush="{arc:ArcDesignTokenResource Warning}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            Padding="12"
                        >
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Text="兼容性提示"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource Warning}"
                                        VerticalAlignment="Center"
                                    />
                                    <arc:Button
                                        Grid.Column="1"
                                        Content="{Binding Import.ImportWarningsToggleLabel}"
                                        Variant="Ghost"
                                        Size="Small"
                                        Command="{Binding Import.ToggleImportWarningsCommand}"
                                        AutomationProperties.Name="展开或收起兼容性提示"
                                    />
                                </Grid>
                                <arc:ScrollArea
                                    Height="80"
                                    IsVisible="{Binding Import.IsImportWarningsExpanded}"
                                >
                                    <ItemsControl ItemsSource="{Binding Import.ImportWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Text="{Binding}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    TextWrapping="Wrap"
                                                    Margin="0,0,0,4"
                                                />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:ScrollArea>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <arc:Dialog.Actions>
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                            >
                                <arc:Button
                                    Content="批量导入文件…"
                                    Variant="Secondary"
                                    Click="OnPickBatchImportFilesClick"
                                    IsEnabled="{Binding Import.IsNotImporting}"
                                    AutomationProperties.Name="批量导入文件"
                                />
                                <TextBlock
                                    Text="可多选，自动识别格式"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                    VerticalAlignment="Center"
                                />
                            </StackPanel>
                            <arc:Button
                                Grid.Column="1"
                                Content="关闭"
                                Variant="Secondary"
                                Command="{Binding Import.CloseImportDialogCommand}"
                                HorizontalAlignment="Right"
                            />
                        </Grid>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    x:Name="EnvironmentDialog"
                    IsOpen="{Binding IsEnvironmentDialogOpen, Mode=TwoWay}"
                    Title="环境变量"
                    Description="在地址、请求头或请求体中使用 {{变量名}}，发送时会替换为当前环境的值。"
                    Size="Large"
                >
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <arc:Select
                                Grid.Column="0"
                                Label="当前环境"
                                ItemsSource="{Binding Environments}"
                                SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}"
                            />
                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom"
                            >
                                <arc:Button
                                    Content="新建环境"
                                    Variant="Secondary"
                                    Size="Small"
                                    Command="{Binding AddEnvironmentCommand}"
                                />
                                <arc:Button
                                    Content="删除环境"
                                    Variant="Danger"
                                    Size="Small"
                                    Command="{Binding RemoveEnvironmentCommand}"
                                />
                            </StackPanel>
                        </Grid>

                        <arc:Input
                            Grid.Row="1"
                            Label="环境名称"
                            Text="{Binding ActiveEnvironment.Name, Mode=TwoWay}"
                        />

                        <TextBlock
                            Grid.Row="2"
                            Text="变量"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            FontWeight="Medium"
                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                        />

                        <arc:ScrollArea Grid.Row="3" Height="220">
                            <ItemsControl
                                ItemsSource="{Binding ActiveEnvironment.Variables}"
                                ItemTemplate="{StaticResource KeyValueRowTemplate}"
                            />
                        </arc:ScrollArea>

                        <TextBlock
                            Grid.Row="4"
                            Text="填写最后一行会自动新增一行；未启用的变量不会参与替换。"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                        />
                    </Grid>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelEnvironmentDialogCommand}"
                            />
                            <arc:Button
                                Content="保存环境"
                                Variant="Primary"
                                Command="{Binding CloseEnvironmentDialogCommand}"
                            />
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsRenameDialogOpen, Mode=TwoWay}"
                    Title="{Binding RenameDialogTitle}"
                    Size="Small"
                >
                    <arc:Input
                        Label="名称"
                        Text="{Binding RenameText, Mode=TwoWay}"
                        AutomationProperties.Name="名称"
                    />
                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelRenameCommand}"
                            />
                            <arc:Button
                                Content="保存名称"
                                Variant="Primary"
                                Command="{Binding ApplyRenameCommand}"
                            />
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsDeleteDialogOpen, Mode=TwoWay}"
                    Title="{Binding DeleteDialogTitle}"
                    Description="{Binding DeleteDialogDescription}"
                    Size="Small"
                >
                    <TextBlock
                        Text="Ctrl+Enter 确认，Esc 取消"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelDeleteCommand}"
                            />
                            <arc:Button
                                Content="删除"
                                Variant="Danger"
                                Command="{Binding ConfirmDeleteCommand}"
                            />
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsHistoryTrashConfirmOpen, Mode=TwoWay}"
                    Title="{Binding HistoryTrashConfirmTitle}"
                    Description="{Binding HistoryTrashConfirmDescription}"
                    Size="Small"
                >
                    <TextBlock
                        Text="Ctrl+Enter 确认，Esc 取消"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelHistoryTrashCommand}"
                            />
                            <arc:Button
                                Variant="Danger"
                                Command="{Binding ConfirmHistoryTrashCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Archive}"
                                    Text="移入回收站"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsHistoryTrashOpen, Mode=TwoWay}"
                    Title="历史记录回收站"
                    Description="删除的历史记录会先进入这里；恢复后回到历史列表，永久删除后无法恢复。"
                    Size="Large"
                >
                    <Grid MinHeight="260">
                        <arc:ScrollArea MaxHeight="360">
                            <ItemsControl ItemsSource="{Binding RecycledHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryEntry">
                                        <Border
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                            Padding="8"
                                            Margin="0,0,0,4"
                                        >
                                            <Grid
                                                ColumnDefinitions="56,*,54,56,170"
                                                RowDefinitions="Auto,Auto"
                                                ColumnSpacing="6"
                                                RowSpacing="2"
                                            >
                                                <arc:Badge
                                                    Grid.RowSpan="2"
                                                    Content="{Binding Method}"
                                                    Tone="{Binding MethodTone}"
                                                    Size="Small"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding Name}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Name}"
                                                />
                                                <arc:Badge
                                                    Grid.Column="2"
                                                    Content="{Binding StatusLabel}"
                                                    Icon="{Binding StatusIcon}"
                                                    Tone="{Binding StatusTone}"
                                                    Size="Small"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding StatusLabel}"
                                                />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding DisplayTime}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding TimestampText}"
                                                />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="3"
                                                    Text="{Binding Url}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Url}"
                                                    Margin="0,0,8,0"
                                                />
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Right"
                                                >
                                                    <arc:Button
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Command="{Binding RestoreCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.RotateCcw}"
                                                            Text="恢复"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Danger"
                                                        Size="Small"
                                                        Command="{Binding PurgeCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                                            Text="永久删除"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </arc:ScrollArea>
                        <arc:EmptyState
                            IsVisible="{Binding !HasRecycledHistory}"
                            Title="回收站为空"
                            Description="删除历史记录后，会先出现在这里。"
                            Label="回收站"
                        />
                    </Grid>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Variant="Danger"
                                IsVisible="{Binding HasRecycledHistory}"
                                Command="{Binding EmptyHistoryTrashCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                    Text="清空回收站"
                                />
                            </arc:Button>
                            <arc:Button
                                Variant="Primary"
                                Command="{Binding CloseHistoryTrashCommand}"
                            >
                                <controls:IconLabel Icon="{x:Static arc:ArcIcons.X}" Text="关闭" />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsHistoryPurgeConfirmOpen, Mode=TwoWay}"
                    Title="{Binding HistoryPurgeTitle}"
                    Description="{Binding HistoryPurgeDescription}"
                    Size="Small"
                >
                    <TextBlock
                        Text="Ctrl+Enter 确认，Esc 取消"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelHistoryPurgeCommand}"
                            />
                            <arc:Button
                                Variant="Danger"
                                Command="{Binding ConfirmHistoryPurgeCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                    Text="永久删除"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsAuditTrashConfirmOpen, Mode=TwoWay}"
                    Title="{Binding AuditTrashConfirmTitle}"
                    Description="{Binding AuditTrashConfirmDescription}"
                    Size="Small"
                >
                    <TextBlock
                        Text="Ctrl+Enter 确认，Esc 取消"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelAuditTrashCommand}"
                            />
                            <arc:Button
                                Variant="Danger"
                                Command="{Binding ConfirmAuditTrashCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Archive}"
                                    Text="移入回收站"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsAuditTrashOpen, Mode=TwoWay}"
                    Title="审计回收站"
                    Description="清空的审计记录会先进入这里；恢复后回到审计列表，永久删除后无法恢复。"
                    Size="Large"
                >
                    <Grid MinHeight="260">
                        <arc:ScrollArea MaxHeight="360">
                            <ItemsControl ItemsSource="{Binding AuditTrash}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AuditEntry">
                                        <Border
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                            Padding="8"
                                            Margin="0,0,0,4"
                                        >
                                            <Grid
                                                ColumnDefinitions="88,*,54,56,160"
                                                RowDefinitions="Auto,Auto"
                                                ColumnSpacing="6"
                                                RowSpacing="2"
                                            >
                                                <arc:Badge
                                                    Grid.RowSpan="2"
                                                    Content="{Binding SourceLabel}"
                                                    Icon="{Binding SourceIcon}"
                                                    Tone="{Binding SourceTone}"
                                                    Size="Small"
                                                    Width="88"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding SourceTooltip}"
                                                />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding RequestName}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding RequestName}"
                                                />
                                                <arc:Badge
                                                    Grid.Column="2"
                                                    Content="{Binding StatusShortLabel}"
                                                    Icon="{Binding StatusIcon}"
                                                    Tone="{Binding StatusTone}"
                                                    Size="Small"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding StatusLabel}"
                                                />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    Text="{Binding TimeText}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding TimeTooltip}"
                                                />
                                                <Grid
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Grid.ColumnSpan="3"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="6"
                                                >
                                                    <arc:Badge
                                                        Content="{Binding Method}"
                                                        Tone="{Binding MethodTone}"
                                                        Size="Small"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Url}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding Url}"
                                                    />
                                                </Grid>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Right"
                                                >
                                                    <arc:Button
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Command="{Binding RestoreCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.RotateCcw}"
                                                            Text="恢复"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Danger"
                                                        Size="Small"
                                                        Command="{Binding PurgeCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                                            Text="永久删除"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </arc:ScrollArea>
                        <arc:EmptyState
                            IsVisible="{Binding !HasAuditTrash}"
                            Title="审计回收站为空"
                            Description="清空审计记录后，会先出现在这里。"
                            Label="审计回收站"
                        />
                    </Grid>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Variant="Danger"
                                IsVisible="{Binding HasAuditTrash}"
                                Command="{Binding EmptyAuditTrashCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                    Text="清空回收站"
                                />
                            </arc:Button>
                            <arc:Button
                                Content="关闭"
                                Variant="Primary"
                                Command="{Binding CloseAuditTrashCommand}"
                            />
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    IsOpen="{Binding IsAuditPurgeConfirmOpen, Mode=TwoWay}"
                    Title="{Binding AuditPurgeTitle}"
                    Description="{Binding AuditPurgeDescription}"
                    Size="Small"
                >
                    <TextBlock
                        Text="Ctrl+Enter 确认，Esc 取消"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelAuditPurgeCommand}"
                            />
                            <arc:Button
                                Variant="Danger"
                                Command="{Binding ConfirmAuditPurgeCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                    Text="永久删除"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    x:Name="SuiteBuilderDialog"
                    IsOpen="{Binding IsSuiteBuilderOpen, Mode=TwoWay}"
                    Title="组装自动化套件"
                    Description="勾选任意集合，把集合中的请求组装成一个可运行的自动化套件；子集合可以单独选择。"
                    Size="Large"
                    Opened="OnSuiteBuilderDialogOpened"
                >
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="1.2*,1.2*,Auto,Auto" ColumnSpacing="12">
                            <arc:Input
                                Label="套件名称"
                                Text="{Binding SuiteBuilderName, Mode=TwoWay}"
                                AutomationProperties.Name="套件名称"
                            />
                            <arc:Input
                                Grid.Column="1"
                                Label="定时（分钟，0 = 关闭）"
                                Text="{Binding SuiteScheduleMinutesText, Mode=TwoWay}"
                                AutomationProperties.Name="套件定时分钟数"
                            />
                            <arc:Switch
                                Grid.Column="2"
                                Content="失败继续"
                                IsChecked="{Binding SuiteStopOnError, Mode=TwoWay}"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="失败继续执行"
                            />
                            <arc:Switch
                                Grid.Column="3"
                                Content="并行执行"
                                IsChecked="{Binding SuiteRunInParallel, Mode=TwoWay}"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="并行执行套件"
                            />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="0.72*,1.28*" ColumnSpacing="12">
                            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                                <TextBlock
                                    Text="来源集合"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <Border
                                    Grid.Row="1"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="4"
                                >
                                    <arc:ScrollArea MaxHeight="500">
                                        <ItemsControl ItemsSource="{Binding SuiteSources}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SuiteSourceCollection">
                                                    <Border
                                                        Background="{arc:ArcDesignTokenResource Surface}"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                        Padding="10,8"
                                                        Margin="0,0,0,4"
                                                    >
                                                        <Grid
                                                            ColumnDefinitions="Auto,*,Auto"
                                                            ColumnSpacing="10"
                                                            Margin="{Binding Indent}"
                                                        >
                                                            <arc:Checkbox
                                                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                VerticalAlignment="Center"
                                                                AutomationProperties.Name="{Binding Name}"
                                                            />
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock
                                                                    Text="{Binding Name}"
                                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                    TextTrimming="CharacterEllipsis"
                                                                />
                                                                <TextBlock
                                                                    Text="{Binding RequestCountLabel}"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                />
                                                            </StackPanel>
                                                            <arc:Badge
                                                                Grid.Column="2"
                                                                Content="集合"
                                                                Tone="Neutral"
                                                                Size="Small"
                                                            />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6">
                                <TextBlock
                                    Text="步骤、延迟与映射"
                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                    FontWeight="Medium"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                />
                                <Border
                                    Grid.Row="1"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="4"
                                >
                                    <arc:ScrollArea MaxHeight="500">
                                        <ItemsControl ItemsSource="{Binding SuiteBuilderSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SuiteBuilderStep">
                                                    <Border
                                                        Background="{arc:ArcDesignTokenResource Surface}"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                        Padding="8"
                                                        Margin="0,0,0,4"
                                                    >
                                                        <Grid
                                                            ColumnDefinitions="*,Auto,Auto"
                                                            RowDefinitions="Auto,Auto,Auto"
                                                            ColumnSpacing="6"
                                                            RowSpacing="4"
                                                        >
                                                            <TextBlock
                                                                Text="{Binding RequestName}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                            <arc:Badge
                                                                Grid.Column="1"
                                                                Content="{Binding Method}"
                                                                Tone="{Binding MethodTone}"
                                                                Size="Small"
                                                            />
                                                            <TextBlock
                                                                Grid.Row="1"
                                                                Text="{Binding Url}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                TextTrimming="CharacterEllipsis"
                                                            />
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="3"
                                                                VerticalAlignment="Center"
                                                            >
                                                                <TextBlock
                                                                    Text="延迟"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                />
                                                                <arc:Input
                                                                    Text="{Binding DelayText, Mode=TwoWay}"
                                                                    IsLabelVisible="False"
                                                                    Size="Small"
                                                                    Width="64"
                                                                    AutomationProperties.Name="下一请求延迟（毫秒）"
                                                                />
                                                                <TextBlock
                                                                    Text="ms"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                />
                                                                <TextBlock
                                                                    Text="重试"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="6,0,0,0"
                                                                />
                                                                <arc:Input
                                                                    Text="{Binding RetryCountText, Mode=TwoWay}"
                                                                    IsLabelVisible="False"
                                                                    Size="Small"
                                                                    Width="48"
                                                                    AutomationProperties.Name="失败重试次数"
                                                                />
                                                                <TextBlock
                                                                    Text="次 · 间隔"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                />
                                                                <arc:Input
                                                                    Text="{Binding RetryDelayText, Mode=TwoWay}"
                                                                    IsLabelVisible="False"
                                                                    Size="Small"
                                                                    Width="64"
                                                                    AutomationProperties.Name="重试间隔（毫秒）"
                                                                />
                                                                <TextBlock
                                                                    Text="ms"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="2"
                                                                Grid.ColumnSpan="2"
                                                                Orientation="Horizontal"
                                                                Spacing="6"
                                                                VerticalAlignment="Center"
                                                            >
                                                                <TextBlock
                                                                    Text="条件"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                />
                                                                <arc:Select
                                                                    ItemsSource="{Binding ConditionOptions}"
                                                                    SelectedItem="{Binding Condition, Mode=TwoWay}"
                                                                    Width="150"
                                                                    AutomationProperties.Name="步骤执行条件"
                                                                />
                                                                <TextBlock
                                                                    Text="并行组"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                    VerticalAlignment="Center"
                                                                    Margin="6,0,0,0"
                                                                />
                                                                <arc:Input
                                                                    Text="{Binding ParallelGroupText, Mode=TwoWay}"
                                                                    IsLabelVisible="False"
                                                                    Size="Small"
                                                                    Width="48"
                                                                    AutomationProperties.Name="步骤并行组"
                                                                />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.RowSpan="3"
                                                                Grid.Column="2"
                                                                Spacing="3"
                                                            >
                                                                <arc:Button
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Command="{Binding EditMappingsCommand}"
                                                                >
                                                                    <controls:IconLabel
                                                                        Icon="{x:Static arc:ArcIcons.Link2}"
                                                                        Text="{Binding MappingLabel}"
                                                                        IconSize="13"
                                                                    />
                                                                </arc:Button>
                                                                <arc:Button
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    Command="{Binding EditAssertionsCommand}"
                                                                >
                                                                    <controls:IconLabel
                                                                        Icon="{x:Static arc:ArcIcons.Check}"
                                                                        Text="{Binding AssertionLabel}"
                                                                        IconSize="13"
                                                                    />
                                                                </arc:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock
                            Grid.Row="2"
                            Text="步骤顺序沿用集合/请求排序；延迟是当前步骤结束后到下一请求的等待时间；条件按上一步结果跳过步骤；并行组相同的相邻步骤可并行执行（忽略延迟和映射）；定时单位为分钟，0 表示关闭。"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            TextWrapping="Wrap"
                        />
                    </Grid>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelSuiteBuilderCommand}"
                            />
                            <arc:Button
                                Variant="Primary"
                                Command="{Binding CreateSuiteFromSourcesCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Play}"
                                    Text="创建套件"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    x:Name="MappingDialog"
                    IsOpen="{Binding IsMappingEditorOpen, Mode=TwoWay}"
                    Title="{Binding MappingTitle}"
                    Description="把前序步骤响应中的字段映射到当前请求的请求体、请求头、查询参数或 URL 占位符。"
                    Size="Large"
                    Opened="OnMappingDialogOpened"
                >
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <arc:Button
                            Variant="Secondary"
                            Size="Small"
                            HorizontalAlignment="Left"
                            Command="{Binding AddMappingRuleCommand}"
                        >
                            <controls:IconLabel
                                Icon="{x:Static arc:ArcIcons.Plus}"
                                Text="添加映射"
                                IconSize="13"
                            />
                        </arc:Button>
                        <arc:ScrollArea Grid.Row="1" MaxHeight="520">
                            <ItemsControl ItemsSource="{Binding MappingEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:InputMappingEditor">
                                        <Border
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                        >
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Grid
                                                    ColumnDefinitions="1.25*,1.1*,0.8*,1.1*,0.9*,Auto"
                                                    ColumnSpacing="8"
                                                >
                                                    <arc:Select
                                                        Label="来源步骤"
                                                        Placeholder="选择来源步骤"
                                                        ItemsSource="{Binding SourceOptions}"
                                                        SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                                                        AutomationProperties.Name="来源步骤"
                                                    />
                                                    <arc:Input
                                                        Grid.Column="1"
                                                        Label="来源字段"
                                                        Text="{Binding SourcePath, Mode=TwoWay}"
                                                        Placeholder="data.token 或 items[0].id"
                                                        AutomationProperties.Name="来源字段"
                                                    />
                                                    <arc:Select
                                                        Grid.Column="2"
                                                        Label="目标类型"
                                                        SelectedValue="{Binding TargetKind, Mode=TwoWay}"
                                                        AutomationProperties.Name="目标类型"
                                                    >
                                                        <arc:SelectItem
                                                            Content="请求体"
                                                            Value="Body"
                                                        />
                                                        <arc:SelectItem
                                                            Content="请求头"
                                                            Value="Header"
                                                        />
                                                        <arc:SelectItem
                                                            Content="查询参数"
                                                            Value="Query"
                                                        />
                                                        <arc:SelectItem
                                                            Content="URL 路径"
                                                            Value="Path"
                                                        />
                                                    </arc:Select>
                                                    <arc:Input
                                                        Grid.Column="3"
                                                        Label="目标字段"
                                                        Text="{Binding TargetPath, Mode=TwoWay}"
                                                        Placeholder="data.userId / Authorization / id"
                                                        AutomationProperties.Name="目标字段"
                                                    />
                                                    <arc:Input
                                                        Grid.Column="4"
                                                        Label="值模板"
                                                        Text="{Binding Template, Mode=TwoWay}"
                                                        Placeholder="{}{value}"
                                                        AutomationProperties.Name="值模板"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="5"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Margin="0,0,0,2"
                                                        VerticalAlignment="Bottom"
                                                        Command="{Binding RemoveCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                                            Text="删除"
                                                            IconSize="13"
                                                            TextForeground="{arc:ArcDesignTokenResource Danger}"
                                                            IconForeground="{arc:ArcDesignTokenResource Danger}"
                                                        />
                                                    </arc:Button>
                                                </Grid>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="{Binding Error}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource Danger}"
                                                    TextWrapping="Wrap"
                                                />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </arc:ScrollArea>
                        <TextBlock
                            Grid.Row="2"
                            Text="来源字段支持点路径和数组索引；目标类型为请求体时支持 data.token 这类嵌套路径。值模板中的 {value} 会替换为来源值，例如 Bearer {value}。"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            TextWrapping="Wrap"
                        />
                    </Grid>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelMappingEditorCommand}"
                            />
                            <arc:Button
                                Variant="Primary"
                                Command="{Binding SaveMappingEditorCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Check}"
                                    Text="保存映射"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    x:Name="AssertionDialog"
                    IsOpen="{Binding IsAssertionEditorOpen, Mode=TwoWay}"
                    Title="{Binding AssertionTitle}"
                    Description="对当前步骤的响应增加 JSONPath 或响应头断言；任一断言失败则该步骤失败。"
                    Size="Large"
                    Opened="OnAssertionDialogOpened"
                >
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                        <arc:Button
                            Variant="Secondary"
                            Size="Small"
                            HorizontalAlignment="Left"
                            Command="{Binding AddAssertionRuleCommand}"
                        >
                            <controls:IconLabel
                                Icon="{x:Static arc:ArcIcons.Plus}"
                                Text="添加断言"
                                IconSize="13"
                            />
                        </arc:Button>
                        <arc:ScrollArea Grid.Row="1" MaxHeight="520">
                            <ItemsControl ItemsSource="{Binding AssertionEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:AssertionEditor">
                                        <Border
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                        >
                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <Grid
                                                    ColumnDefinitions="0.8*,1.4*,1.4*,Auto"
                                                    ColumnSpacing="8"
                                                >
                                                    <arc:Select
                                                        Label="类型"
                                                        SelectedValue="{Binding Kind, Mode=TwoWay}"
                                                        AutomationProperties.Name="断言类型"
                                                    >
                                                        <arc:SelectItem
                                                            Content="JSONPath"
                                                            Value="JSONPath"
                                                        />
                                                        <arc:SelectItem
                                                            Content="响应头"
                                                            Value="Header"
                                                        />
                                                    </arc:Select>
                                                    <arc:Input
                                                        Grid.Column="1"
                                                        Label="字段 / 路径"
                                                        Text="{Binding Path, Mode=TwoWay}"
                                                        Placeholder="$.data.token / Authorization"
                                                        AutomationProperties.Name="断言字段或路径"
                                                    />
                                                    <arc:Input
                                                        Grid.Column="2"
                                                        Label="期望值"
                                                        Text="{Binding Expected, Mode=TwoWay}"
                                                        Placeholder="200 / Bearer xxx / 成功"
                                                        AutomationProperties.Name="断言期望值"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="3"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Margin="0,0,0,2"
                                                        VerticalAlignment="Bottom"
                                                        Command="{Binding RemoveCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                                            Text="删除"
                                                            IconSize="13"
                                                            TextForeground="{arc:ArcDesignTokenResource Danger}"
                                                            IconForeground="{arc:ArcDesignTokenResource Danger}"
                                                        />
                                                    </arc:Button>
                                                </Grid>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="{Binding Error}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource Danger}"
                                                    TextWrapping="Wrap"
                                                />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </arc:ScrollArea>
                        <TextBlock
                            Grid.Row="2"
                            Text="JSONPath 支持 $.data.token、items[0].id；响应头按名称匹配，值不区分大小写。"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            TextWrapping="Wrap"
                        />
                    </Grid>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelAssertionEditorCommand}"
                            />
                            <arc:Button
                                Variant="Primary"
                                Command="{Binding SaveAssertionEditorCommand}"
                            >
                                <controls:IconLabel
                                    Icon="{x:Static arc:ArcIcons.Check}"
                                    Text="保存断言"
                                />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>

                <arc:Dialog
                    x:Name="McpDialog"
                    IsOpen="{Binding IsMcpDialogOpen, Mode=TwoWay}"
                    Title="MCP 接入"
                    Description="把 PostSharp 作为本地 MCP 服务器，让 AI 自由整理集合与请求、设计自动化套件并执行回归。"
                    Size="Large"
                >
                    <StackPanel Spacing="12">
                        <arc:Input
                            Label="MCP 端点"
                            Text="{Binding McpEndpoint}"
                            IsReadOnly="True"
                            FontFamily="{DynamicResource PostSharpCodeFont}"
                        />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <arc:CopyButton
                                Value="{Binding McpEndpoint}"
                                Label="复制 MCP 地址"
                                Variant="Plain"
                            />
                            <TextBlock
                                Grid.Column="1"
                                Text="支持 Streamable HTTP 的 MCP 客户端（Cursor、Claude Code、Cline 等）可直接添加。"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                            />
                        </Grid>

                        <TextBlock
                            Text="已开放工具"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            FontWeight="Medium"
                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                        />
                        <TextBlock
                            Text="{Binding McpToolSummary}"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            TextWrapping="Wrap"
                        />

                        <arc:CodeBlock
                            Code="{Binding McpClientConfig}"
                            Language="json"
                            FileName="mcp.json"
                            IsCollapsible="False"
                            CopyLabel="复制客户端配置"
                        />

                        <TextBlock
                            Text="MCP 发送请求同样会写入历史记录；套件支持步骤延迟、上一步响应字段映射、状态码和响应文本断言，AI 可创建后反复 update_suite / run_suite 迭代。"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>

                    <arc:Dialog.Actions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Right"
                        >
                            <arc:Button
                                Variant="Secondary"
                                Command="{Binding CloseMcpDialogCommand}"
                            >
                                <controls:IconLabel Icon="{x:Static arc:ArcIcons.X}" Text="关闭" />
                            </arc:Button>
                        </StackPanel>
                    </arc:Dialog.Actions>
                </arc:Dialog>
            </Panel>
        </VisualLayerManager>
    </Panel>
</Window>
