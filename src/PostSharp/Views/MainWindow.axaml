<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:controls="using:PostSharp.Controls"
    xmlns:models="using:PostSharp.Models"
    xmlns:vm="using:PostSharp.ViewModels"
    xmlns:views="using:PostSharp.Views"
    x:Class="PostSharp.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="PostSharp · 轻量接口调试"
    Width="1400"
    Height="900"
    MinWidth="1000"
    MinHeight="660"
    WindowStartupLocation="CenterScreen"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    WindowDecorations="BorderOnly"
    Background="{arc:ArcDesignTokenResource Background}"
>
    <Window.Resources>
        <DataTemplate x:Key="KeyValueRowTemplate" x:DataType="models:KeyValueRow">
            <Grid ColumnDefinitions="44,*,*,34" Margin="0,0,0,6">
                <arc:Checkbox
                    Grid.Column="0"
                    IsChecked="{Binding IsEnabled}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="0,-2,0,2"
                    AutomationProperties.Name="启用该行"
                />
                <arc:Input
                    Grid.Column="1"
                    Text="{Binding Key}"
                    Placeholder="键"
                    IsLabelVisible="False"
                    Size="Small"
                    Margin="0,0,8,0"
                />
                <arc:Input
                    Grid.Column="2"
                    Text="{Binding Value}"
                    Placeholder="值"
                    IsLabelVisible="False"
                    Size="Small"
                    Margin="0,0,8,0"
                />
                <arc:Button
                    Grid.Column="3"
                    Content="×"
                    Variant="Ghost"
                    Size="Small"
                    Padding="0"
                    Width="34"
                    Command="{Binding RemoveCommand}"
                    AutomationProperties.Name="删除该行"
                />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResponseHeaderTemplate" x:DataType="models:ResponseHeaderView">
            <Grid ColumnDefinitions="210,*" Margin="0,0,0,8">
                <TextBlock
                    Text="{Binding Key}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    TextWrapping="Wrap"
                />
                <SelectableTextBlock
                    Grid.Column="1"
                    Text="{Binding Value}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    FontFamily="{DynamicResource PostSharpCodeFont}"
                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                    TextWrapping="Wrap"
                />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="Border.treeRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        </Style>
        <Style Selector="Border.treeRow:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.treeRow.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.treeRow.selected:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.treeRow:focus">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.treeRow.dropTarget">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.treeRow.dropBefore">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.treeRow.dropAfter">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>
        <Style Selector=".rowActions" x:SetterTargetType="Button">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.treeRow:pointerover .rowActions" x:SetterTargetType="Button">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.treeRow.selected .rowActions" x:SetterTargetType="Button">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Panel#RootPanel.compact Border#TitleBar">
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Panel#RootPanel.compact Border#TitleBar Image">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="Panel#RootPanel.compact Grid#EditorResponseLayout">
            <Setter Property="Margin" Value="10,8,12,12" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddRequestCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FormatBodyCommand}" />
    </Window.KeyBindings>

    <Panel x:Name="RootPanel">
        <VisualLayerManager EnableOverlayLayer="True">
            <LayoutTransformControl x:Name="ScaleHost">
                <Panel>
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- Product bar -->
                        <Border
                            x:Name="TitleBar"
                            Grid.Row="0"
                            Background="{arc:ArcDesignTokenResource Surface}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10"
                            PointerPressed="OnTitleBarPointerPressed"
                        >
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center"
                                >
                                    <Image
                                        Width="42"
                                        Height="42"
                                        Source="avares://PostSharp/Assets/logo.png"
                                        Stretch="Uniform"
                                        RenderOptions.BitmapInterpolationMode="HighQuality"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock
                                        Text="PostSharp"
                                        FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                        FontWeight="SemiBold"
                                        Foreground="{arc:ArcDesignTokenResource Foreground}"
                                        VerticalAlignment="Center"
                                    />
                                    <TextBlock
                                        Text="轻量接口调试"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                >
                                    <arc:Select
                                        Width="158"
                                        ItemsSource="{Binding Environments}"
                                        SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}"
                                        Placeholder="选择环境"
                                        AutomationProperties.Name="当前环境"
                                    />
                                    <arc:Button
                                        Variant="Secondary"
                                        Command="{Binding OpenEnvironmentDialogCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Globe}"
                                            Text="环境变量"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        Width="38"
                                        Padding="0"
                                        Command="{Binding OpenCookieDialogCommand}"
                                        ToolTip.Tip="Cookie 管理"
                                        AutomationProperties.Name="Cookie 管理"
                                    >
                                        <arc:ArcGlyph
                                            Data="{x:Static arc:ArcIcons.Cookie}"
                                            Size="15"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        Command="{Binding OpenMcpFromGuideCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Terminal}"
                                            Text="MCP 接入"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        Command="{Binding OpenManagementCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.SlidersHorizontal}"
                                            Text="管理层"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Secondary"
                                        Click="OnOpenSettingsClick"
                                        AutomationProperties.Name="打开设置"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Settings}"
                                            Text="设置"
                                        />
                                    </arc:Button>
                                    <Border
                                        Width="1"
                                        Height="22"
                                        Margin="6,0,2,0"
                                        Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                    />
                                    <arc:Button
                                        Classes="windowControl"
                                        Variant="Ghost"
                                        Size="Small"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Click="OnMinimizeWindowClick"
                                        ToolTip.Tip="最小化"
                                        AutomationProperties.Name="最小化"
                                    >
                                        <arc:ArcGlyph
                                            Data="{x:Static arc:ArcIcons.Minus}"
                                            Size="15"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        x:Name="WindowMaximizeButton"
                                        Classes="windowControl"
                                        Variant="Ghost"
                                        Size="Small"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Click="OnToggleMaximizeWindowClick"
                                        ToolTip.Tip="最大化 / 还原"
                                        AutomationProperties.Name="最大化或还原"
                                    >
                                        <Panel>
                                            <arc:ArcGlyph
                                                x:Name="WindowMaximizeGlyph"
                                                Data="{x:Static arc:ArcIcons.Square}"
                                                Size="14"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            />
                                            <arc:ArcGlyph
                                                x:Name="WindowRestoreGlyph"
                                                Data="{x:Static arc:ArcIcons.Minimize2}"
                                                Size="14"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                IsVisible="False"
                                            />
                                        </Panel>
                                    </arc:Button>
                                    <arc:Button
                                        Classes="windowClose"
                                        Variant="Ghost"
                                        Size="Small"
                                        Width="34"
                                        Height="32"
                                        Padding="0"
                                        Click="OnCloseWindowClick"
                                        ToolTip.Tip="关闭"
                                        AutomationProperties.Name="关闭"
                                    >
                                        <arc:ArcGlyph
                                            Data="{x:Static arc:ArcIcons.X}"
                                            Size="15"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        />
                                    </arc:Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <views:DataNoticeBar Grid.Row="1" DataContext="{Binding DataNotice}" />

                        <Grid Grid.Row="2" x:Name="WorkspaceLayout">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" MinWidth="240" MaxWidth="520" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" MinWidth="420" />
                            </Grid.ColumnDefinitions>

                            <!-- Left workspace -->
                            <Border
                                Grid.Column="0"
                                Background="{arc:ArcDesignTokenResource Surface}"
                            >
                                <Grid
                                    x:Name="SidebarLayout"
                                    Margin="12"
                                    RowDefinitions="Auto,Auto,*,Auto,Auto"
                                >
                                    <Grid
                                        Grid.Row="0"
                                        ColumnDefinitions="Auto,Auto,*,Auto"
                                        ColumnSpacing="6"
                                    >
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            Padding="8,0"
                                            HorizontalAlignment="Left"
                                            Command="{Binding AddCollectionCommand}"
                                            ToolTip.Tip="新建集合"
                                            AutomationProperties.Name="新建集合"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Folder}"
                                                Text="新建集合"
                                                IconSize="14"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Grid.Column="1"
                                            Variant="Ghost"
                                            Size="Small"
                                            Padding="8,0"
                                            Command="{Binding Import.OpenImportDialogCommand}"
                                            ToolTip.Tip="导入或导出 OpenAPI、Postman Collection、cURL"
                                            AutomationProperties.Name="导入或导出"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Upload}"
                                                Text="导入"
                                                IconSize="14"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Grid.Column="3"
                                            Variant="Secondary"
                                            Size="Small"
                                            Padding="10,0"
                                            HorizontalAlignment="Right"
                                            Command="{Binding AddRequestCommand}"
                                            ToolTip.Tip="新建请求"
                                            AutomationProperties.Name="新建请求"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Plus}"
                                                Text="新建请求"
                                                IconSize="14"
                                            />
                                        </arc:Button>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        ColumnDefinitions="*,Auto,Auto,Auto"
                                        ColumnSpacing="6"
                                        Margin="0,8,0,0"
                                    >
                                        <arc:SearchField
                                            Placeholder="搜索"
                                            Text="{Binding FilterText, Mode=TwoWay}"
                                            ToolTip.Tip="搜索集合与请求"
                                            AutomationProperties.Name="搜索集合与请求"
                                        />
                                        <arc:SegmentedControl
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            SelectedValue="{Binding TreeFilterMode, Mode=TwoWay}"
                                            AutomationProperties.Name="集合筛选"
                                        >
                                            <arc:SegmentedOption Value="全部" Label="全部" />
                                            <arc:SegmentedOption Value="收藏" Label="收藏" />
                                        </arc:SegmentedControl>
                                        <arc:Button
                                            Grid.Column="2"
                                            Variant="Ghost"
                                            Size="Small"
                                            Width="30"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding ToggleAllCollectionsCommand}"
                                            ToolTip.Tip="全部展开/折叠集合"
                                            AutomationProperties.Name="全部展开或折叠集合"
                                        >
                                            <arc:ArcGlyph
                                                Data="{x:Static arc:ArcIcons.ChevronsUpDown}"
                                                Size="14"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Grid.Column="3"
                                            Variant="Ghost"
                                            Size="Small"
                                            Width="30"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Command="{Binding TreeTrash.OpenCommand}"
                                            ToolTip.Tip="{Binding TreeTrash.ButtonTip}"
                                            AutomationProperties.Name="集合回收站"
                                        >
                                            <arc:ArcGlyph
                                                Data="{x:Static arc:ArcIcons.Archive}"
                                                Size="14"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            />
                                        </arc:Button>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0,8,0,8">
                                        <arc:ScrollArea
                                            x:Name="CollectionScrollArea"
                                            HorizontalContentAlignment="Stretch"
                                            HorizontalScrollBarVisibility="Disabled"
                                        >
                                            <Grid>
                                                <ItemsControl
                                                    ItemsSource="{Binding TreePage.Items}"
                                                    HorizontalAlignment="Stretch"
                                                >
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.DataTemplates>
                                                        <DataTemplate DataType="models:TreeCollectionNode">
                                                            <Border
                                                                Classes="treeRow"
                                                                Classes.selected="{Binding Collection.IsSelected}"
                                                                Margin="{Binding Indent}"
                                                                Focusable="True"
                                                                PointerPressed="OnTreeRowPointerPressed"
                                                                AutomationProperties.Name="{Binding Collection.Name}"
                                                            >
                                                                <Grid
                                                                    ColumnDefinitions="24,*,Auto,40"
                                                                    ColumnSpacing="2"
                                                                >
                                                                    <arc:Button
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="24"
                                                                        Padding="0"
                                                                        Click="OnTreeCollectionChevronClick"
                                                                        AutomationProperties.Name="展开或折叠集合"
                                                                    >
                                                                        <Panel VerticalAlignment="Center">
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                                                Size="14"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                IsVisible="{Binding !Collection.IsExpanded}"
                                                                            />
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.ChevronDown}"
                                                                                Size="14"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                IsVisible="{Binding Collection.IsExpanded}"
                                                                            />
                                                                        </Panel>
                                                                    </arc:Button>
                                                                    <Border
                                                                        Grid.Column="1"
                                                                        Background="Transparent"
                                                                        Padding="4,3"
                                                                        Cursor="Hand"
                                                                    >
                                                                        <Grid
                                                                            ColumnDefinitions="18,*"
                                                                            ColumnSpacing="6"
                                                                        >
                                                                            <Panel VerticalAlignment="Center">
                                                                                <arc:ArcGlyph
                                                                                    Data="{x:Static arc:ArcIcons.Folder}"
                                                                                    Size="15"
                                                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                    IsVisible="{Binding !Collection.IsExpanded}"
                                                                                />
                                                                                <arc:ArcGlyph
                                                                                    Data="{x:Static arc:ArcIcons.FolderOpen}"
                                                                                    Size="15"
                                                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                    IsVisible="{Binding Collection.IsExpanded}"
                                                                                />
                                                                            </Panel>
                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                Text="{Binding Collection.Name}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                                FontWeight="Medium"
                                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                VerticalAlignment="Center"
                                                                                TextTrimming="CharacterEllipsis"
                                                                            />
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel
                                                                        Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        VerticalAlignment="Center"
                                                                    >
                                                                        <arc:Button
                                                                            Classes="rowActions"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="24"
                                                                            Padding="0"
                                                                            IsTabStop="False"
                                                                            Click="OnTreeFavoriteClick"
                                                                            ToolTip.Tip="收藏或取消收藏"
                                                                            AutomationProperties.Name="收藏或取消收藏集合"
                                                                        >
                                                                            <Panel>
                                                                                <arc:ArcGlyph
                                                                                    Data="{x:Static arc:ArcIcons.Star}"
                                                                                    Size="12"
                                                                                    Foreground="{arc:ArcDesignTokenResource Warning}"
                                                                                    IsVisible="{Binding Collection.IsFavorite}"
                                                                                />
                                                                                <arc:ArcGlyph
                                                                                    Data="{x:Static arc:ArcIcons.Star}"
                                                                                    Size="12"
                                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                    IsVisible="{Binding !Collection.IsFavorite}"
                                                                                />
                                                                            </Panel>
                                                                        </arc:Button>
                                                                        <arc:Button
                                                                            Classes="rowActions"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="24"
                                                                            Padding="0"
                                                                            IsTabStop="False"
                                                                            Click="OnTreeMoveRowUpClick"
                                                                            ToolTip.Tip="上移"
                                                                            AutomationProperties.Name="上移"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.ArrowUp}"
                                                                                Size="13"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                            />
                                                                        </arc:Button>
                                                                        <arc:Button
                                                                            Classes="rowActions"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="24"
                                                                            Padding="0"
                                                                            IsTabStop="False"
                                                                            Click="OnTreeMoveRowDownClick"
                                                                            ToolTip.Tip="下移"
                                                                            AutomationProperties.Name="下移"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.ArrowDown}"
                                                                                Size="13"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                            />
                                                                        </arc:Button>
                                                                    </StackPanel>
                                                                    <arc:Button
                                                                        Grid.Column="3"
                                                                        Classes="rowActions"
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="40"
                                                                        Padding="0"
                                                                        IsTabStop="False"
                                                                        Click="OnTreeRowActionsClick"
                                                                        AutomationProperties.Name="更多操作"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.Ellipsis}"
                                                                            Size="15"
                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        />
                                                                    </arc:Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>

                                                        <DataTemplate DataType="models:TreeRequestNode">
                                                            <Border
                                                                Classes="treeRow"
                                                                Classes.selected="{Binding Request.IsSelected}"
                                                                Margin="{Binding Indent}"
                                                                Focusable="True"
                                                                PointerPressed="OnTreeRowPointerPressed"
                                                                AutomationProperties.Name="{Binding Request.Name}"
                                                            >
                                                                <Grid
                                                                    ColumnDefinitions="*,Auto,40"
                                                                    ColumnSpacing="2"
                                                                >
                                                                    <Border
                                                                        Grid.Column="0"
                                                                        Background="Transparent"
                                                                        Padding="6,3"
                                                                        Cursor="Hand"
                                                                    >
                                                                        <Grid
                                                                            ColumnDefinitions="18,*,Auto"
                                                                            ColumnSpacing="6"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.FileText}"
                                                                                Size="14"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                VerticalAlignment="Center"
                                                                            />
                                                                            <TextBlock
                                                                                Grid.Column="1"
                                                                                Text="{Binding Request.Name}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                VerticalAlignment="Center"
                                                                                TextTrimming="CharacterEllipsis"
                                                                            />
                                                                            <arc:Button
                                                                                Grid.Column="2"
                                                                                Classes="rowActions"
                                                                                Variant="Ghost"
                                                                                Size="Small"
                                                                                Width="24"
                                                                                Padding="0"
                                                                                VerticalAlignment="Center"
                                                                                IsTabStop="False"
                                                                                Click="OnTreeFavoriteClick"
                                                                                ToolTip.Tip="收藏或取消收藏"
                                                                                AutomationProperties.Name="收藏或取消收藏请求"
                                                                            >
                                                                                <Panel>
                                                                                    <arc:ArcGlyph
                                                                                        Data="{x:Static arc:ArcIcons.Star}"
                                                                                        Size="12"
                                                                                        Foreground="{arc:ArcDesignTokenResource Warning}"
                                                                                        IsVisible="{Binding Request.IsFavorite}"
                                                                                    />
                                                                                    <arc:ArcGlyph
                                                                                        Data="{x:Static arc:ArcIcons.Star}"
                                                                                        Size="12"
                                                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                        IsVisible="{Binding !Request.IsFavorite}"
                                                                                    />
                                                                                </Panel>
                                                                            </arc:Button>
                                                                        </Grid>
                                                                    </Border>
                                                                    <StackPanel
                                                                        Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        VerticalAlignment="Center"
                                                                    >
                                                                        <arc:Button
                                                                            Classes="rowActions"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="24"
                                                                            Padding="0"
                                                                            IsTabStop="False"
                                                                            Click="OnTreeMoveRowUpClick"
                                                                            ToolTip.Tip="上移"
                                                                            AutomationProperties.Name="上移"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.ArrowUp}"
                                                                                Size="13"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                            />
                                                                        </arc:Button>
                                                                        <arc:Button
                                                                            Classes="rowActions"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="24"
                                                                            Padding="0"
                                                                            IsTabStop="False"
                                                                            Click="OnTreeMoveRowDownClick"
                                                                            ToolTip.Tip="下移"
                                                                            AutomationProperties.Name="下移"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.ArrowDown}"
                                                                                Size="13"
                                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                            />
                                                                        </arc:Button>
                                                                    </StackPanel>
                                                                    <arc:Button
                                                                        Grid.Column="2"
                                                                        Classes="rowActions"
                                                                        Variant="Ghost"
                                                                        Size="Small"
                                                                        Width="40"
                                                                        Padding="0"
                                                                        IsTabStop="False"
                                                                        Click="OnTreeRowActionsClick"
                                                                        AutomationProperties.Name="更多操作"
                                                                    >
                                                                        <arc:ArcGlyph
                                                                            Data="{x:Static arc:ArcIcons.Ellipsis}"
                                                                            Size="15"
                                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                        />
                                                                    </arc:Button>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.DataTemplates>
                                                </ItemsControl>

                                                <TextBlock
                                                    Text="{Binding TreeEmptyText}"
                                                    IsVisible="{Binding TreeIsEmpty}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Margin="0,16,0,0"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                />
                                            </Grid>
                                        </arc:ScrollArea>
                                    </Grid>

                                    <Border
                                        Grid.Row="3"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="8"
                                        Margin="0,0,0,8"
                                    >
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <Grid
                                                ColumnDefinitions="*,Auto,Auto,Auto"
                                                ColumnSpacing="3"
                                            >
                                                <TextBlock
                                                    Text="{Binding HistoryCountText}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    FontWeight="Medium"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    VerticalAlignment="Center"
                                                />
                                                <arc:Button
                                                    Grid.Column="1"
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Width="28"
                                                    Padding="0"
                                                    IsVisible="{Binding IsHistoryExpanded}"
                                                    Command="{Binding OpenHistoryTrashCommand}"
                                                    ToolTip.Tip="打开历史回收站"
                                                    AutomationProperties.Name="打开历史回收站"
                                                >
                                                    <arc:ArcGlyph
                                                        Data="{x:Static arc:ArcIcons.Archive}"
                                                        Size="13"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Grid.Column="2"
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Width="28"
                                                    Padding="0"
                                                    IsVisible="{Binding IsHistoryExpanded}"
                                                    Command="{Binding ClearHistoryCommand}"
                                                    ToolTip.Tip="清空历史记录"
                                                    AutomationProperties.Name="清空历史记录"
                                                >
                                                    <arc:ArcGlyph
                                                        Data="{x:Static arc:ArcIcons.Eraser}"
                                                        Size="13"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </arc:Button>
                                                <arc:Button
                                                    Grid.Column="3"
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Width="28"
                                                    Padding="0"
                                                    Command="{Binding ToggleHistoryExpandedCommand}"
                                                    ToolTip.Tip="展开或收起最近记录"
                                                    AutomationProperties.Name="展开或收起最近记录"
                                                >
                                                    <Panel
                                                        Width="14"
                                                        Height="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                    >
                                                        <arc:ArcGlyph
                                                            Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                            Size="13"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                            IsVisible="{Binding !IsHistoryExpanded}"
                                                        />
                                                        <arc:ArcGlyph
                                                            Data="{x:Static arc:ArcIcons.ChevronDown}"
                                                            Size="13"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                            IsVisible="{Binding IsHistoryExpanded}"
                                                        />
                                                    </Panel>
                                                </arc:Button>
                                            </Grid>
                                            <Grid
                                                Grid.Row="1"
                                                Height="200"
                                                IsVisible="{Binding IsHistoryExpanded}"
                                            >
                                                <arc:ScrollArea
                                                    x:Name="HistoryScrollArea"
                                                    HorizontalContentAlignment="Stretch"
                                                    HorizontalScrollBarVisibility="Disabled"
                                                >
                                                    <ItemsControl
                                                        ItemsSource="{Binding History}"
                                                        HorizontalAlignment="Stretch"
                                                    >
                                                        <ItemsControl.Styles>
                                                            <Style Selector="ItemsControl > ContentPresenter">
                                                                <Setter
                                                                    Property="HorizontalAlignment"
                                                                    Value="Stretch"
                                                                />
                                                                <Setter
                                                                    Property="HorizontalContentAlignment"
                                                                    Value="Stretch"
                                                                />
                                                            </Style>
                                                        </ItemsControl.Styles>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:HistoryEntry">
                                                                <controls:SelectableRow
                                                                    Margin="0,0,0,2"
                                                                    IsSelected="{Binding IsSelected}"
                                                                    Click="OnHistoryRowClick"
                                                                    ToolTip.Tip="{Binding TimestampText}"
                                                                    AutomationProperties.Name="{Binding Name}"
                                                                >
                                                                    <Grid
                                                                        ColumnDefinitions="Auto,*,Auto,26"
                                                                        ColumnSpacing="8"
                                                                        Margin="7,5"
                                                                    >
                                                                        <arc:Badge
                                                                            Content="{Binding MethodDisplay}"
                                                                            Tone="{Binding MethodTone}"
                                                                            Size="Small"
                                                                            VerticalAlignment="Center"
                                                                        />
                                                                        <StackPanel
                                                                            Grid.Column="1"
                                                                            Spacing="1"
                                                                            VerticalAlignment="Center"
                                                                        >
                                                                            <TextBlock
                                                                                Text="{Binding Name}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding Name}"
                                                                            />
                                                                            <TextBlock
                                                                                Text="{Binding Url}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                TextTrimming="CharacterEllipsis"
                                                                                ToolTip.Tip="{Binding Url}"
                                                                            />
                                                                        </StackPanel>
                                                                        <StackPanel
                                                                            Grid.Column="2"
                                                                            Spacing="1"
                                                                            HorizontalAlignment="Right"
                                                                            VerticalAlignment="Center"
                                                                        >
                                                                            <arc:Badge
                                                                                Content="{Binding StatusLabel}"
                                                                                Tone="{Binding StatusTone}"
                                                                                Size="Small"
                                                                                HorizontalAlignment="Right"
                                                                            />
                                                                            <TextBlock
                                                                                Text="{Binding DisplayTime}"
                                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                HorizontalAlignment="Right"
                                                                            />
                                                                        </StackPanel>
                                                                        <arc:Button
                                                                            Grid.Column="3"
                                                                            Variant="Ghost"
                                                                            Size="Small"
                                                                            Width="26"
                                                                            Padding="0"
                                                                            IsVisible="{Binding IsSelected}"
                                                                            Command="{Binding DeleteCommand}"
                                                                            ToolTip.Tip="删除这条历史记录"
                                                                            AutomationProperties.Name="删除历史记录"
                                                                        >
                                                                            <arc:ArcGlyph
                                                                                Data="{x:Static arc:ArcIcons.Trash2}"
                                                                                Size="12"
                                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                            />
                                                                        </arc:Button>
                                                                    </Grid>
                                                                </controls:SelectableRow>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </arc:ScrollArea>
                                                <TextBlock
                                                    Text="发送请求后会出现在这里"
                                                    IsVisible="{Binding !HasHistory}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border
                                        Grid.Row="4"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="10,8"
                                    >
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Ellipse
                                                        Width="8"
                                                        Height="8"
                                                        VerticalAlignment="Center"
                                                        Fill="{arc:ArcDesignTokenResource Success}"
                                                    />
                                                    <TextBlock
                                                        Text="{Binding MockStatus}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        TextTrimming="CharacterEllipsis"
                                                    />
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{Binding McpEndpoint}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    TextTrimming="CharacterEllipsis"
                                                />
                                            </StackPanel>
                                            <arc:Button
                                                Grid.Column="1"
                                                Variant="Ghost"
                                                Size="Small"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Click="OnOpenGitHubClick"
                                                ToolTip.Tip="打开 GitHub 项目主页"
                                                AutomationProperties.Name="打开 GitHub 项目主页"
                                            >
                                                <Path
                                                    Width="17"
                                                    Height="17"
                                                    Stretch="Uniform"
                                                    Fill="{arc:ArcDesignTokenResource TextSecondary}"
                                                    Data="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.34-1.3-1.7-1.3-1.7-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.11-.75.41-1.27.75-1.56-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.2-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.75.81 1.2 1.84 1.2 3.1 0 4.43-2.69 5.41-5.26 5.69.42.36.79 1.08.79 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
                                                />
                                            </arc:Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <GridSplitter
                                x:Name="SidebarSplitter"
                                Grid.Column="1"
                                Width="8"
                                ResizeDirection="Columns"
                                ResizeBehavior="PreviousAndNext"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="Transparent"
                                Cursor="SizeWestEast"
                                Focusable="True"
                                KeyboardIncrement="16"
                                DragCompleted="OnSidebarSplitterDragCompleted"
                                DoubleTapped="OnSidebarSplitterDoubleTapped"
                                ToolTip.Tip="拖动调整集合栏宽度；双击恢复默认"
                                AutomationProperties.Name="调整集合栏宽度"
                            >
                                <GridSplitter.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <Border
                                                Width="1"
                                                HorizontalAlignment="Center"
                                                Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                            />
                                        </Border>
                                    </ControlTemplate>
                                </GridSplitter.Template>
                            </GridSplitter>

                            <!-- Editor and response -->
                            <Grid
                                x:Name="EditorResponseLayout"
                                Grid.Column="2"
                                Margin="16,12,20,20"
                            >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="0" />
                                    <ColumnDefinition Width="0" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="0" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" MinHeight="0" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    ColumnDefinitions="*,Auto,Auto"
                                    Margin="0,0,0,10"
                                >
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center"
                                    >
                                        <arc:Input
                                            Width="240"
                                            Size="Small"
                                            IsLabelVisible="False"
                                            Placeholder="请求名称"
                                            Text="{Binding Editing.Name, Mode=TwoWay}"
                                            AutomationProperties.Name="请求名称"
                                        />
                                        <TextBlock
                                            Text="{Binding EditorHint}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                    <arc:Button
                                        Grid.Column="1"
                                        Variant="Ghost"
                                        Size="Small"
                                        Content="{Binding ResponseCollapseLabel}"
                                        Command="{Binding ToggleResponseCollapsedCommand}"
                                        ToolTip.Tip="收起或展开响应区域"
                                        AutomationProperties.Name="收起或展开响应"
                                    />
                                    <arc:Button
                                        Grid.Column="2"
                                        Variant="Secondary"
                                        Size="Small"
                                        Command="{Binding SaveCommand}"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Check}"
                                            Text="保存"
                                        />
                                    </arc:Button>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Grid.ColumnSpan="3"
                                    ColumnDefinitions="Auto,*,Auto,Auto"
                                    Margin="0,0,0,12"
                                >
                                    <arc:Select
                                        Grid.Column="0"
                                        Width="130"
                                        MinWidth="120"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,10,0"
                                        ItemsSource="{Binding Methods}"
                                        SelectedItem="{Binding Editing.Method, Mode=TwoWay}"
                                        Placeholder="方法"
                                        AutomationProperties.Name="请求方法"
                                    />
                                    <arc:Input
                                        Grid.Column="1"
                                        Margin="0,0,10,0"
                                        Placeholder="https://api.example.com/users"
                                        IsLabelVisible="False"
                                        Text="{Binding Editing.Url, Mode=TwoWay}"
                                        FontFamily="{DynamicResource PostSharpCodeFont}"
                                        AutomationProperties.Name="请求地址"
                                    />
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                    >
                                        <TextBlock
                                            Text="超时"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:NumberField
                                            Width="150"
                                            IsLabelVisible="False"
                                            Minimum="0"
                                            Maximum="3600"
                                            Step="5"
                                            SuffixFormatter="{x:Static controls:TimeoutFormatting.SuffixFormatter}"
                                            Value="{Binding Editing.TimeoutSeconds, Mode=TwoWay}"
                                            ToolTip.Tip="本请求超时秒数；0 表示跟随设置中的全局超时"
                                            AutomationProperties.Name="请求超时（秒，0 跟随全局）"
                                        />
                                        <TextBlock
                                            Text="重定向"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:Switch
                                            IsChecked="{Binding Editing.FollowRedirects, Mode=TwoWay}"
                                            ToolTip.Tip="跟随 3xx 重定向（最多 10 次）；关闭后直接显示 3xx 响应"
                                            AutomationProperties.Name="跟随重定向"
                                        />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                    >
                                        <arc:Button
                                            Variant="Primary"
                                            IsDefault="True"
                                            MinWidth="88"
                                            IsLoading="{Binding Editing.IsSending}"
                                            Command="{Binding SendCommand}"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.SendHorizontal}"
                                                Text="发送"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Secondary"
                                            IsVisible="{Binding Editing.IsSending}"
                                            Command="{Binding CancelSendCommand}"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.X}"
                                                Text="取消"
                                            />
                                        </arc:Button>
                                    </StackPanel>
                                </Grid>

                                <Grid
                                    x:Name="RequestTabsHost"
                                    Grid.Row="2"
                                    RowDefinitions="Auto,*"
                                    RowSpacing="4"
                                >
                                    <Border
                                        x:Name="RequestTabWrap"
                                        Grid.Row="0"
                                        IsVisible="{Binding IsWrapTabs}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="4"
                                        Margin="0,0,0,4"
                                        AutomationProperties.Name="请求配置标签（多行）"
                                    >
                                        <ItemsControl ItemsSource="{Binding RequestTabOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RequestTabOption">
                                                    <arc:Button
                                                        Content="{Binding Header}"
                                                        Variant="{Binding Variant}"
                                                        Size="Small"
                                                        Margin="0,0,4,4"
                                                        Command="{Binding $parent[Window].DataContext.SelectRequestTabCommand}"
                                                        CommandParameter="{Binding Index}"
                                                    />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <arc:Tabs
                                        Grid.Row="1"
                                        x:Name="RequestTabs"
                                        SelectedIndex="{Binding RequestTabIndex, Mode=TwoWay}"
                                        ClipToBounds="True"
                                        AutomationProperties.Name="请求配置"
                                    >
                                        <arc:TabItem Header="参数">
                                            <Grid RowDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                                                <Grid
                                                    ColumnDefinitions="44,*,*,34"
                                                    Margin="0,0,0,6"
                                                >
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="键"
                                                        Margin="16,0,0,0"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="值"
                                                        Margin="16,0,0,0"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </Grid>
                                                <arc:ScrollArea Grid.Row="1">
                                                    <ItemsControl
                                                        ItemsSource="{Binding Editing.Params}"
                                                        ItemTemplate="{StaticResource KeyValueRowTemplate}"
                                                    />
                                                </arc:ScrollArea>
                                                <TextBlock
                                                    Grid.Row="2"
                                                    Text="填写最后一行会自动新增一行；未启用的行不会发送。"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    Margin="0,8,0,0"
                                                />
                                            </Grid>
                                        </arc:TabItem>

                                        <arc:TabItem Header="请求头">
                                            <Grid
                                                RowDefinitions="Auto,Auto,Auto,*"
                                                Margin="0,6,0,0"
                                                RowSpacing="8"
                                            >
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding AddJsonContentTypeCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Code}"
                                                            Text="JSON 类型"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding AddAcceptJsonCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.CircleCheck}"
                                                            Text="Accept JSON"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding AddBearerTokenCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Key}"
                                                            Text="Bearer Token"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Spacing="3">
                                                    <TextBlock
                                                        Text="{Binding HeaderWarningText}"
                                                        IsVisible="{Binding HasHeaderWarning}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource Danger}"
                                                        TextWrapping="Wrap"
                                                    />
                                                    <TextBlock
                                                        Text="支持 {{变量}}；发送时自动补充 Accept: */*、User-Agent: PostSharp/0.1；请求体模式下自动补充 Content-Type。"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        TextWrapping="Wrap"
                                                    />
                                                </StackPanel>
                                                <Grid Grid.Row="2" ColumnDefinitions="44,*,*,34">
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="键"
                                                        Margin="16,0,0,0"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="值"
                                                        Margin="16,0,0,0"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    />
                                                </Grid>
                                                <arc:ScrollArea Grid.Row="3">
                                                    <ItemsControl
                                                        ItemsSource="{Binding Editing.Headers}"
                                                        ItemTemplate="{StaticResource KeyValueRowTemplate}"
                                                    />
                                                </arc:ScrollArea>
                                            </Grid>
                                        </arc:TabItem>

                                        <arc:TabItem Header="授权">
                                            <arc:ScrollArea Margin="0,6,0,0">
                                                <StackPanel
                                                    Spacing="10"
                                                    Margin="0,0,4,0"
                                                    HorizontalAlignment="Stretch"
                                                >
                                                    <Grid
                                                        ColumnDefinitions="1*,1*"
                                                        ColumnSpacing="10"
                                                    >
                                                        <arc:Select
                                                            Label="认证类型"
                                                            SelectedValue="{Binding EditingAuth.AuthType, Mode=TwoWay}"
                                                            AutomationProperties.Name="认证类型"
                                                        >
                                                            <arc:SelectItem
                                                                Content="继承上级集合"
                                                                Value="Inherit"
                                                            />
                                                            <arc:SelectItem
                                                                Content="无认证"
                                                                Value="None"
                                                            />
                                                            <arc:SelectItem
                                                                Content="Bearer 令牌"
                                                                Value="Bearer"
                                                            />
                                                            <arc:SelectItem
                                                                Content="Basic 认证"
                                                                Value="Basic"
                                                            />
                                                            <arc:SelectItem
                                                                Content="API Key"
                                                                Value="ApiKey"
                                                            />
                                                            <arc:SelectItem
                                                                Content="OAuth 2.0"
                                                                Value="OAuth2"
                                                            />
                                                        </arc:Select>
                                                        <arc:Select
                                                            Grid.Column="1"
                                                            Label="附加位置"
                                                            SelectedValue="{Binding EditingAuth.Target, Mode=TwoWay}"
                                                            AutomationProperties.Name="授权附加位置"
                                                        >
                                                            <arc:SelectItem
                                                                Content="请求头"
                                                                Value="Header"
                                                            />
                                                            <arc:SelectItem
                                                                Content="查询参数"
                                                                Value="Query"
                                                            />
                                                        </arc:Select>
                                                    </Grid>

                                                    <Border
                                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                        Padding="12"
                                                    >
                                                        <StackPanel Spacing="6">
                                                            <TextBlock
                                                                Text="{Binding AuthScopeTitle}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                FontWeight="Medium"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="Wrap"
                                                            />
                                                            <TextBlock
                                                                Text="{Binding AuthScopeDetail}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                TextWrapping="Wrap"
                                                            />
                                                            <WrapPanel
                                                                ItemSpacing="8"
                                                                LineSpacing="8"
                                                            >
                                                                <arc:Button
                                                                    Content="打开授权配置…"
                                                                    Variant="Secondary"
                                                                    Size="Small"
                                                                    Click="OnOpenCurrentAuthorizationClick"
                                                                    AutomationProperties.Name="打开当前对象的授权配置"
                                                                />
                                                                <arc:Button
                                                                    Content="{Binding EnclosingCollectionAuthLabel}"
                                                                    Variant="Ghost"
                                                                    Size="Small"
                                                                    IsVisible="{Binding HasEnclosingCollectionAuth}"
                                                                    Click="OnOpenEnclosingCollectionAuthorizationClick"
                                                                    AutomationProperties.Name="{Binding EnclosingCollectionAuthLabel}"
                                                                />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <arc:Input
                                                        Label="Bearer 令牌"
                                                        IsVisible="{Binding EditingAuth.IsBearer}"
                                                        Text="{Binding EditingAuth.Token, Mode=TwoWay}"
                                                        Description="只保存在本机，落盘时用 Windows DPAPI 加密。"
                                                        AutomationProperties.Name="Bearer 令牌"
                                                    />
                                                    <Grid
                                                        ColumnDefinitions="1*,1*"
                                                        ColumnSpacing="10"
                                                        IsVisible="{Binding EditingAuth.IsBasic}"
                                                    >
                                                        <arc:Input
                                                            Label="用户名"
                                                            Text="{Binding EditingAuth.Username, Mode=TwoWay}"
                                                            AutomationProperties.Name="用户名"
                                                        />
                                                        <arc:Input
                                                            Grid.Column="1"
                                                            Label="密码"
                                                            Text="{Binding EditingAuth.Password, Mode=TwoWay}"
                                                            Description="落盘时用 Windows DPAPI 加密。"
                                                            AutomationProperties.Name="密码"
                                                        />
                                                    </Grid>
                                                    <Grid
                                                        ColumnDefinitions="1*,1.2*,0.9*"
                                                        ColumnSpacing="10"
                                                        IsVisible="{Binding EditingAuth.IsApiKey}"
                                                    >
                                                        <arc:Input
                                                            Label="名称"
                                                            Text="{Binding EditingAuth.ApiKeyName, Mode=TwoWay}"
                                                            AutomationProperties.Name="API Key 名称"
                                                        />
                                                        <arc:Input
                                                            Grid.Column="1"
                                                            Label="值"
                                                            Text="{Binding EditingAuth.ApiKeyValue, Mode=TwoWay}"
                                                            Description="落盘时用 Windows DPAPI 加密。"
                                                            AutomationProperties.Name="API Key 值"
                                                        />
                                                        <arc:Select
                                                            Grid.Column="2"
                                                            Label="位置"
                                                            SelectedValue="{Binding EditingAuth.ApiKeyLocation, Mode=TwoWay}"
                                                            AutomationProperties.Name="API Key 位置"
                                                        >
                                                            <arc:SelectItem
                                                                Content="请求头"
                                                                Value="Header"
                                                            />
                                                            <arc:SelectItem
                                                                Content="查询参数"
                                                                Value="Query"
                                                            />
                                                        </arc:Select>
                                                    </Grid>
                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding EditingAuth.IsOAuth2}"
                                                    >
                                                        <arc:Badge
                                                            Content="{Binding EditingAuth.OAuthStatusText}"
                                                            Tone="Neutral"
                                                            VerticalAlignment="Center"
                                                        />
                                                        <TextBlock
                                                            Text="{Binding EditingAuth.OAuthExpiresText, StringFormat='到期 {0}'}"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                            VerticalAlignment="Center"
                                                        />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="OAuth 2.0 的客户端配置与浏览器登录在「授权配置」窗口完成；令牌过期时会自动用 refresh_token 续期。"
                                                        IsVisible="{Binding EditingAuth.IsOAuth2}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        TextWrapping="Wrap"
                                                    />
                                                    <TextBlock
                                                        Text="树中选中集合时配置的是集合授权，选中请求时配置的是该请求；请求里手写的同名请求头优先。"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        TextWrapping="Wrap"
                                                    />
                                                </StackPanel>
                                            </arc:ScrollArea>
                                        </arc:TabItem>

                                        <arc:TabItem Header="请求体">
                                            <Grid
                                                RowDefinitions="Auto,*"
                                                Margin="0,6,0,0"
                                                RowSpacing="10"
                                            >
                                                <WrapPanel ItemSpacing="12" LineSpacing="8">
                                                    <arc:SegmentedControl
                                                        SelectedValue="{Binding Editing.BodyMode, Mode=TwoWay}"
                                                        AutomationProperties.Name="请求体格式"
                                                    >
                                                        <arc:SegmentedOption
                                                            Value="None"
                                                            Label="无"
                                                        />
                                                        <arc:SegmentedOption
                                                            Value="Json"
                                                            Label="JSON"
                                                        />
                                                        <arc:SegmentedOption
                                                            Value="Text"
                                                            Label="文本"
                                                        />
                                                        <arc:SegmentedOption
                                                            Value="GraphQL"
                                                            Label="GraphQL"
                                                        />
                                                        <arc:SegmentedOption
                                                            Value="Multipart"
                                                            Label="表单上传"
                                                        />
                                                    </arc:SegmentedControl>
                                                    <arc:Switch
                                                        Content="JSON 视图"
                                                        IsChecked="{Binding IsRequestBodyJsonView, Mode=TwoWay}"
                                                        IsVisible="{Binding IsJsonBody}"
                                                    />
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding FormatBodyCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Code}"
                                                            Text="格式化"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding MinifyBodyCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Shrink}"
                                                            Text="压缩"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <TextBlock
                                                        Text="请求体中同样可以使用 {{变量}}。"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        VerticalAlignment="Center"
                                                    />
                                                </WrapPanel>

                                                <Grid Grid.Row="1">
                                                    <Grid
                                                        IsVisible="{Binding ShowRequestBodyEditor}"
                                                        RowDefinitions="Auto,*"
                                                        RowSpacing="8"
                                                    >
                                                        <TextBlock
                                                            Text="{Binding BodyPreview}"
                                                            FontFamily="{DynamicResource PostSharpCodeFont}"
                                                            FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            TextTrimming="CharacterEllipsis"
                                                        />
                                                        <Grid Grid.Row="1">
                                                            <arc:Textarea
                                                                x:Name="RequestBodyTextarea"
                                                                Text="{Binding Editing.Body, Mode=TwoWay}"
                                                                IsLabelVisible="False"
                                                                Placeholder="{}{ &quot;name&quot;: &quot;PostSharp&quot; }"
                                                                IsResizable="False"
                                                                FrameHeight="240"
                                                                MinHeight="80"
                                                                Margin="0,0,0,8"
                                                                ClipToBounds="True"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                AutomationProperties.Name="请求体"
                                                            />
                                                        </Grid>
                                                    </Grid>

                                                    <arc:JsonViewer
                                                        x:Name="JsonRequestBodyViewer"
                                                        Json="{Binding Editing.Body}"
                                                        IsVisible="{Binding ShowRequestBodyJsonViewer}"
                                                        ExpandDepth="2"
                                                        MaxTreeHeight="320"
                                                        SearchPlaceholder="搜索请求体键和值"
                                                        AutomationProperties.Name="JSON 请求体"
                                                    />

                                                    <Grid
                                                        IsVisible="{Binding IsGraphQlBody}"
                                                        RowDefinitions="Auto,*"
                                                        RowSpacing="8"
                                                    >
                                                        <Grid
                                                            ColumnDefinitions="*,*"
                                                            ColumnSpacing="8"
                                                        >
                                                            <arc:Input
                                                                Label="Operation name（可选）"
                                                                Text="{Binding Editing.GraphQlOperationName, Mode=TwoWay}"
                                                                AutomationProperties.Name="GraphQL Operation name"
                                                            />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="Variables 必须是 JSON 对象；Query 和 Variables 都可以使用 {{变量}}。"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                TextWrapping="Wrap"
                                                                VerticalAlignment="Center"
                                                            />
                                                        </Grid>
                                                        <Grid
                                                            Grid.Row="1"
                                                            ColumnDefinitions="1.25*,*"
                                                            ColumnSpacing="8"
                                                        >
                                                            <arc:Textarea
                                                                Text="{Binding Editing.GraphQlQuery, Mode=TwoWay}"
                                                                IsLabelVisible="False"
                                                                IsResizable="False"
                                                                FrameHeight="260"
                                                                MinHeight="100"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                Placeholder="query { viewer { id name } }"
                                                                AutomationProperties.Name="GraphQL Query"
                                                            />
                                                            <arc:Textarea
                                                                Grid.Column="1"
                                                                Text="{Binding Editing.GraphQlVariables, Mode=TwoWay}"
                                                                IsLabelVisible="False"
                                                                IsResizable="False"
                                                                FrameHeight="260"
                                                                MinHeight="100"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                Placeholder="{}{ &quot;id&quot;: 1 }"
                                                                AutomationProperties.Name="GraphQL Variables"
                                                            />
                                                        </Grid>
                                                    </Grid>

                                                    <Grid
                                                        IsVisible="{Binding IsMultipartBody}"
                                                        RowDefinitions="Auto,Auto,Auto,*"
                                                        RowSpacing="8"
                                                    >
                                                        <Grid
                                                            ColumnDefinitions="*,Auto,Auto"
                                                            ColumnSpacing="8"
                                                        >
                                                            <TextBlock
                                                                Text="上传文件"
                                                                VerticalAlignment="Center"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                            />
                                                            <arc:Button
                                                                Grid.Column="1"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Click="OnPickUploadFilesClick"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.Upload}"
                                                                    Text="选择文件…"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                            <arc:Button
                                                                Grid.Column="2"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Click="OnClearUploadFilesClick"
                                                                IsEnabled="{Binding HasUploadFile}"
                                                            >
                                                                <controls:IconLabel
                                                                    Icon="{x:Static arc:ArcIcons.X}"
                                                                    Text="清空"
                                                                    IconSize="13"
                                                                />
                                                            </arc:Button>
                                                        </Grid>
                                                        <Border
                                                            Grid.Row="1"
                                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                            BorderThickness="1"
                                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                            Padding="8"
                                                            MinHeight="64"
                                                            DragDrop.AllowDrop="True"
                                                            DragDrop.DragOver="OnUploadDragOver"
                                                            DragDrop.Drop="OnUploadDrop"
                                                        >
                                                            <Grid>
                                                                <TextBlock
                                                                    IsVisible="{Binding !HasUploadFile}"
                                                                    Text="拖拽文件到这里，或点击「选择文件…」"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                />
                                                                <arc:ScrollArea
                                                                    MaxHeight="140"
                                                                    IsVisible="{Binding HasUploadFile}"
                                                                >
                                                                    <ItemsControl ItemsSource="{Binding Editing.UploadFiles}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:UploadFileItem">
                                                                                <Grid
                                                                                    ColumnDefinitions="150,*,Auto"
                                                                                    ColumnSpacing="8"
                                                                                    Margin="0,0,0,4"
                                                                                >
                                                                                    <arc:Input
                                                                                        Text="{Binding FieldName, Mode=TwoWay}"
                                                                                        IsLabelVisible="False"
                                                                                        Size="Small"
                                                                                        Placeholder="file"
                                                                                        AutomationProperties.Name="文件字段名"
                                                                                    />
                                                                                    <TextBlock
                                                                                        Grid.Column="1"
                                                                                        Text="{Binding DisplayLabel}"
                                                                                        VerticalAlignment="Center"
                                                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                        ToolTip.Tip="{Binding FilePath}"
                                                                                    />
                                                                                    <arc:Button
                                                                                        Grid.Column="2"
                                                                                        Variant="Ghost"
                                                                                        Size="Small"
                                                                                        Click="OnRemoveUploadFileClick"
                                                                                        CommandParameter="{Binding}"
                                                                                        AutomationProperties.Name="移除上传文件"
                                                                                    >
                                                                                        <controls:IconLabel
                                                                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                                                                            Text="移除"
                                                                                            IconSize="13"
                                                                                            TextForeground="{arc:ArcDesignTokenResource Danger}"
                                                                                            IconForeground="{arc:ArcDesignTokenResource Danger}"
                                                                                        />
                                                                                    </arc:Button>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </arc:ScrollArea>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel
                                                            Grid.Row="2"
                                                            Spacing="4"
                                                            IsVisible="{Binding IsUploading}"
                                                        >
                                                            <ProgressBar
                                                                Minimum="0"
                                                                Maximum="100"
                                                                Value="{Binding UploadProgressValue}"
                                                                Height="6"
                                                                Foreground="{arc:ArcDesignTokenResource Accent}"
                                                            />
                                                            <TextBlock
                                                                Text="{Binding UploadProgressText}"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                            />
                                                        </StackPanel>
                                                        <Grid
                                                            Grid.Row="3"
                                                            RowDefinitions="Auto,*"
                                                            RowSpacing="6"
                                                        >
                                                            <TextBlock
                                                                Text="表单字段"
                                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                FontWeight="Medium"
                                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            />
                                                            <arc:ScrollArea Grid.Row="1">
                                                                <ItemsControl
                                                                    ItemsSource="{Binding Editing.FormFields}"
                                                                    ItemTemplate="{StaticResource KeyValueRowTemplate}"
                                                                />
                                                            </arc:ScrollArea>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                                        </arc:TabItem>

                                        <arc:TabItem Header="cURL">
                                            <Grid
                                                RowDefinitions="Auto,*"
                                                Margin="0,6,0,0"
                                                RowSpacing="10"
                                            >
                                                <Grid
                                                    ColumnDefinitions="*,Auto,Auto,Auto"
                                                    ColumnSpacing="8"
                                                >
                                                    <TextBlock
                                                        Text="已按当前环境解析变量，可复制 bash cURL 或保存 PowerShell 脚本。"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="1"
                                                        Content="保存 cURL…"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Click="OnExportCurlClick"
                                                        IsEnabled="{Binding CanExportCurl}"
                                                        AutomationProperties.Name="保存当前请求 cURL"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="2"
                                                        Content="保存 PowerShell…"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Click="OnExportPowerShellClick"
                                                        IsEnabled="{Binding CanExportCurl}"
                                                        AutomationProperties.Name="保存当前请求 PowerShell"
                                                    />
                                                    <arc:CopyButton
                                                        Grid.Column="3"
                                                        Value="{Binding CurlPreview}"
                                                        Label="复制 cURL"
                                                        Variant="Plain"
                                                    />
                                                </Grid>
                                                <arc:ScrollArea Grid.Row="1">
                                                    <arc:CodeBlock
                                                        Code="{Binding CurlPreview}"
                                                        Language="bash"
                                                        FileName="request.sh"
                                                        IsCollapsible="False"
                                                        CopyLabel="复制 cURL"
                                                    />
                                                </arc:ScrollArea>
                                            </Grid>
                                        </arc:TabItem>

                                        <arc:TabItem
                                            Header="接口文档"
                                            IsVisible="{Binding HasOpenApiDoc}"
                                        >
                                            <Grid
                                                RowDefinitions="Auto,*"
                                                Margin="0,6,0,0"
                                                RowSpacing="10"
                                            >
                                                <Grid
                                                    ColumnDefinitions="*,Auto,Auto,Auto"
                                                    ColumnSpacing="8"
                                                >
                                                    <TextBlock
                                                        Text="{Binding OpenApiDocSourceText}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding OpenApiDocSourceText}"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="1"
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Command="{Binding SyncSelectedOpenApiCommand}"
                                                        IsVisible="{Binding HasOpenApiSource}"
                                                        IsLoading="{Binding IsSyncingOpenApi}"
                                                        AutomationProperties.Name="同步当前集合的 OpenAPI 来源"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                                            Text="同步来源"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Grid.Column="2"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Content="取消"
                                                        Command="{Binding CancelOpenApiSyncCommand}"
                                                        IsVisible="{Binding IsSyncingOpenApi}"
                                                        AutomationProperties.Name="取消 OpenAPI 同步"
                                                    />
                                                    <arc:CopyButton
                                                        Grid.Column="3"
                                                        Value="{Binding OpenApiDocMarkdown}"
                                                        Label="复制文档"
                                                        Variant="Plain"
                                                    />
                                                </Grid>
                                                <arc:ScrollArea Grid.Row="1">
                                                    <arc:Markdown
                                                        Text="{Binding OpenApiDocMarkdown}"
                                                        AutomationProperties.Name="OpenAPI 接口文档"
                                                    />
                                                </arc:ScrollArea>
                                            </Grid>
                                        </arc:TabItem>

                                        <arc:TabItem Header="调用代码">
                                            <Grid
                                                RowDefinitions="Auto,*"
                                                Margin="0,6,0,0"
                                                RowSpacing="10"
                                            >
                                                <Grid
                                                    ColumnDefinitions="190,*,Auto,Auto"
                                                    ColumnSpacing="8"
                                                >
                                                    <arc:Select
                                                        ItemsSource="{Binding CodeLanguages}"
                                                        SelectedItem="{Binding SelectedCodeLanguage, Mode=TwoWay}"
                                                        AutomationProperties.Name="调用代码语言"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="按当前环境解析变量后生成；文件上传请求会带上本地文件路径。"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        VerticalAlignment="Center"
                                                        TextWrapping="Wrap"
                                                    />
                                                    <arc:Button
                                                        Grid.Column="2"
                                                        Content="保存代码…"
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Click="OnExportCodeClick"
                                                        AutomationProperties.Name="保存当前调用代码"
                                                    />
                                                    <arc:CopyButton
                                                        Grid.Column="3"
                                                        Value="{Binding CodePreview}"
                                                        Label="复制代码"
                                                        Variant="Plain"
                                                    />
                                                </Grid>
                                                <arc:ScrollArea Grid.Row="1">
                                                    <arc:CodeBlock
                                                        Code="{Binding CodePreview}"
                                                        Language="{Binding CodeLanguageHighlight}"
                                                        FileName="{Binding CodeFileName}"
                                                        IsCollapsible="False"
                                                        CopyLabel="复制代码"
                                                    />
                                                </arc:ScrollArea>
                                            </Grid>
                                        </arc:TabItem>
                                    </arc:Tabs>
                                    <Border
                                        Grid.Row="1"
                                        VerticalAlignment="Top"
                                        Height="44"
                                        Background="{arc:ArcDesignTokenResource Background}"
                                        IsVisible="{Binding IsWrapTabs}"
                                        IsHitTestVisible="True"
                                    />
                                </Grid>

                                <GridSplitter
                                    x:Name="RequestResponseSplitter"
                                    Grid.Row="3"
                                    Height="8"
                                    ResizeDirection="Rows"
                                    ResizeBehavior="PreviousAndNext"
                                    Background="Transparent"
                                    HorizontalAlignment="Stretch"
                                    Focusable="True"
                                    Cursor="SizeNorthSouth"
                                    KeyboardIncrement="24"
                                    DragCompleted="OnRequestResponseSplitterDragCompleted"
                                    DoubleTapped="OnRequestResponseSplitterDoubleTapped"
                                    ToolTip.Tip="拖动调整请求 / 响应高度；双击恢复默认"
                                    AutomationProperties.Name="调整请求与响应高度"
                                >
                                    <GridSplitter.Template>
                                        <ControlTemplate>
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </GridSplitter.Template>
                                </GridSplitter>

                                <Grid
                                    Grid.Row="4"
                                    x:Name="ResponsePane"
                                    RowDefinitions="Auto,*"
                                    ClipToBounds="True"
                                >
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center"
                                        >
                                            <arc:Badge
                                                Content="{Binding ResponseStatusText}"
                                                Icon="{Binding ResponseStatusIcon}"
                                                Tone="{Binding ResponseTone}"
                                                Size="Small"
                                                IsVisible="{Binding HasResponse}"
                                            />
                                            <TextBlock
                                                Text="{Binding ResponseTimeText}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                IsVisible="{Binding HasResponse}"
                                            />
                                            <TextBlock
                                                Text="{Binding ResponseSizeText}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                IsVisible="{Binding HasResponse}"
                                            />
                                            <TextBlock
                                                Text="{Binding ResponseContentType}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                IsVisible="{Binding HasResponse}"
                                            />
                                            <TextBlock
                                                Text="响应"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                FontWeight="Medium"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding ShowEmptyResponse}"
                                            />
                                        </StackPanel>
                                        <arc:CopyButton
                                            Grid.Column="1"
                                            Value="{Binding ResponseClipboardText}"
                                            Label="复制响应"
                                            Variant="Plain"
                                            IsVisible="{Binding HasResponse}"
                                        />
                                    </Grid>

                                    <Border
                                        Grid.Row="1"
                                        IsVisible="{Binding ShowResponseError}"
                                        Background="{arc:ArcDesignTokenResource DangerSubtle}"
                                        BorderBrush="{arc:ArcDesignTokenResource Danger}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                        Padding="16"
                                    >
                                        <StackPanel Spacing="8">
                                            <arc:Badge
                                                Content="请求失败"
                                                Tone="Danger"
                                                Size="Small"
                                            />
                                            <TextBlock
                                                Text="{Binding ResponseError}"
                                                TextWrapping="Wrap"
                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                            />
                                            <TextBlock
                                                Text="检查请求地址、网络连接或 Mock 服务是否在运行。"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            />
                                        </StackPanel>
                                    </Border>

                                    <arc:Tabs
                                        Grid.Row="1"
                                        x:Name="ResponseTabs"
                                        IsVisible="{Binding HasResponse}"
                                        SelectedIndex="{Binding ResponseTabIndex, Mode=TwoWay}"
                                        AutomationProperties.Name="响应"
                                    >
                                        <arc:TabItem Header="响应体">
                                            <Grid
                                                x:Name="ResponseBodyPanel"
                                                RowDefinitions="Auto,Auto,*"
                                                Margin="0,6,0,0"
                                                RowSpacing="8"
                                            >
                                                <WrapPanel ItemSpacing="10" LineSpacing="6">
                                                    <arc:Switch
                                                        Content="JSON 视图"
                                                        IsChecked="{Binding IsResponseJsonView, Mode=TwoWay}"
                                                        IsVisible="{Binding IsJsonResponse}"
                                                        AutomationProperties.Name="响应 JSON 视图"
                                                    />
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding FormatResponseCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Code}"
                                                            Text="格式化"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding MinifyResponseCommand}"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Shrink}"
                                                            Text="压缩"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </WrapPanel>
                                                <Border
                                                    Grid.Row="1"
                                                    IsVisible="{Binding ShowLargeResponseBanner}"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                    Padding="12,8"
                                                >
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock
                                                            Text="{Binding LargeResponseNotice}"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center"
                                                        />
                                                        <arc:Button
                                                            Grid.Column="1"
                                                            Variant="Secondary"
                                                            Size="Small"
                                                            Margin="12,0,0,0"
                                                            Click="OnOpenResponseDetailClick"
                                                        >
                                                            <controls:IconLabel
                                                                Icon="{x:Static arc:ArcIcons.Expand}"
                                                                Text="查看完整响应"
                                                                IconSize="13"
                                                            />
                                                        </arc:Button>
                                                    </Grid>
                                                </Border>
                                                <Border
                                                    Grid.Row="2"
                                                    Background="{arc:ArcDesignTokenResource Surface}"
                                                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                                                    BorderThickness="1"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                    ClipToBounds="True"
                                                >
                                                    <Grid ClipToBounds="True">
                                                        <arc:JsonViewer
                                                            x:Name="JsonResponseViewer"
                                                            Json="{Binding ResponseBody}"
                                                            IsVisible="{Binding ShowJsonResponse}"
                                                            ExpandDepth="2"
                                                            MaxTreeHeight="220"
                                                            BorderThickness="0"
                                                            Background="Transparent"
                                                            SearchPlaceholder="搜索键和值"
                                                            AutomationProperties.Name="JSON 响应"
                                                        />
                                                        <ScrollViewer
                                                            x:Name="ResponseRawScroll"
                                                            IsVisible="{Binding ShowRawResponse}"
                                                            HorizontalScrollBarVisibility="Auto"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalContentAlignment="Top"
                                                            AutomationProperties.Name="响应原始文本"
                                                        >
                                                            <SelectableTextBlock
                                                                Text="{Binding ResponseBody}"
                                                                Width="{Binding ResponseTextWidth}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Focusable="True"
                                                                Cursor="IBeam"
                                                                SelectionBrush="{arc:ArcDesignTokenResource Accent}"
                                                                SelectionForegroundBrush="{arc:ArcDesignTokenResource AccentForeground}"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="NoWrap"
                                                                Margin="8"
                                                            />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </arc:TabItem>

                                        <arc:TabItem Header="响应头">
                                            <arc:ScrollArea Margin="0,6,0,0">
                                                <ItemsControl
                                                    ItemsSource="{Binding ResponseHeaders}"
                                                    ItemTemplate="{StaticResource ResponseHeaderTemplate}"
                                                />
                                            </arc:ScrollArea>
                                        </arc:TabItem>

                                        <arc:TabItem Header="AI 聚合">
                                            <Grid
                                                RowDefinitions="Auto,Auto,Auto,*"
                                                RowSpacing="8"
                                                Margin="0,6,0,0"
                                            >
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <arc:SegmentedControl
                                                        SelectedValue="{Binding SseViewMode, Mode=TwoWay}"
                                                        AutomationProperties.Name="AI 聚合视图"
                                                    >
                                                        <arc:SegmentedOption
                                                            Value="内容"
                                                            Label="内容"
                                                        />
                                                        <arc:SegmentedOption
                                                            Value="思考过程"
                                                            Label="思考过程"
                                                        />
                                                        <arc:SegmentedOption
                                                            Value="原始事件"
                                                            Label="原始事件"
                                                        />
                                                    </arc:SegmentedControl>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                    >
                                                        <arc:Button
                                                            Content="继续"
                                                            Variant="Secondary"
                                                            Size="Small"
                                                            Command="{Binding ResumeSseCommand}"
                                                            IsVisible="{Binding CanResumeSse}"
                                                            ToolTip.Tip="从上次事件的 Last-Event-ID 继续接收"
                                                            AutomationProperties.Name="继续接收 SSE"
                                                        />
                                                        <arc:CopyButton
                                                            Value="{Binding SseContent}"
                                                            Label="复制内容"
                                                            Variant="Plain"
                                                            IsVisible="{Binding ShowSseContent}"
                                                        />
                                                        <arc:CopyButton
                                                            Value="{Binding SseThinking}"
                                                            Label="复制思考"
                                                            Variant="Plain"
                                                            IsVisible="{Binding ShowSseThinking}"
                                                        />
                                                        <arc:CopyButton
                                                            Value="{Binding SseRaw}"
                                                            Label="复制原始流"
                                                            Variant="Plain"
                                                            IsVisible="{Binding ShowSseRaw}"
                                                        />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Text="{Binding SseSummary}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    TextWrapping="Wrap"
                                                />
                                                <WrapPanel
                                                    Grid.Row="2"
                                                    ItemSpacing="10"
                                                    LineSpacing="6"
                                                >
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding FormatSseCommand}"
                                                        IsEnabled="{Binding CanTransformSse}"
                                                        ToolTip.Tip="JSON/XML 格式化；文本整理空行"
                                                        AutomationProperties.Name="格式化 AI 聚合内容"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Code}"
                                                            Text="格式化"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                    <arc:Button
                                                        Variant="Ghost"
                                                        Size="Small"
                                                        Command="{Binding MinifySseCommand}"
                                                        IsEnabled="{Binding CanTransformSse}"
                                                        ToolTip.Tip="JSON/XML 压成单行；文本移除空行和行尾空白"
                                                        AutomationProperties.Name="压缩 AI 聚合内容"
                                                    >
                                                        <controls:IconLabel
                                                            Icon="{x:Static arc:ArcIcons.Shrink}"
                                                            Text="压缩"
                                                            IconSize="13"
                                                        />
                                                    </arc:Button>
                                                </WrapPanel>
                                                <Grid Grid.Row="3">
                                                    <Grid IsVisible="{Binding ShowSseContent}">
                                                        <ScrollViewer
                                                            x:Name="SseContentScroll"
                                                            HorizontalScrollBarVisibility="Auto"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalContentAlignment="Top"
                                                            AutomationProperties.Name="AI 聚合内容"
                                                        >
                                                            <SelectableTextBlock
                                                                Text="{Binding SseContent}"
                                                                Width="{Binding SseContentTextWidth}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Focusable="True"
                                                                Cursor="IBeam"
                                                                SelectionBrush="{arc:ArcDesignTokenResource Accent}"
                                                                SelectionForegroundBrush="{arc:ArcDesignTokenResource AccentForeground}"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="NoWrap"
                                                                Margin="8"
                                                            />
                                                        </ScrollViewer>
                                                        <TextBlock
                                                            Text="没有解析到 content；可切换到「原始事件」查看推送内容。"
                                                            IsVisible="{Binding !HasSseContent}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        />
                                                    </Grid>
                                                    <Grid IsVisible="{Binding ShowSseThinking}">
                                                        <ScrollViewer
                                                            x:Name="SseThinkingScroll"
                                                            HorizontalScrollBarVisibility="Auto"
                                                            VerticalScrollBarVisibility="Auto"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalContentAlignment="Top"
                                                            AutomationProperties.Name="AI 聚合思考过程"
                                                        >
                                                            <SelectableTextBlock
                                                                Text="{Binding SseThinking}"
                                                                Width="{Binding SseThinkingTextWidth}"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top"
                                                                Focusable="True"
                                                                Cursor="IBeam"
                                                                SelectionBrush="{arc:ArcDesignTokenResource Accent}"
                                                                SelectionForegroundBrush="{arc:ArcDesignTokenResource AccentForeground}"
                                                                FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextWrapping="NoWrap"
                                                                Margin="8"
                                                            />
                                                        </ScrollViewer>
                                                        <TextBlock
                                                            Text="没有解析到 thinking；可切换到「原始事件」查看推送内容。"
                                                            IsVisible="{Binding !HasSseThinking}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                        />
                                                    </Grid>
                                                    <ScrollViewer
                                                        x:Name="SseRawScroll"
                                                        IsVisible="{Binding ShowSseRaw}"
                                                        HorizontalScrollBarVisibility="Auto"
                                                        VerticalScrollBarVisibility="Auto"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Top"
                                                        AutomationProperties.Name="AI 聚合原始事件"
                                                    >
                                                        <SelectableTextBlock
                                                            Text="{Binding SseRaw}"
                                                            Width="{Binding SseRawTextWidth}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top"
                                                            Focusable="True"
                                                            Cursor="IBeam"
                                                            SelectionBrush="{arc:ArcDesignTokenResource Accent}"
                                                            SelectionForegroundBrush="{arc:ArcDesignTokenResource AccentForeground}"
                                                            FontFamily="{DynamicResource PostSharpCodeFont}"
                                                            FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                            TextWrapping="NoWrap"
                                                            Margin="8"
                                                        />
                                                    </ScrollViewer>
                                                    <arc:EmptyState
                                                        IsVisible="{Binding !IsSseResponse}"
                                                        Title="当前响应不是 SSE"
                                                        Description="发送 text/event-stream 请求后，这里会聚合 thinking 和 content；原始事件仍可在响应体查看。"
                                                        Label="AI 输出"
                                                    />
                                                </Grid>
                                            </Grid>
                                        </arc:TabItem>
                                    </arc:Tabs>

                                    <arc:EmptyState
                                        Grid.Row="1"
                                        IsVisible="{Binding ShowEmptyResponse}"
                                        Label="响应"
                                        Title="还没有响应"
                                        Description="按 Ctrl+Enter 或点击发送。默认示例请求已指向内置 Mock 服务，不需要联网。"
                                        VerticalAlignment="Center"
                                    />
                                </Grid>

                                <Grid
                                    Grid.Row="5"
                                    Grid.ColumnSpan="3"
                                    Margin="0,8,0,0"
                                    ColumnDefinitions="*,Auto"
                                >
                                    <StackPanel
                                        IsVisible="{Binding Import.IsBackgroundStatusVisible}"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0"
                                    >
                                        <ProgressBar
                                            Width="160"
                                            Height="6"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding Import.BackgroundProgress}"
                                            IsIndeterminate="{Binding Import.IsBackgroundProgressIndeterminate}"
                                            Foreground="{arc:ArcDesignTokenResource Accent}"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="导入导出进度"
                                        />
                                        <TextBlock
                                            IsVisible="{Binding Import.HasNoImportError}"
                                            Text="{Binding Import.ImportStatus}"
                                            MaxWidth="420"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Import.ImportStatus}"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBlock
                                            IsVisible="{Binding Import.HasImportError}"
                                            Text="{Binding Import.ImportStatus}"
                                            MaxWidth="420"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource Danger}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Import.ImportStatus}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:Button
                                            Content="取消导入"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding Import.CancelImportCommand}"
                                            IsVisible="{Binding Import.IsImporting}"
                                            ToolTip.Tip="取消当前后台导入"
                                            AutomationProperties.Name="取消导入"
                                        />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                    >
                                        <arc:Button
                                            Variant="Secondary"
                                            Size="Small"
                                            Command="{Binding UpdateCommand}"
                                            IsEnabled="{Binding !IsCheckingUpdates}"
                                            ToolTip.Tip="{Binding UpdateButtonTooltip}"
                                            AutomationProperties.Name="{Binding UpdateButtonText}"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                                Text="{Binding UpdateButtonText}"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <Border
                                            Width="1"
                                            Height="18"
                                            Margin="2,0"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                        />
                                        <TextBlock
                                            Text="布局"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:SegmentedControl
                                            SelectedValue="{Binding WorkspaceLayoutMode, Mode=TwoWay}"
                                            AutomationProperties.Name="请求与响应布局"
                                            ToolTip.Tip="切换请求与响应的左右或上下布局"
                                        >
                                            <arc:SegmentedOption Value="SideBySide" Label="左右" />
                                            <arc:SegmentedOption Value="Stacked" Label="上下" />
                                        </arc:SegmentedControl>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- In-window context menu for the collection tree; keeps the Arc styling and never leaves the window. -->
                    <Panel x:Name="TreeMenuOverlay" IsVisible="False">
                        <Border Background="Transparent" PointerPressed="OnTreeMenuDismiss" />
                        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border
                                x:Name="TreeMenuCard"
                                Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                                Padding="6"
                            >
                                <StackPanel Width="190" Spacing="2">
                                    <StackPanel x:Name="TreeMenuCollectionSection" Spacing="2">
                                        <arc:Button
                                            x:Name="TreeMenuNewRequestButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuNewRequestClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.FilePlus}"
                                                Text="新建请求"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            x:Name="TreeMenuNewSubcollectionButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuNewSubcollectionClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Folder}"
                                                Text="新建二级集合"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            x:Name="TreeMenuSuiteButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuSuiteClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.ListChecks}"
                                                Text="套件设置"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            IsVisible="{Binding HasOpenApiSourceSelected}"
                                            Command="{Binding SyncSelectedOpenApiCommand}"
                                            Click="OnTreeMenuItemClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                                Text="同步 OpenAPI"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            IsVisible="{Binding HasOpenApiSourceSelected}"
                                            Command="{Binding ToggleSelectedOpenApiAutoSyncCommand}"
                                            Click="OnTreeMenuItemClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                                Text="{Binding OpenApiAutoSyncActionText}"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuAuthorizationClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Key}"
                                                Text="授权配置"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuExportPostmanClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.ArrowDown}"
                                                Text="导出 Postman"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <Border
                                            Height="1"
                                            Margin="6,4"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                        />
                                    </StackPanel>
                                    <StackPanel x:Name="TreeMenuRequestSection" Spacing="2">
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            IsVisible="{Binding IsRequestSelected}"
                                            Command="{Binding DuplicateSelectedRequestCommand}"
                                            Click="OnTreeMenuItemClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Copy}"
                                                Text="复制请求"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            IsVisible="{Binding IsRequestSelected}"
                                            Command="{Binding CopySelectedUrlCommand}"
                                            Click="OnTreeMenuItemClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Link2}"
                                                Text="复制 URL"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            IsVisible="{Binding IsRequestSelected}"
                                            Click="OnTreeMenuAuthorizationClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.Key}"
                                                Text="授权配置"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <Border
                                            Height="1"
                                            Margin="6,4"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                        />
                                    </StackPanel>
                                    <StackPanel x:Name="TreeMenuOrderSection" Spacing="2">
                                        <arc:Button
                                            x:Name="TreeMenuMoveUpButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuMoveUpClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.ArrowUp}"
                                                Text="上移"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <arc:Button
                                            x:Name="TreeMenuMoveDownButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="12,0"
                                            Click="OnTreeMenuMoveDownClick"
                                        >
                                            <controls:IconLabel
                                                Icon="{x:Static arc:ArcIcons.ArrowDown}"
                                                Text="下移"
                                                IconSize="13"
                                            />
                                        </arc:Button>
                                        <Border
                                            Height="1"
                                            Margin="6,4"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                        />
                                    </StackPanel>
                                    <arc:Button
                                        x:Name="TreeMenuFavoriteButton"
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        Click="OnTreeMenuFavoriteClick"
                                    >
                                        <controls:IconLabel
                                            x:Name="TreeMenuFavoriteLabel"
                                            Icon="{x:Static arc:ArcIcons.Star}"
                                            Text="收藏"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        IsVisible="{Binding HasSelection}"
                                        Command="{Binding RenameSelectedCommand}"
                                        Click="OnTreeMenuItemClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Pencil}"
                                            Text="重命名"
                                            IconSize="13"
                                        />
                                    </arc:Button>
                                    <arc:Button
                                        Variant="Ghost"
                                        Size="Small"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="12,0"
                                        IsVisible="{Binding HasSelection}"
                                        Command="{Binding DeleteSelectedCommand}"
                                        Click="OnTreeMenuItemClick"
                                    >
                                        <controls:IconLabel
                                            Icon="{x:Static arc:ArcIcons.Trash2}"
                                            Text="删除"
                                            IconSize="13"
                                            TextForeground="{arc:ArcDesignTokenResource Danger}"
                                            IconForeground="{arc:ArcDesignTokenResource Danger}"
                                        />
                                    </arc:Button>
                                </StackPanel>
                            </Border>
                        </Canvas>
                    </Panel>

                    <!-- Management layer: AI audit trail and automation suites. -->
                    <Panel x:Name="ManagementHost" IsVisible="{Binding IsManagementOpen}" />

                    <!-- Overlays -->
                    <arc:Toast
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,24,24"
                        Width="320"
                        Duration="0:0:3"
                        Title="{Binding ToastTitle}"
                        IsOpen="{Binding IsToastOpen, Mode=TwoWay}"
                    />

                    <arc:Dialog
                        x:Name="ImportDialog"
                        IsOpen="{Binding Import.IsImportDialogOpen, Mode=TwoWay}"
                        Title="导入 / 导出"
                        Description="支持 OpenAPI、Postman、cURL、HAR、Insomnia、Hoppscotch；导入成功后可以继续手工调整请求。"
                        Size="Large"
                        Opened="OnImportDialogOpened"
                    >
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel Grid.Row="0" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        Text="导入来源"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                        VerticalAlignment="Center"
                                    />
                                    <arc:Button
                                        Grid.Column="1"
                                        Content="{Binding Import.ImportSourceToggleLabel}"
                                        Variant="Ghost"
                                        Size="Small"
                                        Command="{Binding Import.ToggleImportSourceCommand}"
                                        AutomationProperties.Name="展开或收起导入来源"
                                    />
                                </Grid>
                                <arc:RadioCards
                                    SelectedValue="{Binding Import.ImportSource, Mode=TwoWay}"
                                    MinColumnWidth="150"
                                    IsVisible="{Binding Import.IsImportSourceExpanded}"
                                    AutomationProperties.Name="导入来源"
                                >
                                    <arc:RadioCardOption
                                        Value="OpenApi"
                                        Label="OpenAPI"
                                        Description="Swagger · Knife4j"
                                    />
                                    <arc:RadioCardOption
                                        Value="PostmanCollection"
                                        Label="Postman"
                                        Description="Collection · 文件夹 / 认证"
                                    />
                                    <arc:RadioCardOption
                                        Value="PostmanEnvironment"
                                        Label="Environment"
                                        Description="Postman 环境变量"
                                    />
                                    <arc:RadioCardOption
                                        Value="Curl"
                                        Label="cURL"
                                        Description="bash / PowerShell"
                                    />
                                    <arc:RadioCardOption
                                        Value="Har"
                                        Label="HAR"
                                        Description="浏览器 / Apifox"
                                    />
                                    <arc:RadioCardOption
                                        Value="Insomnia"
                                        Label="Insomnia"
                                        Description="V4 JSON · 请求组 / 环境"
                                    />
                                    <arc:RadioCardOption
                                        Value="Hoppscotch"
                                        Label="Hoppscotch"
                                        Description="Collection JSON"
                                    />
                                    <arc:RadioCardOption
                                        Value="OtherTools"
                                        Label="其他工具"
                                        Description="YApi / ApiPost / Eolink 指南"
                                    />
                                    <arc:RadioCardOption
                                        Value="Apifox"
                                        Label="Apifox"
                                        Description="Postman / OpenAPI / HAR"
                                    />
                                </arc:RadioCards>
                            </StackPanel>

                            <Panel Grid.Row="1">
                                <StackPanel
                                    IsVisible="{Binding Import.IsOpenApiImport}"
                                    Spacing="12"
                                >
                                    <TextBlock
                                        Text="从 URL 导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <arc:Input
                                            Label="文档 URL"
                                            Text="{Binding Import.ImportUrl, Mode=TwoWay}"
                                            Placeholder="https://petstore3.swagger.io/api/v3/openapi.json"
                                            AutomationProperties.Name="OpenAPI 文档地址"
                                        />
                                        <arc:Button
                                            Grid.Column="1"
                                            Content="下载并导入"
                                            Variant="Primary"
                                            VerticalAlignment="Bottom"
                                            Command="{Binding Import.ImportFromUrlCommand}"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            IsLoading="{Binding Import.IsImporting}"
                                            AutomationProperties.Name="下载并导入 OpenAPI 文档"
                                        />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="填入 springdoc / Knife4j 地址"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding Import.FillSpringDocUrlCommand}"
                                            AutomationProperties.Name="填入 springdoc 或 Knife4j 地址"
                                        />
                                        <TextBlock
                                            Text="常见地址为 http://服务地址:端口/v3/api-docs"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                        />
                                    </StackPanel>

                                    <StackPanel
                                        IsVisible="{Binding Import.HasPendingOpenApiImport}"
                                        Spacing="8"
                                    >
                                        <arc:Select
                                            Label="服务器"
                                            ItemsSource="{Binding Import.OpenApiServers}"
                                            SelectedItem="{Binding Import.SelectedOpenApiServer, Mode=TwoWay}"
                                            AutomationProperties.Name="OpenAPI 服务器"
                                        />
                                        <arc:Button
                                            Content="导入所选服务器"
                                            Variant="Primary"
                                            HorizontalAlignment="Left"
                                            Command="{Binding Import.ConfirmOpenApiImportCommand}"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            AutomationProperties.Name="导入所选服务器的 OpenAPI 请求"
                                        />
                                    </StackPanel>

                                    <Border
                                        Height="1"
                                        Background="{arc:ArcDesignTokenResource BorderSubtle}"
                                    />

                                    <TextBlock
                                        Text="从文件导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <arc:Button
                                            Content="选择 JSON / YAML 文件…"
                                            Variant="Secondary"
                                            Click="OnPickOpenApiFileClick"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            AutomationProperties.Name="选择 OpenAPI 文件"
                                        />
                                        <TextBlock
                                            Text="支持 .json、.yaml、.yml，也兼容 Swagger 2.0。"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.IsPostmanCollectionImport}"
                                    Spacing="10"
                                >
                                    <TextBlock
                                        Text="从 Postman 迁移"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="支持嵌套文件夹、查询参数、请求头、Bearer / Basic / API Key 认证、raw / urlencoded / formdata 请求体和集合变量。脚本与测试不会执行。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <TextBlock
                                        Text="Apifox 迁移：在 Apifox「项目设置 → 导出数据」选择 Postman 或 OpenAPI，再在这里导入。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="选择 Collection 文件…"
                                            Variant="Primary"
                                            Click="OnPickPostmanFileClick"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            IsLoading="{Binding Import.IsImporting}"
                                            AutomationProperties.Name="选择 Postman Collection 文件"
                                        />
                                        <arc:Button
                                            Content="导出当前集合…"
                                            Variant="Secondary"
                                            Click="OnExportPostmanClick"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            AutomationProperties.Name="导出 Postman Collection"
                                        />
                                        <TextBlock
                                            Text="导出选中集合；未选中时导出整个工作区。"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                        />
                                    </StackPanel>
                                    <arc:Textarea
                                        Height="124"
                                        Margin="0,0,0,8"
                                        Label="或者粘贴 Collection JSON"
                                        Text="{Binding Import.PostmanJson, Mode=TwoWay}"
                                        Placeholder="粘贴 Postman Collection v2.1 JSON"
                                        FrameHeight="100"
                                        IsResizable="False"
                                        AutomationProperties.Name="Postman Collection JSON"
                                    />
                                    <arc:Button
                                        Content="导入粘贴内容"
                                        Variant="Primary"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Import.ImportPostmanTextCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="导入粘贴的 Postman Collection"
                                    />
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.IsPostmanEnvironmentImport}"
                                    Spacing="10"
                                >
                                    <TextBlock
                                        Text="从 Postman 环境文件导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="选择 Postman Environment JSON。变量会创建或合并到同名环境，并自动激活；重复变量保留第一个值。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <arc:Button
                                        Content="选择环境 JSON 文件…"
                                        Variant="Primary"
                                        HorizontalAlignment="Left"
                                        Click="OnPickPostmanEnvironmentFileClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="导入 Postman 环境文件"
                                    />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Import.IsCurlImport}" Spacing="10">
                                    <TextBlock
                                        Text="从 cURL 导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="支持 Postman、浏览器或 PostSharp 生成的 bash 风格命令，以及 Invoke-RestMethod / Invoke-WebRequest PowerShell 命令。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <arc:Textarea
                                        Height="124"
                                        Margin="0,0,0,8"
                                        Label="cURL 命令"
                                        Text="{Binding Import.CurlCommand, Mode=TwoWay}"
                                        Placeholder="curl -X POST 'https://api.example.com/health' -H 'Accept: application/json'"
                                        FrameHeight="100"
                                        IsResizable="False"
                                        AutomationProperties.Name="cURL 命令"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="导入 cURL"
                                            Variant="Primary"
                                            Command="{Binding Import.ImportCurlCommand}"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            IsLoading="{Binding Import.IsImporting}"
                                            AutomationProperties.Name="导入 cURL 命令"
                                        />
                                        <arc:Button
                                            Content="保存当前请求 cURL…"
                                            Variant="Secondary"
                                            Click="OnExportCurlClick"
                                            IsEnabled="{Binding CanExportCurl}"
                                            AutomationProperties.Name="保存当前请求 cURL"
                                        />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding Import.IsHarImport}" Spacing="10">
                                    <TextBlock
                                        Text="从 HAR 导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="支持浏览器、Postman、Apifox 导出的 HAR 1.2。默认只导入 XHR / Fetch；响应内容、脚本和二进制文件内容不会导入。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <arc:Button
                                            Content="选择 HAR 文件…"
                                            Variant="Primary"
                                            Click="OnPickHarFileClick"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            IsLoading="{Binding Import.IsImporting}"
                                            AutomationProperties.Name="选择 HAR 文件"
                                        />
                                        <arc:Checkbox
                                            IsChecked="{Binding Import.HarIncludeStaticResources, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="包含静态资源"
                                        />
                                        <TextBlock
                                            Text="包含静态资源"
                                            FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            VerticalAlignment="Center"
                                        />
                                    </StackPanel>
                                    <arc:Textarea
                                        Height="124"
                                        Margin="0,0,0,8"
                                        Label="或者粘贴 HAR JSON"
                                        Text="{Binding Import.HarJson, Mode=TwoWay}"
                                        Placeholder="粘贴 HAR 1.2 JSON"
                                        FrameHeight="100"
                                        IsResizable="False"
                                        AutomationProperties.Name="HAR JSON"
                                    />
                                    <arc:Button
                                        Content="导入粘贴的 HAR"
                                        Variant="Primary"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Import.ImportHarTextCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="导入粘贴的 HAR"
                                    />
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.IsInsomniaImport}"
                                    Spacing="10"
                                >
                                    <TextBlock
                                        Text="从 Insomnia V4 导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="支持 Insomnia v4 JSON 导出：请求组、请求、环境变量和常见认证。Insomnia v5 YAML 请先导出为 v4 JSON；脚本不会执行。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="选择 Insomnia JSON 文件…"
                                            Variant="Primary"
                                            Click="OnPickInsomniaFileClick"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            IsLoading="{Binding Import.IsImporting}"
                                            AutomationProperties.Name="选择 Insomnia 导出文件"
                                        />
                                        <TextBlock
                                            Text="Insomnia → Collection → Export → Insomnia v4 JSON"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                        />
                                    </StackPanel>
                                    <arc:Textarea
                                        Height="124"
                                        Margin="0,0,0,8"
                                        Label="或者粘贴 Insomnia JSON"
                                        Text="{Binding Import.InsomniaJson, Mode=TwoWay}"
                                        Placeholder="粘贴 Insomnia v4 JSON"
                                        FrameHeight="100"
                                        IsResizable="False"
                                        AutomationProperties.Name="Insomnia JSON"
                                    />
                                    <arc:Button
                                        Content="导入粘贴的 Insomnia"
                                        Variant="Primary"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Import.ImportInsomniaTextCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="导入粘贴的 Insomnia"
                                    />
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.IsHoppscotchImport}"
                                    Spacing="10"
                                >
                                    <TextBlock
                                        Text="从 Hoppscotch 导入"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="支持 Hoppscotch Collection JSON：文件夹、params、headers、body 和基础认证。脚本、测试和 multipart 文件内容不会执行或还原。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="选择 Hoppscotch JSON 文件…"
                                            Variant="Primary"
                                            Click="OnPickHoppscotchFileClick"
                                            IsEnabled="{Binding Import.IsNotImporting}"
                                            IsLoading="{Binding Import.IsImporting}"
                                            AutomationProperties.Name="选择 Hoppscotch Collection 文件"
                                        />
                                        <TextBlock
                                            Text="Hoppscotch → Collection → Export → JSON"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap"
                                        />
                                    </StackPanel>
                                    <arc:Textarea
                                        Height="124"
                                        Margin="0,0,0,8"
                                        Label="或者粘贴 Hoppscotch JSON"
                                        Text="{Binding Import.HoppscotchJson, Mode=TwoWay}"
                                        Placeholder="粘贴 Hoppscotch Collection JSON"
                                        FrameHeight="100"
                                        IsResizable="False"
                                        AutomationProperties.Name="Hoppscotch JSON"
                                    />
                                    <arc:Button
                                        Content="导入粘贴的 Hoppscotch"
                                        Variant="Primary"
                                        HorizontalAlignment="Left"
                                        Command="{Binding Import.ImportHoppscotchTextCommand}"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        IsLoading="{Binding Import.IsImporting}"
                                        AutomationProperties.Name="导入粘贴的 Hoppscotch"
                                    />
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.IsOtherToolsImport}"
                                    Spacing="10"
                                >
                                    <TextBlock
                                        Text="YApi / ApiPost / Eolink"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="这几个工具都支持导出 OpenAPI 或 Postman Collection。建议先在原工具导出，再切换到对应导入器，避免维护脆弱的私有格式解析。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="用 OpenAPI 导入"
                                            Variant="Primary"
                                            Command="{Binding Import.SelectImportSourceCommand}"
                                            CommandParameter="OpenApi"
                                            AutomationProperties.Name="切换到 OpenAPI 导入"
                                        />
                                        <arc:Button
                                            Content="用 Postman 导入"
                                            Variant="Secondary"
                                            Command="{Binding Import.SelectImportSourceCommand}"
                                            CommandParameter="PostmanCollection"
                                            AutomationProperties.Name="切换到 Postman Collection 导入"
                                        />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    IsVisible="{Binding Import.IsApifoxImport}"
                                    Spacing="10"
                                >
                                    <TextBlock
                                        Text="从 Apifox 迁移"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        FontWeight="Medium"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    />
                                    <TextBlock
                                        Text="Apifox 原生格式暂未直接解析。推荐在 Apifox「项目设置 → 导出数据」选择 Postman 或 OpenAPI；浏览器/Apifox 的 HAR 也可以直接导入。"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        TextWrapping="Wrap"
                                    />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button
                                            Content="用 Postman 导入"
                                            Variant="Primary"
                                            Command="{Binding Import.SelectImportSourceCommand}"
                                            CommandParameter="PostmanCollection"
                                            AutomationProperties.Name="切换到 Postman Collection 导入"
                                        />
                                        <arc:Button
                                            Content="用 OpenAPI 导入"
                                            Variant="Secondary"
                                            Command="{Binding Import.SelectImportSourceCommand}"
                                            CommandParameter="OpenApi"
                                            AutomationProperties.Name="切换到 OpenAPI 导入"
                                        />
                                        <arc:Button
                                            Content="用 HAR 导入"
                                            Variant="Secondary"
                                            Command="{Binding Import.SelectImportSourceCommand}"
                                            CommandParameter="Har"
                                            AutomationProperties.Name="切换到 HAR 导入"
                                        />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>

                            <Grid Grid.Row="2" MinHeight="40">
                                <TextBlock
                                    IsVisible="{Binding Import.HasNoImportError}"
                                    Text="{Binding Import.ImportStatus}"
                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                    TextWrapping="Wrap"
                                />
                                <TextBlock
                                    IsVisible="{Binding Import.HasImportError}"
                                    Text="{Binding Import.ImportStatus}"
                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                    Foreground="{arc:ArcDesignTokenResource Danger}"
                                    TextWrapping="Wrap"
                                />
                            </Grid>

                            <Border
                                Grid.Row="3"
                                IsVisible="{Binding Import.HasImportReport}"
                                BorderBrush="{arc:ArcDesignTokenResource Success}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                Padding="12"
                            >
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Text="导入结果"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            FontWeight="Medium"
                                            Foreground="{arc:ArcDesignTokenResource Success}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:Button
                                            Grid.Column="1"
                                            Content="{Binding Import.ImportReportToggleLabel}"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding Import.ToggleImportReportCommand}"
                                            AutomationProperties.Name="展开或收起导入结果"
                                        />
                                    </Grid>
                                    <arc:ScrollArea
                                        Height="80"
                                        IsVisible="{Binding Import.IsImportReportExpanded}"
                                    >
                                        <ItemsControl ItemsSource="{Binding Import.ImportReport}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Text="{Binding}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        TextWrapping="Wrap"
                                                        Margin="0,0,0,4"
                                                    />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="4"
                                IsVisible="{Binding Import.HasImportWarnings}"
                                BorderBrush="{arc:ArcDesignTokenResource Warning}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                Padding="12"
                            >
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Text="兼容性提示"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            FontWeight="Medium"
                                            Foreground="{arc:ArcDesignTokenResource Warning}"
                                            VerticalAlignment="Center"
                                        />
                                        <arc:Button
                                            Grid.Column="1"
                                            Content="{Binding Import.ImportWarningsToggleLabel}"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding Import.ToggleImportWarningsCommand}"
                                            AutomationProperties.Name="展开或收起兼容性提示"
                                        />
                                    </Grid>
                                    <arc:ScrollArea
                                        Height="80"
                                        IsVisible="{Binding Import.IsImportWarningsExpanded}"
                                    >
                                        <ItemsControl ItemsSource="{Binding Import.ImportWarnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Text="{Binding}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                        TextWrapping="Wrap"
                                                        Margin="0,0,0,4"
                                                    />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <arc:Dialog.Actions>
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                >
                                    <arc:Button
                                        Content="批量导入文件…"
                                        Variant="Secondary"
                                        Click="OnPickBatchImportFilesClick"
                                        IsEnabled="{Binding Import.IsNotImporting}"
                                        AutomationProperties.Name="批量导入文件"
                                    />
                                    <TextBlock
                                        Text="可多选，自动识别格式"
                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                        VerticalAlignment="Center"
                                    />
                                </StackPanel>
                                <arc:Button
                                    Grid.Column="1"
                                    Content="{Binding Import.CloseImportDialogLabel}"
                                    Variant="Secondary"
                                    Command="{Binding Import.CloseImportDialogCommand}"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="关闭窗口不会取消正在执行的导入"
                                    AutomationProperties.Name="关闭导入窗口"
                                />
                            </Grid>
                        </arc:Dialog.Actions>
                    </arc:Dialog>

                    <Panel x:Name="AuxiliaryDialogsHost" />
                </Panel>
            </LayoutTransformControl>
        </VisualLayerManager>
    </Panel>
</Window>
