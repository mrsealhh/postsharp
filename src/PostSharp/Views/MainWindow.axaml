<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:models="using:PostSharp.Models"
        xmlns:vm="using:PostSharp.ViewModels"
        x:Class="PostSharp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PostSharp · 轻量接口调试"
        Width="1400"
        Height="900"
        MinWidth="1000"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{arc:ArcDesignTokenResource Background}">

    <Window.Resources>
        <DataTemplate x:Key="KeyValueRowTemplate" x:DataType="models:KeyValueRow">
            <Grid ColumnDefinitions="44,*,*,34" Margin="0,0,0,6">
                <arc:Checkbox Grid.Column="0"
                              IsChecked="{Binding IsEnabled}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="启用该行" />
                <arc:Input Grid.Column="1"
                           Text="{Binding Key}"
                           Placeholder="键"
                           IsLabelVisible="False"
                           Size="Small"
                           Margin="0,0,8,0" />
                <arc:Input Grid.Column="2"
                           Text="{Binding Value}"
                           Placeholder="值"
                           IsLabelVisible="False"
                           Size="Small"
                           Margin="0,0,8,0" />
                <arc:Button Grid.Column="3"
                            Content="×"
                            Variant="Ghost"
                            Size="Small"
                            Padding="0"
                            Width="34"
                            Command="{Binding RemoveCommand}"
                            AutomationProperties.Name="删除该行" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryRowTemplate" x:DataType="models:HistoryEntry">
            <Grid ColumnDefinitions="*,30" ColumnSpacing="2" Margin="0,0,0,2">
                <arc:Button Variant="Ghost"
                            Size="Small"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="8,6"
                            Command="{Binding OpenCommand}">
                    <Grid ColumnDefinitions="56,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="2">
                        <arc:Badge Grid.RowSpan="2"
                                   Content="{Binding Method}"
                                   Tone="Neutral"
                                   Size="Small"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   ToolTip.Tip="{Binding Method}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Name}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding StatusLabel}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                        <TextBlock Grid.Column="1"
                                   Grid.Row="1"
                                   Text="{Binding Url}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Url}"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2"
                                   Grid.Row="1"
                                   Text="{Binding DisplayTime}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"
                                   ToolTip.Tip="{Binding TimestampText}" />
                    </Grid>
                </arc:Button>
                <arc:Button Grid.Column="1"
                            Variant="Ghost"
                            Size="Small"
                            Padding="0"
                            Height="32"
                            VerticalAlignment="Center"
                            Command="{Binding DeleteCommand}"
                            ToolTip.Tip="移入回收站"
                            AutomationProperties.Name="删除历史记录">
                    <TextBlock Text="×"
                               FontSize="16"
                               Foreground="{arc:ArcDesignTokenResource Danger}" />
                </arc:Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ResponseHeaderTemplate" x:DataType="models:ResponseHeaderView">
            <Grid ColumnDefinitions="210,*" Margin="0,0,0,8">
                <TextBlock Text="{Binding Key}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           TextWrapping="Wrap" />
                <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding Value}"
                                     FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                     FontFamily="{DynamicResource PostSharpCodeFont}"
                                     Foreground="{arc:ArcDesignTokenResource Foreground}"
                                     TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource PostSharpBodyFont}" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddRequestCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding FormatBodyCommand}" />
    </Window.KeyBindings>

    <Panel x:Name="RootPanel">
        <VisualLayerManager EnableOverlayLayer="True">
            <DockPanel LastChildFill="True">
            <!-- Product bar -->
            <Border DockPanel.Dock="Top"
                    Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Width="42"
                               Height="42"
                               Source="avares://PostSharp/Assets/logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock Text="PostSharp"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="轻量接口调试"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <arc:Select Width="210"
                                    ItemsSource="{Binding Environments}"
                                    SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}"
                                    Placeholder="选择环境"
                                    AutomationProperties.Name="当前环境" />
                        <arc:Button Content="环境变量"
                                    Variant="Secondary"
                                    Command="{Binding OpenEnvironmentDialogCommand}" />
                        <arc:Button Content="MCP 接入"
                                    Variant="Secondary"
                                    Command="{Binding #McpDialog.OpenCommand}" />
                        <arc:Button Content="管理层"
                                    Variant="Secondary"
                                    Command="{Binding OpenManagementCommand}" />
                        <arc:ThemeSwitcher Variant="Rise" IsIconOnly="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Left workspace -->
            <Border DockPanel.Dock="Left"
                    Width="300"
                    Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="12" RowDefinitions="Auto,Auto,3*,Auto,Auto,2*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Text="集合"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   FontWeight="Medium"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   VerticalAlignment="Center" />
                        <arc:Button Grid.Column="1"
                                    Content="新建集合"
                                    Variant="Ghost"
                                    Size="Small"
                                    Padding="8,0"
                                    Command="{Binding AddCollectionCommand}" />
                    </Grid>

                    <arc:SearchField Grid.Row="1"
                                     Margin="0,8,0,0"
                                     Placeholder="搜索集合与请求"
                                     Text="{Binding FilterText, Mode=TwoWay}"
                                     AutomationProperties.Name="搜索集合与请求" />

                    <Grid Grid.Row="2" Margin="0,8,0,8">
                        <arc:TreeView x:Name="CollectionTree"
                                      AutomationProperties.Name="集合与请求"
                                      ShowIcons="True"
                                      SelectionChanged="OnCollectionTreeSelectionChanged"
                                      ItemExpanded="OnCollectionTreeItemExpanded"
                                      ItemCollapsed="OnCollectionTreeItemCollapsed" />
                        <TextBlock Text="没有匹配的请求"
                                   IsVisible="{Binding TreeIsEmpty}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,16,0,0"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                        <arc:Button Content="新建请求"
                                    Variant="Secondary"
                                    Size="Small"
                                    Command="{Binding AddRequestCommand}" />
                        <arc:Button Content="重命名"
                                    Variant="Ghost"
                                    Size="Small"
                                    Command="{Binding RenameSelectedCommand}" />
                        <arc:Button Content="删除"
                                    Variant="Danger"
                                    Size="Small"
                                    Command="{Binding DeleteSelectedCommand}" />
                    </StackPanel>

                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,0,6">
                        <TextBlock Text="历史记录"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   FontWeight="Medium"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   VerticalAlignment="Center" />
                        <arc:Button Grid.Column="1"
                                    Content="{Binding RecycleBinLabel}"
                                    Variant="Ghost"
                                    Size="Small"
                                    Padding="6,0"
                                    Command="{Binding OpenHistoryTrashCommand}" />
                        <arc:Button Grid.Column="2"
                                    Content="清空"
                                    Variant="Ghost"
                                    Size="Small"
                                    Padding="6,0"
                                    Command="{Binding ClearHistoryCommand}" />
                    </Grid>

                    <arc:ScrollArea Grid.Row="5" Margin="0,0,0,10" MinHeight="110">
                        <StackPanel Spacing="4">
                            <TextBlock Text="发送请求后会出现在这里。"
                                       IsVisible="{Binding !HasHistory}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       Margin="2,4,0,0" />
                            <ItemsControl ItemsSource="{Binding History}"
                                          ItemTemplate="{StaticResource HistoryRowTemplate}" />
                        </StackPanel>
                    </arc:ScrollArea>

                    <Border Grid.Row="6"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                            Padding="10,8">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="8"
                                         Height="8"
                                         VerticalAlignment="Center"
                                         Fill="{arc:ArcDesignTokenResource Success}" />
                                <TextBlock Text="{Binding MockStatus}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Text="{Binding McpEndpoint}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor and response -->
            <Grid Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="260" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <arc:Input Width="240"
                                   Size="Small"
                                   IsLabelVisible="False"
                                   Placeholder="请求名称"
                                   Text="{Binding Editing.Name, Mode=TwoWay}"
                                   AutomationProperties.Name="请求名称" />
                        <TextBlock Text="{Binding EditorHint}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <arc:Button Grid.Column="1"
                                Content="保存"
                                Variant="Secondary"
                                Size="Small"
                                Command="{Binding SaveCommand}" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                    <arc:Select Grid.Column="0"
                                Width="130"
                                MinWidth="120"
                                HorizontalAlignment="Left"
                                Margin="0,0,10,0"
                                ItemsSource="{Binding Methods}"
                                SelectedItem="{Binding Editing.Method, Mode=TwoWay}"
                                Placeholder="方法"
                                AutomationProperties.Name="请求方法" />
                    <arc:Input Grid.Column="1"
                               Margin="0,0,10,0"
                               Placeholder="https://api.example.com/users"
                               IsLabelVisible="False"
                               Text="{Binding Editing.Url, Mode=TwoWay}"
                               FontFamily="{DynamicResource PostSharpCodeFont}"
                               AutomationProperties.Name="请求地址" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <arc:Button Content="发送"
                                    Variant="Primary"
                                    IsDefault="True"
                                    MinWidth="80"
                                    IsLoading="{Binding IsSending}"
                                    Command="{Binding SendCommand}" />
                        <arc:Button Content="取消"
                                    Variant="Secondary"
                                    IsVisible="{Binding IsSending}"
                                    Command="{Binding CancelSendCommand}" />
                    </StackPanel>
                </Grid>

                <arc:Tabs Grid.Row="2" AutomationProperties.Name="请求配置">
                    <arc:TabItem Header="参数">
                        <Grid RowDefinitions="Auto,*,Auto" Margin="0,6,0,0">
                            <Grid ColumnDefinitions="44,*,*,34" Margin="0,0,0,6">
                                <TextBlock Grid.Column="1"
                                           Text="键"
                                           Margin="16,0,0,0"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <TextBlock Grid.Column="2"
                                           Text="值"
                                           Margin="16,0,0,0"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </Grid>
                            <arc:ScrollArea Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding Editing.Params}"
                                              ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                            </arc:ScrollArea>
                            <TextBlock Grid.Row="2"
                                       Text="填写最后一行会自动新增一行；未启用的行不会发送。"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       Margin="0,8,0,0" />
                        </Grid>
                    </arc:TabItem>

                    <arc:TabItem Header="请求头">
                        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,6,0,0" RowSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <arc:Button Content="JSON 类型"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding AddJsonContentTypeCommand}" />
                                <arc:Button Content="Accept JSON"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding AddAcceptJsonCommand}" />
                                <arc:Button Content="Bearer Token"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding AddBearerTokenCommand}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="3">
                                <TextBlock Text="{Binding HeaderWarningText}"
                                           IsVisible="{Binding HasHeaderWarning}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource Danger}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="支持 {{变量}}；发送时自动补充 Accept: */*、User-Agent: PostSharp/0.1；请求体模式下自动补充 Content-Type。"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="2" ColumnDefinitions="44,*,*,34">
                                <TextBlock Grid.Column="1"
                                           Text="键"
                                           Margin="16,0,0,0"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <TextBlock Grid.Column="2"
                                           Text="值"
                                           Margin="16,0,0,0"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </Grid>
                            <arc:ScrollArea Grid.Row="3">
                                <ItemsControl ItemsSource="{Binding Editing.Headers}"
                                              ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                            </arc:ScrollArea>
                        </Grid>
                    </arc:TabItem>

                    <arc:TabItem Header="请求体">
                        <Grid RowDefinitions="Auto,*" Margin="0,6,0,0" RowSpacing="10">
                            <WrapPanel ItemSpacing="12" LineSpacing="8">
                                <arc:SegmentedControl SelectedValue="{Binding Editing.BodyMode, Mode=TwoWay}"
                                                      AutomationProperties.Name="请求体格式">
                                    <arc:SegmentedOption Value="None" Label="无" />
                                    <arc:SegmentedOption Value="Json" Label="JSON" />
                                    <arc:SegmentedOption Value="Text" Label="文本" />
                                    <arc:SegmentedOption Value="Multipart" Label="表单上传" />
                                </arc:SegmentedControl>
                                <arc:Switch Content="单行"
                                            IsChecked="{Binding IsBodySingleLine, Mode=TwoWay}" />
                                <arc:Button Content="格式化"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding FormatBodyCommand}" />
                                <arc:Button Content="压缩"
                                            Variant="Ghost"
                                            Size="Small"
                                            Command="{Binding MinifyBodyCommand}" />
                                <TextBlock Text="请求体中同样可以使用 {{变量}}。"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>

                            <Grid Grid.Row="1">
                                <Grid IsVisible="{Binding IsTextBody}" RowDefinitions="Auto,*" RowSpacing="8">
                                    <TextBlock Text="{Binding BodyPreview}"
                                               FontFamily="{DynamicResource PostSharpCodeFont}"
                                               FontSize="{DynamicResource PostSharpCodeFontSize}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Grid Grid.Row="1">
                                        <arc:Textarea Text="{Binding Editing.Body, Mode=TwoWay}"
                                                      IsVisible="{Binding !IsBodySingleLine}"
                                                      IsLabelVisible="False"
                                                      Placeholder="{}{ &quot;name&quot;: &quot;PostSharp&quot; }"
                                                      IsResizable="True"
                                                      FontFamily="{DynamicResource PostSharpCodeFont}"
                                                      FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                      AutomationProperties.Name="请求体" />
                                        <arc:Input Text="{Binding Editing.Body, Mode=TwoWay}"
                                                   IsVisible="{Binding IsBodySingleLine}"
                                                   IsLabelVisible="False"
                                                   Size="Small"
                                                   Placeholder="{}{ &quot;name&quot;: &quot;PostSharp&quot; }"
                                                   FontFamily="{DynamicResource PostSharpCodeFont}"
                                                   FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                   AutomationProperties.Name="请求体（单行）" />
                                    </Grid>
                                </Grid>

                                <Grid IsVisible="{Binding IsMultipartBody}" RowDefinitions="Auto,Auto,*" RowSpacing="8">
                                    <Grid ColumnDefinitions="Auto,170,Auto,Auto" ColumnSpacing="8">
                                        <TextBlock Text="文件字段"
                                                   VerticalAlignment="Center"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                        <arc:Input Grid.Column="1"
                                                   Text="{Binding Editing.UploadFieldName, Mode=TwoWay}"
                                                   IsLabelVisible="False"
                                                   Size="Small"
                                                   Placeholder="file"
                                                   AutomationProperties.Name="上传文件字段名" />
                                        <arc:Button Grid.Column="2"
                                                    Content="选择文件"
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Click="OnPickUploadFileClick" />
                                        <arc:Button Grid.Column="3"
                                                    Content="清除"
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Click="OnClearUploadFileClick" />
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <arc:Input Text="{Binding Editing.UploadFilePath, Mode=TwoWay}"
                                                   IsLabelVisible="False"
                                                   Size="Small"
                                                   Placeholder="选择文件或粘贴本地路径"
                                                   FontFamily="{DynamicResource PostSharpCodeFont}"
                                                   AutomationProperties.Name="上传文件路径" />
                                        <TextBlock Grid.Column="1"
                                                   Text="multipart/form-data"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource PostSharpCodeFont}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Grid>
                                    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                                        <TextBlock Text="表单字段"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        <arc:ScrollArea Grid.Row="1">
                                            <ItemsControl ItemsSource="{Binding Editing.FormFields}"
                                                          ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                                        </arc:ScrollArea>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Grid>
                    </arc:TabItem>

                    <arc:TabItem Header="cURL">
                        <Grid RowDefinitions="Auto,*" Margin="0,6,0,0" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="已按当前环境解析变量，可直接复制到终端执行（bash / Git Bash / WSL）。"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                                <arc:CopyButton Grid.Column="1"
                                                Value="{Binding CurlPreview}"
                                                Label="复制 cURL"
                                                Variant="Plain" />
                            </Grid>
                            <arc:ScrollArea Grid.Row="1">
                                <arc:CodeBlock Code="{Binding CurlPreview}"
                                               Language="bash"
                                               FileName="request.sh"
                                               IsCollapsible="False"
                                               CopyLabel="复制 cURL" />
                            </arc:ScrollArea>
                        </Grid>
                    </arc:TabItem>
                </arc:Tabs>

                <GridSplitter Grid.Row="3"
                              Height="8"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="Transparent"
                              HorizontalAlignment="Stretch" />
                <Border Grid.Row="3"
                        Height="1"
                        VerticalAlignment="Center"
                        Background="{arc:ArcDesignTokenResource BorderSubtle}"
                        IsHitTestVisible="False" />

                <Grid Grid.Row="4" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <arc:Badge Content="{Binding ResponseStatusText}"
                                       Tone="{Binding ResponseTone}"
                                       Size="Small"
                                       IsVisible="{Binding HasResponse}" />
                            <TextBlock Text="{Binding ResponseTimeText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       IsVisible="{Binding HasResponse}" />
                            <TextBlock Text="{Binding ResponseSizeText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       IsVisible="{Binding HasResponse}" />
                            <TextBlock Text="{Binding ResponseContentType}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       IsVisible="{Binding HasResponse}" />
                            <TextBlock Text="响应"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding ShowEmptyResponse}" />
                        </StackPanel>
                        <arc:CopyButton Grid.Column="1"
                                        Value="{Binding ResponseClipboardText}"
                                        Label="复制响应"
                                        Variant="Plain"
                                        IsVisible="{Binding HasResponse}" />
                    </Grid>

                    <Border Grid.Row="1"
                            IsVisible="{Binding ShowResponseError}"
                            Background="{arc:ArcDesignTokenResource DangerSubtle}"
                            BorderBrush="{arc:ArcDesignTokenResource Danger}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <arc:Badge Content="请求失败" Tone="Danger" Size="Small" />
                            <TextBlock Text="{Binding ResponseError}"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="检查请求地址、网络连接或 Mock 服务是否在运行。"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <arc:Tabs Grid.Row="1"
                              x:Name="ResponseTabs"
                              IsVisible="{Binding HasResponse}"
                              SelectedIndex="{Binding ResponseTabIndex, Mode=TwoWay}"
                              AutomationProperties.Name="响应">
                        <arc:TabItem Header="响应体">
                            <Grid RowDefinitions="Auto,*" Margin="0,6,0,0" RowSpacing="8">
                                <Border IsVisible="{Binding ShowLargeResponseBanner}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding LargeResponseNotice}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <arc:Button Grid.Column="1"
                                                    Content="查看完整响应"
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Margin="12,0,0,0"
                                                    Click="OnOpenResponseDetailClick" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <arc:JsonViewer x:Name="JsonResponseViewer"
                                                    Json="{Binding ResponseBody}"
                                                    IsVisible="{Binding ShowJsonResponse}"
                                                    ExpandDepth="2"
                                                    MaxTreeHeight="220"
                                                    SearchPlaceholder="搜索键和值"
                                                    AutomationProperties.Name="JSON 响应" />
                                    <arc:ScrollArea IsVisible="{Binding ShowRawResponse}">
                                        <SelectableTextBlock Text="{Binding ResponseBody}"
                                                             FontFamily="{DynamicResource PostSharpCodeFont}"
                                                             FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                             Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                             TextWrapping="NoWrap" />
                                    </arc:ScrollArea>
                                </Grid>
                            </Grid>
                        </arc:TabItem>

                        <arc:TabItem Header="响应头">
                            <arc:ScrollArea Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding ResponseHeaders}"
                                              ItemTemplate="{StaticResource ResponseHeaderTemplate}" />
                            </arc:ScrollArea>
                        </arc:TabItem>

                        <arc:TabItem Header="AI 聚合">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,6,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <arc:SegmentedControl SelectedValue="{Binding SseViewMode, Mode=TwoWay}"
                                                          AutomationProperties.Name="AI 聚合视图">
                                        <arc:SegmentedOption Value="内容" Label="内容" />
                                        <arc:SegmentedOption Value="思考过程" Label="思考过程" />
                                        <arc:SegmentedOption Value="原始事件" Label="原始事件" />
                                    </arc:SegmentedControl>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <arc:CopyButton Value="{Binding SseContent}"
                                                        Label="复制内容"
                                                        Variant="Plain"
                                                        IsVisible="{Binding ShowSseContent}" />
                                        <arc:CopyButton Value="{Binding SseThinking}"
                                                        Label="复制思考"
                                                        Variant="Plain"
                                                        IsVisible="{Binding ShowSseThinking}" />
                                        <arc:CopyButton Value="{Binding SseRaw}"
                                                        Label="复制原始流"
                                                        Variant="Plain"
                                                        IsVisible="{Binding ShowSseRaw}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding SseSummary}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="2">
                                    <Grid IsVisible="{Binding ShowSseContent}">
                                        <arc:ScrollArea>
                                            <SelectableTextBlock Text="{Binding SseContent}"
                                                                 FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                 FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                 Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                 TextWrapping="Wrap" />
                                        </arc:ScrollArea>
                                        <TextBlock Text="没有解析到 content；可切换到「原始事件」查看推送内容。"
                                                   IsVisible="{Binding !HasSseContent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Grid>
                                    <Grid IsVisible="{Binding ShowSseThinking}">
                                        <arc:ScrollArea>
                                            <SelectableTextBlock Text="{Binding SseThinking}"
                                                                 FontFamily="{DynamicResource PostSharpCodeFont}"
                                                                 FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                                 Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                 TextWrapping="Wrap" />
                                        </arc:ScrollArea>
                                        <TextBlock Text="没有解析到 thinking；可切换到「原始事件」查看推送内容。"
                                                   IsVisible="{Binding !HasSseThinking}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Grid>
                                    <arc:ScrollArea IsVisible="{Binding ShowSseRaw}">
                                        <SelectableTextBlock Text="{Binding SseRaw}"
                                                             FontFamily="{DynamicResource PostSharpCodeFont}"
                                                             FontSize="{DynamicResource PostSharpCodeFontSize}"
                                                             Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                             TextWrapping="NoWrap" />
                                    </arc:ScrollArea>
                                    <arc:EmptyState IsVisible="{Binding !IsSseResponse}"
                                                    Title="当前响应不是 SSE"
                                                    Description="发送 text/event-stream 请求后，这里会聚合 thinking 和 content；原始事件仍可在响应体查看。"
                                                    Label="AI 输出" />
                                </Grid>
                            </Grid>
                        </arc:TabItem>
                    </arc:Tabs>

                    <arc:EmptyState Grid.Row="1"
                                    IsVisible="{Binding ShowEmptyResponse}"
                                    Label="响应"
                                    Title="还没有响应"
                                    Description="按 Ctrl+Enter 或点击发送。默认示例请求已指向内置 Mock 服务，不需要联网。"
                                    VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </DockPanel>
        </VisualLayerManager>

        <!-- In-window context menu for the collection tree; keeps the Arc styling and never leaves the window. -->
        <Panel x:Name="TreeMenuOverlay" IsVisible="False">
            <Border Background="Transparent" PointerPressed="OnTreeMenuDismiss" />
            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border x:Name="TreeMenuCard"
                        Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                        BorderBrush="{arc:ArcDesignTokenResource Border}"
                        BorderThickness="1"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                        Padding="6">
                    <StackPanel Width="196" Spacing="2">
                        <arc:Button x:Name="TreeMenuAddButton"
                                    Content="新建请求"
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    Command="{Binding AddRequestCommand}"
                                    Click="OnTreeMenuItemClick" />
                        <arc:Button Content="复制请求"
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    IsVisible="{Binding IsRequestSelected}"
                                    Command="{Binding DuplicateSelectedRequestCommand}"
                                    Click="OnTreeMenuItemClick" />
                        <arc:Button Content="复制 URL"
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    IsVisible="{Binding IsRequestSelected}"
                                    Command="{Binding CopySelectedUrlCommand}"
                                    Click="OnTreeMenuItemClick" />
                        <Border Height="1"
                                Margin="6,4"
                                Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                        <arc:Button Content="重命名"
                                    Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    IsVisible="{Binding HasSelection}"
                                    Command="{Binding RenameSelectedCommand}"
                                    Click="OnTreeMenuItemClick" />
                        <arc:Button Variant="Ghost"
                                    Size="Small"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="12,0"
                                    IsVisible="{Binding HasSelection}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    Click="OnTreeMenuItemClick">
                            <TextBlock Text="删除" Foreground="{arc:ArcDesignTokenResource Danger}" />
                        </arc:Button>
                    </StackPanel>
                </Border>
            </Canvas>
        </Panel>

        <!-- Management layer: AI audit trail and automation suites. -->
        <Panel x:Name="ManagementOverlay" IsVisible="{Binding IsManagementOpen}">
            <Border Background="{arc:ArcDesignTokenResource Scrim}" PointerPressed="OnManagementDismiss" />
            <Border Margin="32"
                    Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
                    BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                    Padding="20">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="管理层"
                                       FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                       FontWeight="SemiBold"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="AI 调用审计 · 自动化接口测试 · 统一管理 AI 触发的请求"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        </StackPanel>
                        <arc:Button Grid.Column="1"
                                    Content="关闭"
                                    Variant="Secondary"
                                    Command="{Binding CloseManagementCommand}" />
                    </Grid>

                    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="10">
                        <arc:SegmentedControl SelectedValue="{Binding ManagementTab, Mode=TwoWay}"
                                              HorizontalAlignment="Left"
                                              AutomationProperties.Name="管理层视图">
                            <arc:SegmentedOption Value="审计" Label="审计" />
                            <arc:SegmentedOption Value="自动化" Label="自动化" />
                            <arc:SegmentedOption Value="指南" Label="指南" />
                            <arc:SegmentedOption Value="设置" Label="设置" />
                        </arc:SegmentedControl>

                        <Grid Grid.Row="1">
                            <Grid IsVisible="{Binding IsAuditTab}" RowDefinitions="Auto,*" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <arc:SearchField Placeholder="搜索请求、URL、工具或客户端"
                                                     Text="{Binding AuditFilterText, Mode=TwoWay}"
                                                     AutomationProperties.Name="搜索审计" />
                                    <arc:SegmentedControl Grid.Column="1"
                                                          SelectedValue="{Binding AuditSourceFilter, Mode=TwoWay}"
                                                          AutomationProperties.Name="审计来源">
                                        <arc:SegmentedOption Value="全部" Label="全部" />
                                        <arc:SegmentedOption Value="UI" Label="UI" />
                                        <arc:SegmentedOption Value="MCP" Label="MCP" />
                                    </arc:SegmentedControl>
                                    <arc:Button Grid.Column="2"
                                                Content="清空审计"
                                                Variant="Ghost"
                                                Size="Small"
                                                Command="{Binding ClearAuditCommand}" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="1.05*,0.95*" ColumnSpacing="14">
                                    <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                            Padding="4">
                                        <arc:ScrollArea>
                                            <ItemsControl ItemsSource="{Binding VisibleAudit}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:AuditEntry">
                                                        <arc:Button Variant="Ghost"
                                                                    Size="Small"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="0"
                                                                    Margin="0,0,0,4"
                                                                    Click="OnAuditRowClick">
                                                            <Border Background="{arc:ArcDesignTokenResource Surface}"
                                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                    Padding="10,8">
                                                                <Grid ColumnDefinitions="82,*,Auto,Auto"
                                                                      RowDefinitions="Auto,Auto"
                                                                      ColumnSpacing="8"
                                                                      RowSpacing="2">
                                                                    <arc:Badge Grid.RowSpan="2"
                                                                               Content="{Binding SourceLabel}"
                                                                               Tone="{Binding SourceTone}"
                                                                               Size="Small"
                                                                               Width="82"
                                                                               HorizontalAlignment="Left"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding SourceLabel}" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding RequestName}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding RequestName}" />
                                                                    <arc:Badge Grid.Column="2"
                                                                               Content="{Binding StatusShortLabel}"
                                                                               Tone="{Binding StatusTone}"
                                                                               Size="Small"
                                                                               VerticalAlignment="Center"
                                                                               ToolTip.Tip="{Binding StatusLabel}" />
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding TimeText}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6,0,0,0"
                                                                               ToolTip.Tip="{Binding TimeTooltip}" />
                                                                    <TextBlock Grid.Row="1"
                                                                               Grid.Column="1"
                                                                               Grid.ColumnSpan="3"
                                                                               Text="{Binding RequestLine}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding Url}" />
                                                                </Grid>
                                                            </Border>
                                                        </arc:Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </arc:ScrollArea>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                            Padding="12">
                                        <Grid>
                                            <arc:ScrollArea IsVisible="{Binding HasSelectedAuditEntry}">
                                                <StackPanel Spacing="10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding SelectedAuditEntry.RequestName}"
                                                                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                       TextWrapping="Wrap" />
                                                            <SelectableTextBlock Text="{Binding SelectedAuditEntry.Url}"
                                                                                 FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                 Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                                 TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <arc:Button Grid.Column="1"
                                                                    Content="打开请求"
                                                                    Variant="Secondary"
                                                                    Size="Small"
                                                                    Command="{Binding OpenSelectedAuditRequestCommand}" />
                                                    </Grid>

                                                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                                                        <arc:Badge Content="{Binding SelectedAuditEntry.SourceLabel}"
                                                                   Tone="{Binding SelectedAuditEntry.SourceTone}"
                                                                   Size="Small" />
                                                        <arc:Badge Content="{Binding SelectedAuditEntry.StatusLabel}"
                                                                   Tone="{Binding SelectedAuditEntry.StatusTone}"
                                                                   Size="Small" />
                                                        <TextBlock Text="{Binding SelectedAuditEntry.DurationText}"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedAuditEntry.SizeText}"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedAuditEntry.TimeText}"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                    </WrapPanel>

                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="客户端"
                                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                            <TextBlock Text="{Binding SelectedAuditEntry.ClientLabel}"
                                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="工具"
                                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                            <TextBlock Text="{Binding SelectedAuditEntry.ToolLabel}"
                                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <TextBlock Text="{Binding SelectedAuditEntry.Error}"
                                                               Foreground="{arc:ArcDesignTokenResource Danger}"
                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                               TextWrapping="Wrap" />

                                                    <StackPanel IsVisible="{Binding SelectedAuditEntry.HasAiOutput}" Spacing="6">
                                                        <TextBlock Text="AI 聚合输出"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   FontWeight="Medium"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <TextBlock Text="{Binding SelectedAuditEntry.AiSummary}"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                        <TextBlock Text="Content"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <arc:CodeBlock Code="{Binding SelectedAuditEntry.AiContent}"
                                                                       Language="text"
                                                                       FileName="ai-content.md"
                                                                       IsCollapsible="True"
                                                                       MaxLines="10"
                                                                       CopyLabel="复制内容"
                                                                       ShowAllLinesFormat="展开全部 {0} 行"
                                                                       ShowFewerLinesLabel="收起" />
                                                        <TextBlock Text="Thinking"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                        <arc:CodeBlock Code="{Binding SelectedAuditEntry.AiThinking}"
                                                                       Language="text"
                                                                       FileName="ai-thinking.txt"
                                                                       IsCollapsible="True"
                                                                       MaxLines="8"
                                                                       CopyLabel="复制思考"
                                                                       ShowAllLinesFormat="展开全部 {0} 行"
                                                                       ShowFewerLinesLabel="收起" />
                                                    </StackPanel>
                                                    <TextBlock Text="cURL"
                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                               FontWeight="Medium"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    <arc:CodeBlock Code="{Binding SelectedAuditEntry.Curl}"
                                                                   Language="bash"
                                                                   FileName="request.sh"
                                                                   IsCollapsible="True"
                                                                   MaxLines="8"
                                                                   CopyLabel="复制 cURL" />

                                                    <TextBlock Text="请求头"
                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                               FontWeight="Medium"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    <arc:CodeBlock Code="{Binding SelectedAuditEntry.RequestHeaders}"
                                                                   Language="text"
                                                                   FileName="headers.txt"
                                                                   IsCollapsible="True"
                                                                   MaxLines="6"
                                                                   CopyLabel="复制"
                                                                   ShowAllLinesFormat="展开全部 {0} 行"
                                                                   ShowFewerLinesLabel="收起" />

                                                    <TextBlock Text="请求体预览"
                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                               FontWeight="Medium"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    <arc:CodeBlock Code="{Binding SelectedAuditEntry.RequestBodyPreview}"
                                                                   Language="text"
                                                                   FileName="request.txt"
                                                                   IsCollapsible="True"
                                                                   MaxLines="6"
                                                                   CopyLabel="复制"
                                                                   ShowAllLinesFormat="展开全部 {0} 行"
                                                                   ShowFewerLinesLabel="收起" />

                                                    <TextBlock Text="响应体预览"
                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                               FontWeight="Medium"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    <arc:CodeBlock Code="{Binding SelectedAuditEntry.ResponseBodyPreview}"
                                                                   Language="text"
                                                                   FileName="response.txt"
                                                                   IsCollapsible="True"
                                                                   MaxLines="8"
                                                                   CopyLabel="复制"
                                                                   ShowAllLinesFormat="展开全部 {0} 行"
                                                                   ShowFewerLinesLabel="收起" />


                                                </StackPanel>
                                            </arc:ScrollArea>
                                            <arc:EmptyState IsVisible="{Binding !HasSelectedAuditEntry}"
                                                            Title="选择一条审计记录"
                                                            Description="查看 AI 或 UI 触发的请求、状态、耗时、cURL 和请求/响应预览。"
                                                            Label="审计详情" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid IsVisible="{Binding IsAutomationTab}" ColumnDefinitions="0.85*,1.15*" ColumnSpacing="14">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <arc:Button Content="从当前集合创建"
                                                    Variant="Secondary"
                                                    Size="Small"
                                                    Command="{Binding CreateSuiteFromCollectionCommand}" />
                                        <arc:Button Content="删除套件"
                                                    Variant="Danger"
                                                    Size="Small"
                                                    Command="{Binding DeleteSelectedSuiteCommand}" />
                                    </StackPanel>
                                    <Border Grid.Row="1"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                            BorderThickness="1"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                            Padding="4">
                                        <arc:ScrollArea>
                                            <ItemsControl ItemsSource="{Binding Suites}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TestSuite">
                                                        <arc:Button Variant="Ghost"
                                                                    Size="Small"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    Padding="0"
                                                                    Margin="0,0,0,4"
                                                                    Click="OnSuiteRowClick">
                                                            <Border Background="{arc:ArcDesignTokenResource Surface}"
                                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                    Padding="10,8">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding Name}" />
                                                                    <TextBlock Text="{Binding LastSummary}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding LastSummary}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </arc:Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </arc:ScrollArea>
                                    </Border>
                                    <TextBlock Grid.Row="2"
                                               Text="套件步骤可由 MCP create_suite 创建，也可从当前集合生成；运行结果会写入审计。"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding SelectedSuite.Name}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SelectedSuite.Name}" />
                                        <TextBlock Text="{Binding SelectedSuite.LastSummary}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SelectedSuite.LastSummary}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="1"
                                               Text="步骤与断言 / 最近结果"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               FontWeight="Medium"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                                    <Grid Grid.Row="2" ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="10">
                                            <arc:ScrollArea>
                                                <ItemsControl ItemsSource="{Binding SelectedSuite.Steps}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:TestStep">
                                                            <Border Background="{arc:ArcDesignTokenResource Surface}"
                                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                    Padding="8"
                                                                    Margin="0,0,0,4">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock Text="{Binding RequestName}"
                                                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding RequestName}" />
                                                                    <TextBlock Text="{Binding Method}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                                    <TextBlock Text="{Binding Url}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               ToolTip.Tip="{Binding Url}" />
                                                                    <TextBlock Text="{Binding ExpectationText}"
                                                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                               TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </arc:ScrollArea>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="10">
                                            <Grid>
                                                <arc:ScrollArea IsVisible="{Binding HasSelectedSuiteResult}">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding SelectedSuiteResult.Summary}"
                                                                   FontWeight="Medium"
                                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                        <ItemsControl ItemsSource="{Binding SelectedSuiteResult.Steps}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:TestStepResult">
                                                                    <Border Background="{arc:ArcDesignTokenResource Surface}"
                                                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                                            Padding="8"
                                                                            Margin="0,0,0,4">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                                                              RowDefinitions="Auto,Auto"
                                                                              ColumnSpacing="8"
                                                                              RowSpacing="2">
                                                                            <arc:Badge Content="{Binding ResultLabel}"
                                                                                       Tone="{Binding ResultTone}"
                                                                                       Size="Small" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Name}"
                                                                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip.Tip="{Binding Name}" />
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding StatusCode}"
                                                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                                            <TextBlock Grid.Row="1"
                                                                                       Grid.Column="1"
                                                                                       Grid.ColumnSpan="2"
                                                                                       Text="{Binding Error}"
                                                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                       Foreground="{arc:ArcDesignTokenResource Danger}"
                                                                                       TextWrapping="Wrap" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </arc:ScrollArea>
                                                <arc:EmptyState IsVisible="{Binding !HasSelectedSuiteResult}"
                                                                Title="尚未运行"
                                                                Description="点击「运行套件」查看每个步骤的断言结果；结果同时写入审计。"
                                                                Label="套件结果" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <arc:Button Grid.Row="3"
                                                Content="运行套件"
                                                Variant="Primary"
                                                HorizontalAlignment="Right"
                                                IsLoading="{Binding IsRunningSuite}"
                                                Command="{Binding RunSelectedSuiteCommand}" />
                                </Grid>
                            </Grid>

                            <Grid IsVisible="{Binding IsGuideTab}" RowDefinitions="*" Margin="0,6,0,0">
                                <arc:ScrollArea>
                                    <StackPanel Spacing="12" MaxWidth="1120" HorizontalAlignment="Center">
                                        <TextBlock Text="一分钟上手"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                        <TextBlock Text="PostSharp 的核心链路是：AI 通过 MCP 触发请求 → 审计留痕 → 自动化套件回归。下面每一步都可以直接点开示例。"
                                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   TextWrapping="Wrap" />

                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="14">
                                            <Grid ColumnDefinitions="34,*,220" ColumnSpacing="12">
                                                <arc:Badge Content="1"
                                                           Tone="Neutral"
                                                           Size="Small"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="发送第一个请求"
                                                               FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                    <TextBlock Text="载入「健康检查」，按 Ctrl+Enter 发送。响应区会显示状态、耗时、大小、JSON 树和可复制响应。"
                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <arc:Button Content="载入健康检查"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="health" />
                                                    <arc:Button Content="清空审计"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding ClearAuditCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="14">
                                            <Grid ColumnDefinitions="34,*,220" ColumnSpacing="12">
                                                <arc:Badge Content="2"
                                                           Tone="Neutral"
                                                           Size="Small"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="请求头、请求体与 cURL"
                                                               FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                    <TextBlock Text="请求头可以一键插入 JSON 类型、Accept JSON、Bearer Token，并会提示重复头。请求体支持 JSON/XML 格式化、压缩、单行切换；cURL 标签会生成已解析环境变量的可执行命令。"
                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <arc:Button Content="打开环境变量"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding OpenEnvironmentFromGuideCommand}" />
                                                    <arc:Button Content="载入 SSE 示例"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="sse" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="14">
                                            <Grid ColumnDefinitions="34,*,220" ColumnSpacing="12">
                                                <arc:Badge Content="3"
                                                           Tone="Neutral"
                                                           Size="Small"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="AI 审计与自动化"
                                                               FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                    <TextBlock Text="所有 UI 和 MCP 发送都会写入审计，记录来源、客户端、工具、状态、耗时、cURL 和请求/响应预览。自动化套件支持状态码和响应体断言，运行结果也会进入审计。"
                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <arc:Button Content="查看审计"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding SetManagementTabCommand}"
                                                                CommandParameter="审计" />
                                                    <arc:Button Content="查看自动化"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding SetManagementTabCommand}"
                                                                CommandParameter="自动化" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="14">
                                            <Grid ColumnDefinitions="34,*,220" ColumnSpacing="12">
                                                <arc:Badge Content="4"
                                                           Tone="Neutral"
                                                           Size="Small"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="SSE / AI 输出聚合"
                                                               FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                    <TextBlock Text="发送 text/event-stream 请求后，PostSharp 会把流式事件里的 thinking 和 content 自动追加聚合，在「AI 聚合」标签中完整展示，而不是只保留最后一条推送。"
                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <arc:Button Content="载入 SSE 示例"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="sse" />
                                                    <arc:Button Content="载入上传示例"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="upload" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="14">
                                            <Grid ColumnDefinitions="34,*,220" ColumnSpacing="12">
                                                <arc:Badge Content="5"
                                                           Tone="Neutral"
                                                           Size="Small"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="MCP 接入"
                                                               FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                    <TextBlock Text="把下面的地址添加到支持 Streamable HTTP 的 MCP 客户端，AI 就可以查询接口、发送请求、获取 cURL、运行回归套件并查看审计。"
                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                                        <arc:Input IsLabelVisible="False"
                                                                   IsReadOnly="True"
                                                                   Text="{Binding McpEndpoint}"
                                                                   FontFamily="{DynamicResource PostSharpCodeFont}" />
                                                        <arc:CopyButton Grid.Column="1"
                                                                        Value="{Binding McpEndpoint}"
                                                                        Label="复制地址"
                                                                        Variant="Plain" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <arc:Button Content="打开 MCP 接入说明"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding OpenMcpFromGuideCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                                Padding="14">
                                            <Grid ColumnDefinitions="34,*,220" ColumnSpacing="12">
                                                <arc:Badge Content="6"
                                                           Tone="Neutral"
                                                           Size="Small"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="6">
                                                    <TextBlock Text="上传与系统设置"
                                                               FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                    <TextBlock Text="请求体切到「表单上传」后可以选择文件并发起 multipart 请求；设置页提供主题、界面字体、代码字体/字号、超时、默认请求体、大响应阈值和审计保留条数。"
                                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <arc:Button Content="打开设置"
                                                                Variant="Secondary"
                                                                Size="Small"
                                                                Command="{Binding SetManagementTabCommand}"
                                                                CommandParameter="设置" />
                                                    <arc:Button Content="载入上传示例"
                                                                Variant="Ghost"
                                                                Size="Small"
                                                                Command="{Binding LoadGuideRequestCommand}"
                                                                CommandParameter="upload" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </arc:ScrollArea>
                            </Grid>

                            <Grid IsVisible="{Binding IsSettingsTab}" RowDefinitions="*,Auto" Margin="0,6,0,0" RowSpacing="10">
                                <arc:ScrollArea>
                                    <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left">
                                        <TextBlock Text="系统全局设置"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                        <TextBlock Text="修改即时生效并自动保存。字体选择会应用到主窗口与代码视图，超时和响应阈值会应用到后续请求。"
                                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="外观"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                            <arc:Select Label="主题"
                                                        ItemsSource="{Binding ThemeOptions}"
                                                        SelectedItem="{Binding Settings.Theme, Mode=TwoWay}" />
                                            <arc:Select Grid.Column="1"
                                                        Label="界面字体"
                                                        ItemsSource="{Binding UiFontOptions}"
                                                        SelectedItem="{Binding Settings.UiFont, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                            <arc:Select Label="代码字体"
                                                        ItemsSource="{Binding CodeFontOptions}"
                                                        SelectedItem="{Binding Settings.CodeFont, Mode=TwoWay}" />
                                            <arc:Select Grid.Column="1"
                                                        Label="代码字号"
                                                        ItemsSource="{Binding CodeFontSizeOptions}"
                                                        SelectedItem="{Binding Settings.CodeFontSize, Mode=TwoWay}" />
                                        </Grid>

                                        <TextBlock Text="请求"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                            <arc:Select Label="请求超时"
                                                        Description="单位：秒"
                                                        ItemsSource="{Binding TimeoutOptions}"
                                                        SelectedItem="{Binding Settings.RequestTimeoutSeconds, Mode=TwoWay}" />
                                            <arc:Select Grid.Column="1"
                                                        Label="默认请求体"
                                                        SelectedValue="{Binding Settings.DefaultBodyMode, Mode=TwoWay}">
                                                <arc:SelectItem Content="无" Value="None" />
                                                <arc:SelectItem Content="JSON" Value="Json" />
                                                <arc:SelectItem Content="文本" Value="Text" />
                                                <arc:SelectItem Content="表单上传" Value="Multipart" />
                                            </arc:Select>
                                        </Grid>
                                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="12">
                                            <arc:Select Label="大响应折叠阈值"
                                                        Description="单位：KB"
                                                        ItemsSource="{Binding LargeResponseThresholdOptions}"
                                                        SelectedItem="{Binding Settings.LargeResponseThresholdKb, Mode=TwoWay}" />
                                            <arc:Select Grid.Column="1"
                                                        Label="审计保留条数"
                                                        Description="单位：条"
                                                        ItemsSource="{Binding AuditLimitOptions}"
                                                        SelectedItem="{Binding Settings.AuditLimit, Mode=TwoWay}" />
                                        </Grid>
                                        <arc:Switch Content="自动格式化 JSON/XML 响应"
                                                    IsChecked="{Binding Settings.AutoFormatResponse, Mode=TwoWay}" />

                                        <TextBlock Text="设置文件位于 %APPDATA%\PostSharp\settings.json；工作区与审计文件也在同一目录。"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </arc:ScrollArea>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <arc:Button Content="恢复默认设置"
                                                Variant="Secondary"
                                                Command="{Binding ResetSettingsCommand}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Panel>

        <!-- Overlays -->
        <arc:Toast HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,24,24"
                   Width="320"
                   Duration="0:0:3"
                   Title="{Binding ToastTitle}"
                   IsOpen="{Binding IsToastOpen, Mode=TwoWay}" />

        <arc:Dialog x:Name="EnvironmentDialog"
                    IsOpen="{Binding IsEnvironmentDialogOpen, Mode=TwoWay}"
                    Title="环境变量"
                    Description="在地址、请求头或请求体中使用 {{变量名}}，发送时会替换为当前环境的值。"
                    Size="Large">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <arc:Select Grid.Column="0"
                                Label="当前环境"
                                ItemsSource="{Binding Environments}"
                                SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom">
                        <arc:Button Content="新建环境"
                                    Variant="Secondary"
                                    Size="Small"
                                    Command="{Binding AddEnvironmentCommand}" />
                        <arc:Button Content="删除环境"
                                    Variant="Danger"
                                    Size="Small"
                                    Command="{Binding RemoveEnvironmentCommand}" />
                    </StackPanel>
                </Grid>

                <arc:Input Grid.Row="1"
                           Label="环境名称"
                           Text="{Binding ActiveEnvironment.Name, Mode=TwoWay}" />

                <TextBlock Grid.Row="2"
                           Text="变量"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />

                <arc:ScrollArea Grid.Row="3" Height="220">
                    <ItemsControl ItemsSource="{Binding ActiveEnvironment.Variables}"
                                  ItemTemplate="{StaticResource KeyValueRowTemplate}" />
                </arc:ScrollArea>

                <TextBlock Grid.Row="4"
                           Text="填写最后一行会自动新增一行；未启用的变量不会参与替换。"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </Grid>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelEnvironmentDialogCommand}" />
                    <arc:Button Content="保存环境"
                                Variant="Primary"
                                Command="{Binding CloseEnvironmentDialogCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog IsOpen="{Binding IsRenameDialogOpen, Mode=TwoWay}"
                    Title="{Binding RenameDialogTitle}"
                    Size="Small">
            <arc:Input Label="名称"
                       Text="{Binding RenameText, Mode=TwoWay}"
                       AutomationProperties.Name="名称" />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelRenameCommand}" />
                    <arc:Button Content="保存名称"
                                Variant="Primary"
                                Command="{Binding ApplyRenameCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog IsOpen="{Binding IsDeleteDialogOpen, Mode=TwoWay}"
                    Title="{Binding DeleteDialogTitle}"
                    Description="{Binding DeleteDialogDescription}"
                    Size="Small">
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelDeleteCommand}" />
                    <arc:Button Content="删除"
                                Variant="Danger"
                                Command="{Binding ConfirmDeleteCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog IsOpen="{Binding IsHistoryTrashConfirmOpen, Mode=TwoWay}"
                    Title="{Binding HistoryTrashConfirmTitle}"
                    Description="{Binding HistoryTrashConfirmDescription}"
                    Size="Small">
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelHistoryTrashCommand}" />
                    <arc:Button Content="移入回收站"
                                Variant="Danger"
                                Command="{Binding ConfirmHistoryTrashCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog IsOpen="{Binding IsHistoryTrashOpen, Mode=TwoWay}"
                    Title="历史记录回收站"
                    Description="删除的历史记录会先进入这里；恢复后回到历史列表，永久删除后无法恢复。"
                    Size="Large">
            <Grid MinHeight="260">
                <arc:ScrollArea MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding RecycledHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryEntry">
                                <Border Background="{arc:ArcDesignTokenResource Surface}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="8"
                                        Margin="0,0,0,4">
                                    <Grid ColumnDefinitions="56,*,Auto,Auto"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="6"
                                          RowSpacing="2">
                                        <arc:Badge Grid.RowSpan="2"
                                                   Content="{Binding Method}"
                                                   Tone="Neutral"
                                                   Size="Small"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Name}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding StatusLabel}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DisplayTime}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"
                                                   ToolTip.Tip="{Binding TimestampText}" />
                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="1"
                                                   Text="{Binding Url}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding Url}"
                                                   Margin="0,0,8,0" />
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="2"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    HorizontalAlignment="Right">
                                            <arc:Button Content="恢复"
                                                        Variant="Secondary"
                                                        Size="Small"
                                                        Command="{Binding RestoreCommand}" />
                                            <arc:Button Content="永久删除"
                                                        Variant="Danger"
                                                        Size="Small"
                                                        Command="{Binding PurgeCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </arc:ScrollArea>
                <arc:EmptyState IsVisible="{Binding !HasRecycledHistory}"
                                Title="回收站为空"
                                Description="删除历史记录后，会先出现在这里。"
                                Label="回收站" />
            </Grid>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="清空回收站"
                                Variant="Danger"
                                IsVisible="{Binding HasRecycledHistory}"
                                Command="{Binding EmptyHistoryTrashCommand}" />
                    <arc:Button Content="关闭"
                                Variant="Primary"
                                Command="{Binding CloseHistoryTrashCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog IsOpen="{Binding IsHistoryPurgeConfirmOpen, Mode=TwoWay}"
                    Title="{Binding HistoryPurgeTitle}"
                    Description="{Binding HistoryPurgeDescription}"
                    Size="Small">
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="取消"
                                Variant="Secondary"
                                Command="{Binding CancelHistoryPurgeCommand}" />
                    <arc:Button Content="永久删除"
                                Variant="Danger"
                                Command="{Binding ConfirmHistoryPurgeCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog x:Name="McpDialog"
                    IsOpen="{Binding IsMcpDialogOpen, Mode=TwoWay}"
                    Title="MCP 接入"
                    Description="把 PostSharp 作为本地 MCP 服务器，让 AI 客户端管理接口、发送请求并运行自动化。"
                    Size="Large">
            <StackPanel Spacing="12">
                <arc:Input Label="MCP 端点"
                           Text="{Binding McpEndpoint}"
                           IsReadOnly="True"
                           FontFamily="{DynamicResource PostSharpCodeFont}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <arc:CopyButton Value="{Binding McpEndpoint}"
                                    Label="复制 MCP 地址"
                                    Variant="Plain" />
                    <TextBlock Grid.Column="1"
                               Text="支持 Streamable HTTP 的 MCP 客户端（Cursor、Claude Code、Cline 等）可直接添加。"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock Text="已开放工具"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <TextBlock Text="{Binding McpToolSummary}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           TextWrapping="Wrap" />

                <arc:CodeBlock Code="{Binding McpClientConfig}"
                               Language="json"
                               FileName="mcp.json"
                               IsCollapsible="False"
                               CopyLabel="复制客户端配置" />

                <TextBlock Text="MCP 发送请求同样会写入历史记录；run_sequence 可以按顺序执行多个请求，用于回归检查或定时脚本。"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Content="关闭"
                                Variant="Secondary"
                                Command="{Binding CloseMcpDialogCommand}" />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>
    </Panel>
</Window>
