<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:controls="using:PostSharp.Controls"
    xmlns:models="using:PostSharp.Models"
    xmlns:vm="using:PostSharp.ViewModels"
    xmlns:views="using:PostSharp.Views"
    x:Class="PostSharp.Views.AuxiliaryDialogsView"
    x:DataType="vm:MainWindowViewModel"
>
    <Panel>
        <arc:Dialog
            Opened="OnDialogOpened"
            x:Name="ImportSuccessDialog"
            IsOpen="{Binding Import.IsImportSuccessOpen, Mode=TwoWay}"
            Title="{Binding Import.ImportSuccessTitle}"
            Description="导入已完成，请求已写入当前工作区。"
            Size="Small"
        >
            <StackPanel Spacing="10">
                <TextBlock
                    Text="{Binding Import.ImportSuccessSummary}"
                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                    TextWrapping="Wrap"
                />
                <TextBlock
                    Text="{Binding Import.ImportSuccessDetail}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    TextWrapping="Wrap"
                />
            </StackPanel>
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="生成套件"
                        Variant="Secondary"
                        IsVisible="{Binding Import.CanGenerateSuiteFromImport}"
                        Command="{Binding Import.GenerateSuiteFromImportCommand}"
                        AutomationProperties.Name="从导入结果生成套件"
                    />
                    <arc:Button
                        Content="知道了"
                        Variant="Primary"
                        Command="{Binding Import.CloseImportSuccessCommand}"
                        AutomationProperties.Name="关闭导入成功提示"
                    />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsRunDiffOpen, Mode=TwoWay}"
            Title="运行对比"
            Description="对比同一套件的两次运行，标出新增失败、修复、状态码变化和耗时回归。"
            Size="Large"
        >
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                <TextBlock
                    Grid.Row="0"
                    Text="{Binding RunDiff.HeaderLine}"
                    FontWeight="SemiBold"
                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                    TextWrapping="Wrap"
                />
                <StackPanel Grid.Row="1" Spacing="6">
                    <TextBlock
                        Text="{Binding RunDiff.Diff.Conclusion}"
                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                        TextWrapping="Wrap"
                    />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <arc:Badge
                            Content="{Binding RunDiff.Diff.NewFailures, StringFormat='新增失败 {0}'}"
                            Tone="Danger"
                            Size="Small"
                        />
                        <arc:Badge
                            Content="{Binding RunDiff.Diff.Fixed, StringFormat='修复 {0}'}"
                            Tone="Success"
                            Size="Small"
                        />
                        <arc:Badge
                            Content="{Binding RunDiff.Diff.StatusChanged, StringFormat='状态码变化 {0}'}"
                            Tone="Warning"
                            Size="Small"
                        />
                        <arc:Badge
                            Content="{Binding RunDiff.Diff.Slower, StringFormat='耗时回归 {0}'}"
                            Tone="Warning"
                            Size="Small"
                        />
                        <arc:Badge
                            Content="{Binding RunDiff.Diff.Faster, StringFormat='耗时改善 {0}'}"
                            Tone="Info"
                            Size="Small"
                        />
                    </StackPanel>
                    <TextBlock
                        Text="{Binding RunDiff.UnchangedText}"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    />
                </StackPanel>
                <TextBlock
                    Grid.Row="2"
                    Text="两次运行结果一致，未发现失败、状态码或耗时变化。"
                    IsVisible="{Binding !RunDiff.HasChanges}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    TextWrapping="Wrap"
                />
                <arc:ScrollArea Grid.Row="3" IsVisible="{Binding RunDiff.HasChanges}">
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding RunDiff.ChangedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SuiteRunDiffRow">
                                    <Border
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="8"
                                        Margin="0,0,0,4"
                                    >
                                        <Grid
                                            ColumnDefinitions="Auto,*,Auto"
                                            ColumnSpacing="8"
                                            RowDefinitions="Auto,Auto"
                                            RowSpacing="2"
                                        >
                                            <arc:Badge
                                                Content="{Binding ChangeLabel}"
                                                Tone="{Binding Tone}"
                                                Size="Small"
                                                VerticalAlignment="Top"
                                            />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Name}"
                                                />
                                                <TextBlock
                                                    Text="{Binding Detail}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    TextWrapping="Wrap"
                                                />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="1">
                                                <TextBlock
                                                    Text="{Binding StatusText}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    HorizontalAlignment="Right"
                                                />
                                                <TextBlock
                                                    Text="{Binding ElapsedText}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    HorizontalAlignment="Right"
                                                />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="4" IsVisible="{Binding RunDiff.HasNodes}">
                            <TextBlock
                                Text="节点状态变化"
                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                FontWeight="Medium"
                                Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            />
                            <ItemsControl ItemsSource="{Binding RunDiff.NodeRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuiteRunNodeDiffRow">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="8"
                                            Margin="0,0,0,3"
                                        >
                                            <StackPanel Spacing="1">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding Name}"
                                                />
                                                <TextBlock
                                                    Text="{Binding StateText}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding ElapsedText}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                VerticalAlignment="Center"
                                            />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </arc:ScrollArea>
            </Grid>
            <arc:Dialog.Actions>
                <arc:Button
                    Content="关闭"
                    Variant="Primary"
                    HorizontalAlignment="Right"
                    Command="{Binding CloseRunDiffCommand}"
                    AutomationProperties.Name="关闭运行对比"
                />
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            x:Name="EnvironmentDialog"
            IsOpen="{Binding IsEnvironmentDialogOpen, Mode=TwoWay}"
            Title="环境变量"
            Description="在地址、请求头或请求体中使用 {{变量名}}，发送时会替换为当前环境的值。"
            Size="Large"
        >
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <arc:Select
                        Grid.Column="0"
                        Label="当前环境"
                        ItemsSource="{Binding Environments}"
                        SelectedItem="{Binding ActiveEnvironment, Mode=TwoWay}"
                    />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Bottom"
                    >
                        <arc:Button
                            Content="新建环境"
                            Variant="Secondary"
                            Size="Small"
                            Command="{Binding AddEnvironmentCommand}"
                        />
                        <arc:Button
                            Content="删除环境"
                            Variant="Danger"
                            Size="Small"
                            Command="{Binding RemoveEnvironmentCommand}"
                        />
                    </StackPanel>
                </Grid>

                <arc:Input
                    Grid.Row="1"
                    Label="环境名称"
                    Text="{Binding ActiveEnvironment.Name, Mode=TwoWay}"
                />

                <TextBlock
                    Grid.Row="2"
                    Text="变量"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    FontWeight="Medium"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                />

                <arc:ScrollArea Grid.Row="3" Height="220">
                    <ItemsControl ItemsSource="{Binding ActiveEnvironment.Variables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:KeyValueRow">
                                <views:EnvironmentVariableRow />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </arc:ScrollArea>

                <TextBlock
                    Grid.Row="4"
                    Text="填写最后一行会自动新增一行；未启用的变量不会参与替换。点锁形图标设为机密变量：值会隐藏，审计和 MCP 中显示为 ******；服务器返回的内容里只替换 8 个字符以上的值。"
                    TextWrapping="Wrap"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                />
            </Grid>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelEnvironmentDialogCommand}"
                    />
                    <arc:Button
                        Content="保存环境"
                        Variant="Primary"
                        Command="{Binding CloseEnvironmentDialogCommand}"
                    />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsRenameDialogOpen, Mode=TwoWay}"
            Title="{Binding RenameDialogTitle}"
            Size="Small"
        >
            <arc:Input
                Label="名称"
                Text="{Binding RenameText, Mode=TwoWay}"
                AutomationProperties.Name="名称"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelRenameCommand}"
                    />
                    <arc:Button
                        Content="保存名称"
                        Variant="Primary"
                        Command="{Binding ApplyRenameCommand}"
                    />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsDeleteDialogOpen, Mode=TwoWay}"
            Title="{Binding DeleteDialogTitle}"
            Description="{Binding DeleteDialogDescription}"
            Size="Small"
        >
            <TextBlock
                Text="Ctrl+Enter 确认，Esc 取消"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelDeleteCommand}"
                    />
                    <arc:Button Variant="Danger" Command="{Binding ConfirmDeleteCommand}">
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.Archive}"
                            Text="移入回收站"
                        />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsOnboardingOpen, Mode=TwoWay}"
            Title="欢迎使用 PostSharp"
            Description="三步完成第一次请求和第一次 AI 调用；也可以先跳过，之后在「指南」中重新查看。"
            Size="Medium"
        >
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                    <arc:Badge Content="1" Tone="Neutral" Size="Small" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Text="发送第一个请求"
                            FontWeight="SemiBold"
                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                        />
                        <TextBlock
                            Text="载入内置「健康检查」，按 Ctrl+Enter 发送；响应区会显示状态、耗时、JSON 树和可复制响应。"
                            FontSize="{arc:ArcDesignTokenResource TypeSM}"
                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                    <arc:Badge Content="2" Tone="Neutral" Size="Small" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Text="接入 MCP"
                            FontWeight="SemiBold"
                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                        />
                        <TextBlock
                            Text="把本机 MCP 地址或完整客户端配置复制到 Cursor、Claude Code、Cline 等客户端，AI 即可管理请求、运行套件并查看审计。"
                            FontSize="{arc:ArcDesignTokenResource TypeSM}"
                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="30,*" ColumnSpacing="10">
                    <arc:Badge Content="3" Tone="Neutral" Size="Small" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock
                            Text="运行第一个套件"
                            FontWeight="SemiBold"
                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                        />
                        <TextBlock
                            Text="打开「自动化」运行内置 Mock 冒烟测试；失败后可查看步骤断言、审计和 AI 聚合输出。"
                            FontSize="{arc:ArcDesignTokenResource TypeSM}"
                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>
                </Grid>
            </StackPanel>
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="跳过"
                        Variant="Secondary"
                        Command="{Binding SkipOnboardingCommand}"
                    />
                    <arc:Button Variant="Primary" Command="{Binding StartOnboardingCommand}">
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.BookOpen}"
                            Text="打开指南"
                        />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsResetDemoDialogOpen, Mode=TwoWay}"
            Title="重置为演示工作区？"
            Description="当前集合、请求、环境变量、套件、发送历史和回收站会被清空，并恢复内置 Mock 示例；审计记录和系统设置保留。该操作不可撤销。"
            Size="Small"
        >
            <TextBlock
                Text="Ctrl+Enter 确认，Esc 取消"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelResetDemoCommand}"
                    />
                    <arc:Button Variant="Danger" Command="{Binding ConfirmResetDemoCommand}">
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.RefreshCw}"
                            Text="重置演示工作区"
                        />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsHistoryTrashConfirmOpen, Mode=TwoWay}"
            Title="{Binding HistoryTrashConfirmTitle}"
            Description="{Binding HistoryTrashConfirmDescription}"
            Size="Small"
        >
            <TextBlock
                Text="Ctrl+Enter 确认，Esc 取消"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelHistoryTrashCommand}"
                    />
                    <arc:Button Variant="Danger" Command="{Binding ConfirmHistoryTrashCommand}">
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.Archive}"
                            Text="移入回收站"
                        />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsHistoryTrashOpen, Mode=TwoWay}"
            Title="历史记录回收站"
            Description="删除的历史记录会先进入这里；恢复后回到历史列表，永久删除后无法恢复。"
            Size="Large"
        >
            <Grid MinHeight="260">
                <arc:ScrollArea MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding RecycledHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryEntry">
                                <Border
                                    Background="{arc:ArcDesignTokenResource Surface}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                    Padding="8"
                                    Margin="0,0,0,4"
                                >
                                    <Grid
                                        ColumnDefinitions="56,*,54,56,170"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="6"
                                        RowSpacing="2"
                                    >
                                        <arc:Badge
                                            Grid.RowSpan="2"
                                            Content="{Binding Method}"
                                            Tone="{Binding MethodTone}"
                                            Size="Small"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Name}"
                                        />
                                        <arc:Badge
                                            Grid.Column="2"
                                            Content="{Binding StatusLabel}"
                                            Icon="{Binding StatusIcon}"
                                            Tone="{Binding StatusTone}"
                                            Size="Small"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding StatusLabel}"
                                        />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding DisplayTime}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding TimestampText}"
                                        />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="3"
                                            Text="{Binding Url}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Url}"
                                            Margin="0,0,8,0"
                                        />
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="4"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Right"
                                        >
                                            <arc:Button
                                                Variant="Secondary"
                                                Size="Small"
                                                Command="{Binding RestoreCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.RotateCcw}"
                                                    Text="恢复"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <arc:Button
                                                Variant="Danger"
                                                Size="Small"
                                                Command="{Binding PurgeCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                                    Text="永久删除"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </arc:ScrollArea>
                <arc:EmptyState
                    IsVisible="{Binding !HasRecycledHistory}"
                    Title="回收站为空"
                    Description="删除历史记录后，会先出现在这里。"
                    Label="回收站"
                />
            </Grid>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Variant="Danger"
                        IsVisible="{Binding HasRecycledHistory}"
                        Command="{Binding EmptyHistoryTrashCommand}"
                    >
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.Trash2}"
                            Text="清空回收站"
                        />
                    </arc:Button>
                    <arc:Button Variant="Primary" Command="{Binding CloseHistoryTrashCommand}">
                        <controls:IconLabel Icon="{x:Static arc:ArcIcons.X}" Text="关闭" />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <views:TreeTrashDialogs DataContext="{Binding TreeTrash}" />

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsHistoryPurgeConfirmOpen, Mode=TwoWay}"
            Title="{Binding HistoryPurgeTitle}"
            Description="{Binding HistoryPurgeDescription}"
            Size="Small"
        >
            <TextBlock
                Text="Ctrl+Enter 确认，Esc 取消"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelHistoryPurgeCommand}"
                    />
                    <arc:Button Variant="Danger" Command="{Binding ConfirmHistoryPurgeCommand}">
                        <controls:IconLabel Icon="{x:Static arc:ArcIcons.Trash2}" Text="永久删除" />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsAuditTrashConfirmOpen, Mode=TwoWay}"
            Title="{Binding AuditTrashConfirmTitle}"
            Description="{Binding AuditTrashConfirmDescription}"
            Size="Small"
        >
            <TextBlock
                Text="Ctrl+Enter 确认，Esc 取消"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelAuditTrashCommand}"
                    />
                    <arc:Button Variant="Danger" Command="{Binding ConfirmAuditTrashCommand}">
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.Archive}"
                            Text="移入回收站"
                        />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsAuditTrashOpen, Mode=TwoWay}"
            Title="审计回收站"
            Description="清空的审计记录会先进入这里；恢复后回到审计列表，永久删除后无法恢复。"
            Size="Large"
        >
            <Grid MinHeight="260">
                <arc:ScrollArea MaxHeight="360">
                    <ItemsControl ItemsSource="{Binding AuditTrash}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:AuditEntry">
                                <Border
                                    Background="{arc:ArcDesignTokenResource Surface}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                    Padding="8"
                                    Margin="0,0,0,4"
                                >
                                    <Grid
                                        ColumnDefinitions="88,*,54,56,160"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="6"
                                        RowSpacing="2"
                                    >
                                        <arc:Badge
                                            Grid.RowSpan="2"
                                            Content="{Binding SourceLabel}"
                                            Icon="{Binding SourceIcon}"
                                            Tone="{Binding SourceTone}"
                                            Size="Small"
                                            Width="88"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding SourceTooltip}"
                                        />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding RequestName}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding RequestName}"
                                        />
                                        <arc:Badge
                                            Grid.Column="2"
                                            Content="{Binding StatusShortLabel}"
                                            Icon="{Binding StatusIcon}"
                                            Tone="{Binding StatusTone}"
                                            Size="Small"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding StatusLabel}"
                                        />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{Binding TimeText}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding TimeTooltip}"
                                        />
                                        <Grid
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="3"
                                            ColumnDefinitions="Auto,*"
                                            ColumnSpacing="6"
                                        >
                                            <arc:Badge
                                                Content="{Binding Method}"
                                                Tone="{Binding MethodTone}"
                                                Size="Small"
                                            />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Url}"
                                                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Url}"
                                            />
                                        </Grid>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="4"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            HorizontalAlignment="Right"
                                        >
                                            <arc:Button
                                                Variant="Secondary"
                                                Size="Small"
                                                Command="{Binding RestoreCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.RotateCcw}"
                                                    Text="恢复"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                            <arc:Button
                                                Variant="Danger"
                                                Size="Small"
                                                Command="{Binding PurgeCommand}"
                                            >
                                                <controls:IconLabel
                                                    Icon="{x:Static arc:ArcIcons.Trash2}"
                                                    Text="永久删除"
                                                    IconSize="13"
                                                />
                                            </arc:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </arc:ScrollArea>
                <arc:EmptyState
                    IsVisible="{Binding !HasAuditTrash}"
                    Title="审计回收站为空"
                    Description="清空审计记录后，会先出现在这里。"
                    Label="审计回收站"
                />
            </Grid>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Variant="Danger"
                        IsVisible="{Binding HasAuditTrash}"
                        Command="{Binding EmptyAuditTrashCommand}"
                    >
                        <controls:IconLabel
                            Icon="{x:Static arc:ArcIcons.Trash2}"
                            Text="清空回收站"
                        />
                    </arc:Button>
                    <arc:Button
                        Content="关闭"
                        Variant="Primary"
                        Command="{Binding CloseAuditTrashCommand}"
                    />
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            Opened="OnDialogOpened"
            IsOpen="{Binding IsAuditPurgeConfirmOpen, Mode=TwoWay}"
            Title="{Binding AuditPurgeTitle}"
            Description="{Binding AuditPurgeDescription}"
            Size="Small"
        >
            <TextBlock
                Text="Ctrl+Enter 确认，Esc 取消"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
            />
            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button
                        Content="取消"
                        Variant="Secondary"
                        Command="{Binding CancelAuditPurgeCommand}"
                    />
                    <arc:Button Variant="Danger" Command="{Binding ConfirmAuditPurgeCommand}">
                        <controls:IconLabel Icon="{x:Static arc:ArcIcons.Trash2}" Text="永久删除" />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            x:Name="CookieDialog"
            IsOpen="{Binding IsCookieDialogOpen, Mode=TwoWay}"
            Title="Cookie 管理"
            Description="查看当前请求站点在本次运行中捕获的 Cookie；Cookie 只保存在内存里，关闭 PostSharp 后清空。"
            Size="Large"
            Opened="OnDialogOpened"
        >
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock
                        Text="{Binding CookieHostText}"
                        FontSize="{arc:ArcDesignTokenResource TypeSM}"
                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                    <arc:Button
                        Grid.Column="1"
                        Content="刷新"
                        Variant="Secondary"
                        Size="Small"
                        Command="{Binding RefreshCookiesCommand}"
                        AutomationProperties.Name="刷新 Cookie"
                    />
                    <arc:Button
                        Grid.Column="2"
                        Content="清空当前站点"
                        Variant="Danger"
                        Size="Small"
                        Command="{Binding ClearCookiesCommand}"
                        AutomationProperties.Name="清空当前站点 Cookie"
                    />
                </Grid>

                <Border
                    IsVisible="{Binding !HasCookies}"
                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                    Padding="16"
                >
                    <StackPanel Spacing="4">
                        <TextBlock
                            Text="当前站点还没有 Cookie"
                            FontWeight="Medium"
                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                        />
                        <TextBlock
                            Text="发送一次会设置 Cookie 的请求后，回到这里刷新即可查看；清空操作只影响当前请求地址对应的站点。"
                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                            TextWrapping="Wrap"
                        />
                    </StackPanel>
                </Border>

                <ScrollViewer MaxHeight="360" IsVisible="{Binding HasCookies}">
                    <ItemsControl ItemsSource="{Binding SessionCookies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionCookie">
                                <Border
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                    Padding="10"
                                    Margin="0,0,0,6"
                                >
                                    <Grid
                                        ColumnDefinitions="180,*,Auto"
                                        RowDefinitions="Auto,Auto"
                                        ColumnSpacing="12"
                                        RowSpacing="4"
                                    >
                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontFamily="{DynamicResource PostSharpCodeFont}"
                                            FontWeight="Medium"
                                            Foreground="{arc:ArcDesignTokenResource Foreground}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Name}"
                                        />
                                        <SelectableTextBlock
                                            Grid.Column="1"
                                            Text="{Binding Value}"
                                            FontFamily="{DynamicResource PostSharpCodeFont}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Value}"
                                        />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding ExpiresText}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            HorizontalAlignment="Right"
                                        />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Text="{Binding Scope}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip.Tip="{Binding Scope}"
                                        />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Text="{Binding Flags}"
                                            FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                            HorizontalAlignment="Right"
                                        />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    Text="Cookie 不会写入 workspace.json、审计或发布包。需要跨重启保留登录态时，请使用授权令牌或环境变量。"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    TextWrapping="Wrap"
                />
            </StackPanel>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Variant="Secondary" Command="{Binding CloseCookieDialogCommand}">
                        <controls:IconLabel Icon="{x:Static arc:ArcIcons.X}" Text="关闭" />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>

        <arc:Dialog
            x:Name="McpDialog"
            IsOpen="{Binding IsMcpDialogOpen, Mode=TwoWay}"
            Title="MCP 接入"
            Description="把 PostSharp 作为本地 MCP 服务器，让 AI 自由整理集合与请求、设计自动化套件并执行回归。"
            Size="Large"
            Width="1000"
            MaxWidth="1120"
            Opened="OnDialogOpened"
        >
            <StackPanel Spacing="12">
                <arc:Input
                    Label="MCP 端点"
                    Text="{Binding McpEndpoint}"
                    IsReadOnly="True"
                    FontFamily="{DynamicResource PostSharpCodeFont}"
                />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <arc:CopyButton
                        Value="{Binding McpEndpoint}"
                        Label="复制 MCP 地址"
                        Variant="Plain"
                    />
                    <TextBlock
                        Grid.Column="1"
                        Text="支持 Streamable HTTP 的 MCP 客户端（Cursor、Claude Code、Cline 等）可直接添加。"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        Foreground="{arc:ArcDesignTokenResource TextMuted}"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap"
                    />
                </Grid>

                <TextBlock
                    Text="{Binding McpAuthHint}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                />
                <Grid
                    IsVisible="{Binding McpRequireToken}"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="8"
                >
                    <arc:Input
                        Label="MCP token"
                        Text="{Binding McpTokenValue}"
                        IsReadOnly="True"
                        FontFamily="{DynamicResource PostSharpCodeFont}"
                        AutomationProperties.Name="MCP token"
                    />
                    <arc:CopyButton
                        Grid.Column="1"
                        Value="{Binding McpTokenValue}"
                        Label="复制 token"
                        Variant="Plain"
                    />
                </Grid>

                <TextBlock
                    Text="已开放工具"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    FontWeight="Medium"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                />
                <TextBlock
                    Text="{Binding McpToolSummary}"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                    TextWrapping="Wrap"
                />

                <arc:CodeBlock
                    Code="{Binding McpClientConfig}"
                    Language="json"
                    FileName="mcp.json"
                    IsCollapsible="False"
                    CopyLabel="复制客户端配置"
                />

                <TextBlock
                    Text="MCP 发送请求同样会写入历史记录；套件支持步骤延迟、上一步响应字段映射、状态码和响应文本断言，AI 可创建后反复 update_suite / run_suite 迭代。"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    TextWrapping="Wrap"
                />
            </StackPanel>

            <arc:Dialog.Actions>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <arc:Button Variant="Secondary" Command="{Binding CloseMcpDialogCommand}">
                        <controls:IconLabel Icon="{x:Static arc:ArcIcons.X}" Text="关闭" />
                    </arc:Button>
                </StackPanel>
            </arc:Dialog.Actions>
        </arc:Dialog>
    </Panel>
</UserControl>
