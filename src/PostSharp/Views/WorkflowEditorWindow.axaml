<Window
    x:Class="PostSharp.Views.WorkflowEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
    xmlns:vm="using:PostSharp.ViewModels"
    x:DataType="vm:WorkflowEditorViewModel"
    Title="套件工作流编排"
    Width="1280"
    Height="820"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="{arc:ArcDesignTokenResource Background}"
>
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" Margin="16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
                <TextBlock
                    Text="套件工作流编排"
                    FontSize="{arc:ArcDesignTokenResource TypeXL}"
                    FontWeight="SemiBold"
                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                />
                <TextBlock
                    Text="从左侧拖入集合或接口作为节点，拖动节点端口连接流程；双击左侧节点也可以添加。"
                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                    TextWrapping="Wrap"
                />
            </StackPanel>
            <arc:Input
                Grid.Column="1"
                Width="260"
                Label="套件名称"
                Text="{Binding SuiteName, Mode=TwoWay}"
                AutomationProperties.Name="套件名称"
            />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,8,*" ColumnSpacing="10">
            <Border
                Grid.Column="0"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                Padding="6"
            >
                <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <TextBlock
                        Text="集合与接口"
                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                        FontWeight="Medium"
                        Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                        Margin="4,2,4,0"
                    />
                    <arc:ScrollArea Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkflowPaletteItem">
                                    <Border
                                        Background="{arc:ArcDesignTokenResource Surface}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="8,5"
                                        Margin="0,0,0,3"
                                        Cursor="Hand"
                                        PointerPressed="OnPalettePointerPressed"
                                        PointerMoved="OnPalettePointerMoved"
                                        DoubleTapped="OnPaletteDoubleTapped"
                                        ToolTip.Tip="{Binding Description}"
                                    >
                                        <Grid
                                            ColumnDefinitions="20,*"
                                            ColumnSpacing="7"
                                            Margin="{Binding IndentMargin}"
                                        >
                                            <Panel VerticalAlignment="Center">
                                                <arc:ArcGlyph
                                                    Data="{x:Static arc:ArcIcons.Folder}"
                                                    Size="14"
                                                    Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                    IsVisible="{Binding IsCollection}"
                                                />
                                                <arc:ArcGlyph
                                                    Data="{x:Static arc:ArcIcons.FileText}"
                                                    Size="14"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    IsVisible="{Binding !IsCollection}"
                                                />
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                    Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                    TextTrimming="CharacterEllipsis"
                                                />
                                                <TextBlock
                                                    Text="{Binding Description}"
                                                    FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                    Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                    TextTrimming="CharacterEllipsis"
                                                />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </arc:ScrollArea>
                </Grid>
            </Border>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                Cursor="SizeWestEast"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
            />

            <Border
                Grid.Column="2"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                ClipToBounds="True"
            >
                <Panel>
                    <arc:WorkflowCanvas
                        x:Name="Canvas"
                        IsEditable="True"
                        AutoFit="Fit"
                        MaxZoom="1"
                        EdgeStyle="Bezier"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="0"
                        AutomationProperties.Name="套件工作流画布"
                    />
                    <arc:WorkflowZoomControls
                        x:Name="ZoomControls"
                        Target="{Binding #Canvas}"
                        Margin="12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                    />
                </Panel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock
                Text="{Binding StatusText}"
                FontSize="{arc:ArcDesignTokenResource TypeXS}"
                Foreground="{arc:ArcDesignTokenResource TextMuted}"
                TextTrimming="CharacterEllipsis"
                ToolTip.Tip="{Binding StatusText}"
                VerticalAlignment="Center"
            />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <arc:Button
                    Content="自动布局"
                    Variant="Secondary"
                    Size="Small"
                    Click="OnAutoLayoutClick"
                    AutomationProperties.Name="自动布局"
                />
                <arc:Button
                    Content="清空画布"
                    Variant="Ghost"
                    Size="Small"
                    Click="OnClearWorkflowClick"
                    AutomationProperties.Name="清空画布"
                />
                <arc:Button
                    Content="取消"
                    Variant="Secondary"
                    Size="Small"
                    Click="OnCloseClick"
                    AutomationProperties.Name="关闭工作流编排"
                />
                <arc:Button
                    Content="创建套件"
                    Variant="Primary"
                    Size="Small"
                    Click="OnCreateWorkflowSuiteClick"
                    AutomationProperties.Name="创建工作流套件"
                />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
