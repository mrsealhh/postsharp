<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PostSharp</RootNamespace>
        <AssemblyName>PostSharp</AssemblyName>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
        <InvariantGlobalization>false</InvariantGlobalization>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageReference Include="TKCode.Arc" Version="0.3.2-preview.1" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="0.3.2-preview.1" />
        <PackageReference Include="TKCode.Arc.Themes.Corners" Version="0.3.2-preview.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="Google.Protobuf" Version="3.19.4" />
        <PackageReference Include="Grpc.Net.Client" Version="2.57.0" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
        <PackageReference Include="TKCode.Arc.Workflow" Version="0.3.2-preview.1" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Serilog" />
        <Using Include="PostSharp.Storage.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PostSharp.Tests" />
    </ItemGroup>

    <ItemGroup>
        <!--
            交互型工具更需要「别常驻空堆」：消费内存越高，GC 越积极归还已提交的段。
            实测同一工作区、同样的启动同步：7 比旧构建省 79MB，9 再省 30MB（352 → 273 → 243）。
        -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PostSharp.Storage.Abstractions\PostSharp.Storage.Abstractions.csproj" />
        <StoragePluginProject Include="..\Plugins\PostSharp.Storage.PostgreSql\PostSharp.Storage.PostgreSql.csproj">
            <PluginFolder>PostSharp.Storage.PostgreSql</PluginFolder>
        </StoragePluginProject>
        <StoragePluginProject Include="..\Plugins\PostSharp.Storage.MySql\PostSharp.Storage.MySql.csproj">
            <PluginFolder>PostSharp.Storage.MySql</PluginFolder>
        </StoragePluginProject>
        <StoragePluginProject Include="..\Plugins\PostSharp.Storage.SqlServer\PostSharp.Storage.SqlServer.csproj">
            <PluginFolder>PostSharp.Storage.SqlServer</PluginFolder>
        </StoragePluginProject>
        <StoragePluginProject Include="..\Plugins\PostSharp.Storage.MongoDb\PostSharp.Storage.MongoDb.csproj">
            <PluginFolder>PostSharp.Storage.MongoDb</PluginFolder>
        </StoragePluginProject>
        <ProjectReference
            Include="@(StoragePluginProject)"
            ReferenceOutputAssembly="false"
            Private="false"
        />
    </ItemGroup>

    <!--
        默认随应用发布 PostgreSQL / MySQL / SQL Server / MongoDB 插件；其它数据库可由用户把外部插件
        放进数据目录的 plugins 文件夹。插件程序集不进入主程序集，主程序保留本地 SQLite 兜底。
    -->
    <Target Name="CopyBundledStoragePlugins" AfterTargets="Build">
        <MSBuild
            Projects="@(StoragePluginProject)"
            Targets="Build"
            Properties="Configuration=$(Configuration)"
            BuildInParallel="true"
        />
        <ItemGroup>
            <StoragePluginFiles Include="..\Plugins\%(StoragePluginProject.PluginFolder)\bin\$(Configuration)\net10.0\**\*">
                <PluginFolder>%(StoragePluginProject.PluginFolder)</PluginFolder>
            </StoragePluginFiles>
        </ItemGroup>
        <Copy
            SourceFiles="@(StoragePluginFiles)"
            DestinationFiles="@(StoragePluginFiles->'$(OutDir)plugins\%(PluginFolder)\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
        />
    </Target>

    <Target Name="CopyBundledStoragePluginsToPublish" AfterTargets="Publish">
        <ItemGroup>
            <BundledStoragePluginFiles Include="$(OutDir)plugins\**\*" />
        </ItemGroup>
        <Copy
            SourceFiles="@(BundledStoragePluginFiles)"
            DestinationFiles="@(BundledStoragePluginFiles->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
            SkipUnchangedFiles="true"
        />
    </Target>
</Project>
