<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PostSharp</RootNamespace>
        <AssemblyName>PostSharp</AssemblyName>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
        <InvariantGlobalization>false</InvariantGlobalization>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.4" />
        <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
        <PackageReference Include="TKCode.Arc" Version="0.3.1-preview.2" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="0.3.1-preview.2" />
        <PackageReference Include="TKCode.Arc.Themes.Corners" Version="0.3.1-preview.2" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference
            Include="Microsoft.Web.WebView2"
            Version="1.0.3179.45"
            GeneratePathProperty="true"
            ExcludeAssets="all"
        />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <!--
        Avalonia.Controls.WebView 在 Windows 上通过 P/Invoke 加载 WebView2Loader.dll。
        这里只取 WebView2 包里的原生加载器（排除它的托管引用与构建目标，避免引入 WPF/WinForms 冲突）。
    -->
    <ItemGroup>
        <None
            Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
            Link="WebView2Loader.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="False"
        />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Serilog" />
    </ItemGroup>
</Project>
